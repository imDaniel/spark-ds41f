+from vllm.parser.abstract_parser import DelegatingParser
 from vllm.parser.deepseek_v4 import (
     DeepSeekV4Parser,
     _dsml_arg_converter,
@@ -13,6 +18,11 @@ from vllm.parser.deepseek_v4 import (
 )
 from vllm.parser.engine.parser_engine_config import ParserEngineConfig
 
+if TYPE_CHECKING:
+    from vllm.entrypoints.generate.base.protocol import FunctionCall
+    from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+    from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+
 DSML_TOOL_START = "<｜DSML｜ calls>"
 DSML_TOOL_END = "</｜DSML｜ calls>"
 DSML_INVOKE_PREFIX = '<｜DSML｜ invoke name="'
@@ -52,3 +62,39 @@ def deepseek_v41_config(thinking: bool = False) -> ParserEngineConfig:
 
 class DeepSeekV41Parser(DeepSeekV4Parser):
     parser_config = staticmethod(deepseek_v41_config)
+
+
+class DeepSeekV41DelegatingParser(DelegatingParser):
+    """Keep streaming adapters; parse complete output once with its token IDs."""
+
+    def parse(
+        self,
+        model_output: str,
+        request: ChatCompletionRequest | ResponsesRequest,
+        enable_auto_tools: bool = False,
+        model_output_token_ids: Sequence[int] = (),
+    ) -> tuple[str | None, str | None, list[FunctionCall] | None]:
+        # Selected only when both adapters are DeepSeek V4.1. The reasoning
+        # engine has the request's thinking controls; it also receives the
+        # tool schemas through request. Splitting text into two parser passes
+        # would discard IDs and treat literal EOS spellings as control tokens.
+        from vllm.parser.engine.adapters import ParserEngineReasoningAdapter
+
+        assert isinstance(self._reasoning_parser, ParserEngineReasoningAdapter)
+        assert self._tool_parser is not None
+        self._initialize_history_tool_call_cnt(request)
+        json_tools = (
+            self._tool_parser.supports_required_and_named
+            and request.tool_choice not in (None, "auto", "none")
+        )
+        parse_tools = (
+            enable_auto_tools and not json_tools
+        ) or request.tool_choice == "none"
+        reasoning, content, calls = self._reasoning_parser.parse_complete(
+            model_output, request, model_output_token_ids, parse_tools=parse_tools
+        )
+        if not parse_tools:
+            calls, content = self._extract_tool_calls(
+                content, request, enable_auto_tools
+            )
+        return reasoning, content, calls
diff --git a/vllm/parser/engine/adapters.py b/vllm/parser/engine/adapters.py
index 3e2488f16..d223e7eff 100644
--- a/vllm/parser/engine/adapters.py
+++ b/vllm/parser/engine/adapters.py
@@ -22,6 +22,7 @@ if TYPE_CHECKING:
     from vllm.entrypoints.generate.base.protocol import (
         DeltaMessage,
         ExtractedToolCallInformation,
+        FunctionCall,
     )
     from vllm.entrypoints.openai.chat_completion.protocol import (
         ChatCompletionRequest,
@@ -83,6 +84,29 @@ class ParserEngineReasoningAdapter(ReasoningParser):
         with self._skip_tool_parsing():
             return self._parser_engine.extract_reasoning(model_output, request)
 
+    def parse_complete(
+        self,
+        model_output: str,
+        request: ChatCompletionRequest | ResponsesRequest,
+        token_ids: Sequence[int],
+        *,
+        parse_tools: bool,
+    ) -> tuple[str | None, str | None, list[FunctionCall] | None]:
+        """Parse a complete response without losing token provenance.
+
+        Matching reasoning/tool adapters can share this pass. JSON forced
+        tools still need the caller's standard JSON conversion afterwards.
+        """
+        self._streaming_count_valid = True
+        saved = self._parser_engine.skip_tool_parsing
+        self._parser_engine.skip_tool_parsing = not parse_tools
+        try:
+            return self._parser_engine.parse(
+                model_output, request, model_output_token_ids=token_ids
+            )
+        finally:
+            self._parser_engine.skip_tool_parsing = saved
+
     def extract_reasoning_streaming(
         self,
         previous_text: str,
