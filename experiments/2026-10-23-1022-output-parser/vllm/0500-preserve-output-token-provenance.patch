diff --git a/tests/parser/engine/test_deepseek_v41_token_provenance.py b/tests/parser/engine/test_deepseek_v41_token_provenance.py
new file mode 100644
index 000000000..b1783ae19
--- /dev/null
+++ b/tests/parser/engine/test_deepseek_v41_token_provenance.py
@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Exercise the registered serving parser, including the JSON forced-tool path."""
+
+import json
+
+import pytest
+
+from tests.parser.engine.replay_harness import (
+    MockTokenizer,
+    _test_request,
+    collect_output,
+    replay_streaming,
+)
+from tests.parser.engine.test_deepseek_v41 import parser_for
+
+EOS = "<｜end▁of▁sentence｜>"
+VALUE = {
+    "role": "literal user value",
+    "type": "literal string value",
+    "nested": {'quote"key': EOS},
+}
+TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "record_value",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "role": {"type": "string"},
+                    "type": {"type": "string"},
+                    "nested": {"type": "object"},
+                },
+            },
+        },
+    }
+]
+NAMED = {"type": "function", "function": {"name": "record_value"}}
+
+
+def fixture(text):
+    vocab = {"<think>": 50, "</think>": 51, EOS: 52}
+    tokens = []
+    while text:
+        # EOS spelling in user data consists of ordinary tokens; only the
+        # actual reasoning boundary is a special token in this fixture.
+        piece = "</think>" if text.startswith("</think>") else text[0]
+        tokens.append((51 if piece == "</think>" else 100 + len(tokens), piece))
+        text = text[len(piece) :]
+    return MockTokenizer(vocab, tokens), tokens
+
+
+def output_for(choice):
+    args = json.dumps(VALUE, ensure_ascii=False)
+    if choice == "required":
+        return json.dumps(
+            [{"name": "record_value", "parameters": VALUE}], ensure_ascii=False
+        )
+    if choice == "auto":
+        return (
+            '<｜DSML｜ calls><｜DSML｜ invoke name="record_value">'
+            '<｜DSML｜ parameter name="role" string="true">literal user value'
+            '</｜DSML｜ parameter><｜DSML｜ parameter name="type" string="true">'
+            "literal string value</｜DSML｜ parameter>"
+            '<｜DSML｜ parameter name="nested" string="false">'
+            + json.dumps(VALUE["nested"], ensure_ascii=False)
+            + "</｜DSML｜ parameter></｜DSML｜ invoke></｜DSML｜ calls>"
+        )
+    return args
+
+
+@pytest.mark.parametrize("thinking", [False, True])
+@pytest.mark.parametrize("choice", ["named", "required", "auto", "none"])
+@pytest.mark.parametrize("json_tools", [False, True])
+def test_complete_output_retains_ordinary_control_spelling(
+    thinking, choice, json_tools
+):
+    syntax = "auto" if choice in ("named", "required") and not json_tools else choice
+    text = ("Plan.</think>" if thinking else "") + output_for(syntax)
+    tokenizer, tokens = fixture(text)
+    parser = parser_for(tokenizer, {"thinking": thinking})
+    request = _test_request(tools=TOOLS)
+    parser.tool_parser.supports_required_and_named = json_tools
+    # Validate the named choice into its real protocol object.
+    request = type(request).model_validate(
+        {**request.model_dump(), "tool_choice": NAMED if choice == "named" else choice}
+    )
+    ids = [tid for tid, _ in tokens]
+    reasoning, content, calls = parser.parse(
+        text, request, enable_auto_tools=True, model_output_token_ids=ids
+    )
+    assert (reasoning or "") == ("Plan." if thinking else "")
+    assert parser.count_reasoning_tokens(ids) == (5 if thinking else 0)
+    if choice == "none":
+        assert not calls
+        assert json.loads(content) == VALUE
+    else:
+        assert not (content or "").strip()
+        assert len(calls) == 1 and calls[0].name == "record_value"
+        assert json.loads(calls[0].arguments) == VALUE
+
+
+@pytest.mark.parametrize("thinking", [False, True])
+@pytest.mark.parametrize("chunk_size", [1, 7, 10000])
+def test_streaming_auto_retains_ordinary_control_spelling(thinking, chunk_size):
+    text = ("Plan.</think>" if thinking else "") + output_for("auto")
+    tokenizer, tokens = fixture(text)
+    parser = parser_for(tokenizer, {"thinking": thinking})
+    output = collect_output(
+        replay_streaming(
+            parser,
+            tokens,
+            chunk_size=chunk_size,
+            finished_on_last=True,
+            tools=TOOLS,
+            prompt_token_ids=[50 if thinking else 51],
+        )
+    )
+    assert output.reasoning == ("Plan." if thinking else "")
+    assert not output.content.strip()
+    assert json.loads(output.tool_calls[0]["arguments"]) == VALUE
+
+
+@pytest.mark.parametrize("thinking", [False, True])
+def test_real_eos_still_dropped_and_plain_spelling_retained(thinking):
+    text = ("Plan.</think>" if thinking else "") + "Literal: " + EOS
+    tokenizer, tokens = fixture(text)
+    tokens.append((52, EOS))
+    tokenizer = MockTokenizer(tokenizer.get_vocab(), tokens)
+    parser = parser_for(tokenizer, {"thinking": thinking})
+    reasoning, content, calls = parser.parse(
+        text + EOS,
+        _test_request(tools=TOOLS),
+        enable_auto_tools=True,
+        model_output_token_ids=[tid for tid, _ in tokens],
+    )
+    assert content == "Literal: " + EOS
+    assert not calls
+
+
+def test_auto_disabled_keeps_literal_content():
+    text = "Literal: " + EOS
+    tokenizer, tokens = fixture(text)
+    parser = parser_for(tokenizer, {"thinking": False})
+    _, content, calls = parser.parse(
+        text,
+        _test_request(tools=TOOLS),
+        enable_auto_tools=False,
+        model_output_token_ids=[tid for tid, _ in tokens],
+    )
+    assert content == text
+    assert not calls
