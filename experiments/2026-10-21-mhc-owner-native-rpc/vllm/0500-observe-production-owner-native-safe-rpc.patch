+def steering_request_args(spec):
+    """Keep disabled startup distinct from loaded zero-dose request semantics."""
+    selection = spec["steering"]
+    state = selection.get("state")
+    additional = spec["engine_kwargs"].get("additional_config", {})
+    startup = additional.get("ds41_steering")
+    if state == "off":
+        if "ds41_steering" in additional or set(selection) != {"state"}:
+            raise ValueError("Disabled steering must have no loaded profile or request dose")
+        return None
+    if state not in ("loaded_zero", "active") or not isinstance(startup, dict):
+        raise ValueError("Loaded steering requires its existing startup profile")
+    if (set(startup) != {"schema_version", "operator_version", "profile_path", "profile_sha256"}
+            or type(startup["schema_version"]) is not int or startup["schema_version"] != 1
+            or startup["operator_version"] != "attn-writer-project-bf16-rank-order-v1"
+            or not isinstance(startup["profile_path"], str) or not startup["profile_path"]
+            or not isinstance(startup["profile_sha256"], str)
+            or len(startup["profile_sha256"]) != 64
+            or any(c not in "0123456789abcdef" for c in startup["profile_sha256"])):
+        raise ValueError("Existing loaded steering contract and artifact pin required")
+    if set(selection) != {"state", "profile_name", "scale"}:
+        raise ValueError("Explicit steering state, profile and dose required")
+    name, scale = selection["profile_name"], selection["scale"]
+    if not isinstance(name, str) or not name:
+        raise ValueError("Explicit existing profile name required")
+    if type(scale) not in (int, float) or not math.isfinite(scale):
+        raise ValueError("Finite numeric steering dose required")
+    if not ((state == "loaded_zero" and scale == 0)
+            or (state == "active" and 0 < scale <= 4)):
+        raise ValueError("Dose differs from the selected steering state")
+    scale_bits = struct.unpack("!I", struct.pack("!f", float(scale)))[0] & 0x7FFFFFFF
+    if state == "active" and scale_bits == 0:
+        raise ValueError("Active steering dose rounds to zero in the real request parser")
+    return {"steering_profile": name, "steering_scale": scale}
