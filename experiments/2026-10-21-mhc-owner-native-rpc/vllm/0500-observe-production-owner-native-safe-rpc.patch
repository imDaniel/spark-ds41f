+def _model_owner(model):
+    from vllm.models.deepseek_v4_1.nvidia.model import DeepseekV4Model
+
+    models = [module for module in model.modules()
+              if isinstance(module, DeepseekV4Model)]
+    assert len(models) == 1, "Expected the actual target model, not a synthetic FFN"
+    return models[0]
+
+
+def _owner_snapshot(model):
+    import torch
+    from vllm.distributed import get_tensor_model_parallel_rank
+
+    target = _model_owner(model)
+    arena = target.q03_input_arena
+    profile = target.steering_profile
+    result = {"rank": get_tensor_model_parallel_rank(),
+              "sm": list(torch.cuda.get_device_capability()),
+              "tp": target.parallel_config.tensor_parallel_size,
+              "sequence_parallel": target.use_sequence_parallel,
+              "owner_present": arena is not None,
+              "steering_profile": None if profile is None else {
+                  "name": profile.profile_id, "artifact_sha256": profile.artifact_sha256,
+                  "identity": profile.identity, "schedule_sha256": profile.schedule_sha256,
+                  "layers": list(profile.layers), "alphas": list(profile.alphas)}}
+    if arena is not None:
+        assert not arena._busy
+        layers = target.q03_input_layers
+        assert layers and all(layer.q03_input_arena is arena
+                              and not layer.is_draft
+                              and not layer.use_sequence_parallel
+                              and layer.ffn.experts.q03_input_quant_eligible()
+                              for layer in layers)
+        result.update(capacity=arena.capacity, layers=len(layers),
+                      q=arena.q_storage.data_ptr(), sf=arena.sf_storage.data_ptr(),
+                      q_bytes=arena.q_storage.numel(), sf_bytes=arena.sf_storage.numel())
+        assert result["q"] != result["sf"]
+        assert result["q"] % 256 == result["sf"] % 256 == 0
+        assert (result["q_bytes"], result["sf_bytes"]) == arena.storage_sizes(arena.capacity)
+    return result
+
