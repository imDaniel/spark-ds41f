+def canonical_json(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def project_effective_config(config):
+    """Read an explicit projection, never serialize arbitrary runtime objects."""
+    result = {}
+    for section, fields in EFFECTIVE_FIELDS.items():
+        obj = getattr(config, section)
+        for field in fields:
+            value = getattr(obj, field)
+            if isinstance(value, Enum):
+                value = value.name
+            if section == "model_config" and field == "dtype":
+                value = str(value)
+            result[section + "." + field] = value
+    result["compilation_config.pass_config.enable_sp"] = (
+        config.compilation_config.pass_config.enable_sp)
+    result["speculative_config.draft_parallel_config.tensor_parallel_size"] = (
+        config.speculative_config.draft_parallel_config.tensor_parallel_size)
+    mm = config.model_config.multimodal_config
+    result["model_config.multimodal_config.image_limit"] = (
+        None if mm is None else mm.get_limit_per_prompt("image"))
+    result["model_config.multimodal_config.mm_processor_cache_gb"] = (
+        None if mm is None else mm.mm_processor_cache_gb)
+    additional = config.additional_config
+    result["additional_config.ds41_steering"] = {
+        "present": "ds41_steering" in additional,
+        "value": additional.get("ds41_steering"),
+    }
+    return json.loads(canonical_json(result))
+
