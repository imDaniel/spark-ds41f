+def validate_handshake(spec):
+    handshake = spec["handshake"]
+    if set(handshake) != {"ready_path", "ack_path", "timeout_seconds",
+                          "window_id", "attempt_id"}:
+        raise ValueError("Exact readiness handshake fields required")
+    for key in ("window_id", "attempt_id"):
+        value = handshake[key]
+        if (not isinstance(value, str) or len(value) != 32
+                or any(c not in "0123456789abcdef" for c in value)):
+            raise ValueError("Canonical window and attempt UUID hex required")
+    timeout = handshake["timeout_seconds"]
+    if (type(timeout) not in (int, float) or not math.isfinite(timeout)
+            or not 0 < timeout <= 600):
+        raise ValueError("Readiness timeout must be finite and bounded to 600 seconds")
+    paths = [Path(handshake[key]) for key in ("ready_path", "ack_path")]
+    for path in paths:
+        if (not path.is_absolute() or ".." in path.parts
+                or path.resolve() != path or not path.parent.is_dir()
+                or path.exists() or path.is_symlink()):
+            raise ValueError("Fresh canonical readiness paths required")
+    if len(set(paths + [Path(spec["output_path"])])) != 3:
+        raise ValueError("Readiness and result paths must be distinct")
+    return handshake
+
+
+def await_steady_guard(spec, spec_sha256, reports, *, clock=time.monotonic,
+                       sleep=time.sleep):
+    """Publish verified worker evidence, then wait for this attempt's steady guard."""
+    handshake = validate_handshake(spec)
+    identity = {key: handshake[key] for key in ("window_id", "attempt_id")}
+    identity["spec_sha256"] = spec_sha256
+    ready = {"schema_version": 1, **identity, "reports": reports,
+             "reports_sha256": hashlib.sha256(
+                 canonical_json(reports).encode()).hexdigest()}
+    raw = (canonical_json(ready) + "\n").encode()
+    path = Path(handshake["ready_path"])
+    temporary = path.with_name(path.name + ".publishing")
+    with temporary.open("xb") as stream:
+        stream.write(raw)
+        stream.flush()
+        os.fsync(stream.fileno())
+    try:
+        os.link(temporary, path)  # Atomic publication without replacing prior evidence.
+    finally:
+        temporary.unlink()
+    parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(parent_fd)
+    finally:
+        os.close(parent_fd)
+    expected = {"schema_version": 1, **identity,
+                "ready_sha256": hashlib.sha256(raw).hexdigest(),
+                "steady_guard_ready": True}
+    deadline = clock() + handshake["timeout_seconds"]
+    ack = Path(handshake["ack_path"])
+    while clock() < deadline:
+        try:
+            fd = os.open(ack, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        except FileNotFoundError:
+            sleep(min(0.1, max(0, deadline - clock())))
+            continue
+        with os.fdopen(fd, "rb") as stream:
+            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+                raise ValueError("Steady acknowledgment must be a regular file")
+            raw_ack = stream.read(65537)
+        if len(raw_ack) > 65536:
+            raise ValueError("Readiness acknowledgment too large")
+        def unique_keys(pairs):
+            value = {}
+            for key, item in pairs:
+                if key in value:
+                    raise ValueError("Duplicate acknowledgment field")
+                value[key] = item
+            return value
+        actual = json.loads(raw_ack, object_pairs_hook=unique_keys)
+        if canonical_json(actual) != canonical_json(expected):
+            raise ValueError("Foreign, incomplete or malformed steady acknowledgment")
+        return {"ready_sha256": expected["ready_sha256"],
+                "ack_sha256": hashlib.sha256(raw_ack).hexdigest()}
+    raise TimeoutError("Steady guard acknowledgment deadline exceeded")
+
