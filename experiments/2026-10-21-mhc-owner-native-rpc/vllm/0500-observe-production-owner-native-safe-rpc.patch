+def _observe_graph_resources(worker):
+    """Observe actual collectors without resetting or clearing engine graphs."""
+    import torch
+    from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphWrapper
+    from vllm.compilation.cuda_graph import CUDAGraphWrapper
+    from vllm.v1.worker.gpu.cudagraph_utils import _profiling_cudagraph_managers
+
+    runner = worker.model_runner
+    target = _model_owner(runner.get_model())
+    arena = target.q03_input_arena
+    assert arena is not None and not arena._busy
+    before = _owner_snapshot(runner.get_model())
+    # Reject observations that cannot be associated with this isolated engine.
+    def entries(wrapper):
+        if isinstance(wrapper, BreakableCUDAGraphWrapper):
+            return wrapper.entries
+        return wrapper.concrete_cudagraph_entries
+
+    wrappers = [wrapper for cls in (CUDAGraphWrapper, BreakableCUDAGraphWrapper)
+                for wrapper in list(cls._all_instances) if entries(wrapper)]
+    assert all(wrapper.vllm_config is runner.vllm_config for wrapper in wrappers), (
+        "Cannot bind all enclosing graphs to the isolated engine")
+    managers = (_profiling_cudagraph_managers(runner)
+                if hasattr(runner, "cudagraph_manager")
+                and hasattr(runner, "speculator") else [])
+    pointers = {arena.q_storage.data_ptr(), arena.sf_storage.data_ptr()}
+
+    def captured_views():
+        refs = {}
+        collectors = [entry.resources for wrapper in wrappers
+                      if isinstance(wrapper, BreakableCUDAGraphWrapper)
+                      for entry in wrapper.entries.values() if entry.resources]
+        collectors += [resources for manager in managers
+                       for resources in manager.graph_capture_resources.values()]
+        for resources in collectors:
+            for resource in resources:
+                if (isinstance(resource, tuple) and len(resource) == 2
+                        and all(isinstance(tensor, torch.Tensor) for tensor in resource)
+                        and {tensor.untyped_storage().data_ptr() for tensor in resource}
+                        == pointers):
+                    for tensor in resource:
+                        assert tensor is not arena.q and tensor is not arena.sf
+                        refs[id(tensor)] = weakref.ref(tensor)
+        return list(refs.values())
+
+    refs = captured_views()  # Only weak references escape the inspection scope.
+    assert refs, "No real production collector retained the Q03 producer views"
+    assert all(ref() is not None for ref in refs)
+    descriptors = [repr(key) for wrapper in wrappers for key in entries(wrapper)]
+    descriptors += [repr(key) for manager in managers for key in manager.graphs]
+    assert descriptors, "No production graph was captured"
+    assert before == _owner_snapshot(runner.get_model())
+    return {"rank": before["rank"], "retained_view_objects": len(refs),
+            "descriptors": descriptors, "arena_unchanged": True,
+            "wrapper_types": [type(wrapper).__name__ for wrapper in wrappers],
+            "manager_types": [type(manager).__name__ for manager in managers],
+            "wrapper_count": len(wrappers), "manager_count": len(managers),
+            "scope": "Collector view retention only; fine-grained retirement untested"}
+
