+def validate_rank_configs(reports, expected):
+    if not isinstance(reports, list) or len(reports) != 4:
+        raise ValueError("Exactly four resolved worker reports required")
+    seen = set()
+    for report in reports:
+        rank = report["worker_rank"]
+        if type(rank) is not int or rank not in range(4) or rank in seen:
+            raise ValueError("Missing, duplicate or foreign worker rank")
+        seen.add(rank)
+        for key, value in (("tp_rank", rank), ("config_rank", rank),
+                           ("node_rank", rank), ("node_rank_within_dp", rank),
+                           ("local_rank", 0)):
+            if type(report[key]) is not int or report[key] != value:
+                raise ValueError("Resolved rank topology mismatch: " + key)
+        if canonical_json(report["effective_config"]) != canonical_json(expected):
+            raise ValueError("Worker resolved configuration differs from reviewed projection")
+        if canonical_json(report["runner_config"]) != canonical_json(expected):
+            raise ValueError("Selected runner resolved configuration mismatch")
+    return reports
+
