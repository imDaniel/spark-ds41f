+def _check_runtime(worker, manifest):
+    import importlib
+    import torch
+    import vllm
+
+    assert manifest["source_head"] == SOURCE_HEAD
+    assert manifest["installation"]["mode"] == "image-source"
+    assert set(manifest["native_sha256"]) == {
+        "vllm._C_stable_libtorch", "vllm._moe_C_stable_libtorch"}
+    assert set(manifest["native_paths"]) == set(manifest["native_sha256"])
+    assert str(Path(vllm.__file__).resolve().parent) == manifest["installation"]["package_root"]
+    assert torch.__version__ == manifest["versions"]["torch"]
+    for name, expected in manifest["native_sha256"].items():
+        path = Path(importlib.import_module(name).__file__).resolve()
+        assert str(path) == manifest["native_paths"][name]
+        assert hashlib.sha256(path.read_bytes()).hexdigest() == expected
+    owner = _owner_snapshot(worker.model_runner.get_model())
+    parallel = worker.parallel_config
+    return {"owner": owner, "worker_rank": worker.rank,
+            "tp_rank": owner["rank"], "config_rank": parallel.rank,
+            "node_rank": parallel.node_rank,
+            "node_rank_within_dp": parallel.node_rank_within_dp,
+            "local_rank": worker.local_rank,
+            "runner_type": type(worker.model_runner).__name__,
+            "effective_config": project_effective_config(worker.vllm_config),
+            "runner_config": project_effective_config(worker.model_runner.vllm_config)}
+
+
+class Q03OwnerWorkerExtension:
+    """Test-only named RPCs imported from the reviewed fixture on every rank.
+
+    The fixture package must be on each worker's Python path before construction.
+    No initializer or worker-method override is needed by the native mixin hook.
+    Only names and JSON-compatible arguments cross the native safe RPC transport.
+    """
+
+    def q03_check_runtime(self, manifest, fixture_sha256):
+        assert hashlib.sha256(Path(__file__).read_bytes()).hexdigest() == fixture_sha256, (
+            "Worker imported a different owner fixture than the reviewed leader")
+        return _check_runtime(self, manifest)
+
+    def q03_owner_snapshot(self):
+        return _owner_snapshot(self.model_runner.get_model())
+
+    def q03_observe_graph_resources(self):
+        return _observe_graph_resources(self)
+
+
+def test_real_model_owner_and_capture_retention(vllm_runner):
+    if os.environ.get("VLLM_Q03_PRODUCTION_OWNER_TEST") != "1":
+        pytest.skip("Requires a reviewed independent four-node full-model window")
+    spec_raw = Path(os.environ["VLLM_Q03_PRODUCTION_OWNER_SPEC"]).read_bytes()
+    spec = validate_fixture_spec(json.loads(spec_raw))
+    spec_sha256 = hashlib.sha256(spec_raw).hexdigest()
+    expected_env = "1" if spec["mode"] == "dual" else "0"
+    assert os.environ.get("VLLM_DS41_Q03_MHC_MXFP8", "0") == expected_env
+    assert Path(spec["model_path"]).is_dir(), "No remote checkpoint download permitted"
+    raw = Path(spec["runtime_manifest_path"]).read_bytes()
+    assert hashlib.sha256(raw).hexdigest() == spec["runtime_manifest_sha256"]
+    runtime = json.loads(raw)
+    output = Path(spec["output_path"])
+    assert output.parent.is_dir() and not output.exists()
+    kwargs = dict(spec["engine_kwargs"])
+    kwargs["trust_remote_code"] = False
+    kwargs["worker_extension_cls"] = WORKER_EXTENSION_CLS
+    fixture_sha256 = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    from vllm import SamplingParams
+    request_args = steering_request_args(spec)
+    with vllm_runner(spec["model_path"], **kwargs) as engine:
+        reports = engine.collective_rpc("q03_check_runtime",
+                                        args=(runtime, fixture_sha256), timeout=120)
+        validate_rank_configs(reports, spec["expected_effective_config"])
+        initial = [report["owner"] for report in reports]
+        assert {item["rank"] for item in initial} == {0, 1, 2, 3}
+        assert len(initial) == 4
+        assert all(item["sm"] == [12, 1] and item["tp"] == 4
+                   and not item["sequence_parallel"]
+                   and item["owner_present"] == (spec["mode"] == "dual")
+                   for item in initial)
+        for item in initial:
+            profile = item["steering_profile"]
+            if request_args is None:
+                assert profile is None
+            else:
+                assert profile is not None
+                assert profile["name"] == request_args["steering_profile"]
+                assert profile["artifact_sha256"] == kwargs["additional_config"][
+                    "ds41_steering"]["profile_sha256"]
+        assert all(item["steering_profile"] == initial[0]["steering_profile"]
+                   for item in initial)
+        readiness = await_steady_guard(spec, spec_sha256, reports)
+        outputs = []
+        for batch in spec["requests"] * 2:
+            params = SamplingParams(temperature=0.0, max_tokens=spec["max_tokens"],
+                                    extra_args=request_args)
+            generated = engine.generate(batch, params)
+            outputs.append([(token_ids[0], texts[0]) for token_ids, texts in generated])
+            assert engine.collective_rpc("q03_owner_snapshot") == initial
+        retention = (engine.collective_rpc("q03_observe_graph_resources", timeout=120)
+                      if spec["mode"] == "dual" else [])
+        # Ordinary engine context teardown only; no private graph cleanup.
+    with output.open("x") as stream:
+        json.dump({"mode": spec["mode"], "source_head": SOURCE_HEAD,
+                   "steering": spec["steering"], "resolved_workers": reports,
+                   "readiness": readiness, "owners": initial, "outputs": outputs, "retention": retention,
+                   "qualification": "Owner/collector retention only; fine-grained retirement and replay untested; no old188 comparison, numerical acceptance or performance claim"}, stream)
