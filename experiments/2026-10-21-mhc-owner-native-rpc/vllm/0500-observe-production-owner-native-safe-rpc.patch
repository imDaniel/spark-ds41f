+def validate_fixture_spec(spec):
+    """Reject an unspecified heavy model fixture before constructing an engine."""
+    if spec.get("source_head") != SOURCE_HEAD:
+        raise ValueError("This fixture targets the reviewed component197 runtime")
+    if spec.get("mode") not in ("off", "dual"):
+        raise ValueError("Run one startup mode per fresh test process")
+    for key in ("model_path", "runtime_manifest_path", "output_path"):
+        path = Path(spec[key])
+        if not path.is_absolute() or ".." in path.parts:
+            raise ValueError("Explicit absolute fixture paths are required")
+    digest = spec["runtime_manifest_sha256"]
+    if len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest):
+        raise ValueError("A reviewed runtime manifest hash is required")
+    kwargs = spec["engine_kwargs"]
+    if kwargs.get("worker_extension_cls") != WORKER_EXTENSION_CLS:
+        raise ValueError("The owner gate requires its pinned named-RPC worker extension")
+    if kwargs.get("tensor_parallel_size") != 4:
+        raise ValueError("The Q03 target fixture requires TP4")
+    if kwargs.get("enforce_eager") is not False:
+        raise ValueError("This is the production capture gate, not eager diagnosis")
+    for key in ("distributed_executor_backend", "compilation_config",
+                "max_model_len", "max_num_batched_tokens", "gpu_memory_utilization"):
+        if key not in kwargs:
+            raise ValueError("Missing reviewed engine binding: " + key)
+    backend = kwargs["distributed_executor_backend"]
+    if not isinstance(backend, str) or not backend.strip():
+        raise ValueError("Explicit distributed executor binding required")
+    for key in ("max_model_len", "max_num_batched_tokens"):
+        if type(kwargs[key]) is not int or kwargs[key] <= 0:
+            raise ValueError("Explicit positive engine capacity required: " + key)
+    memory = kwargs["gpu_memory_utilization"]
+    if (type(memory) not in (int, float) or not math.isfinite(memory)
+            or not 0 < memory <= 1):
+        raise ValueError("Explicit finite GPU memory utilization required")
+    if not isinstance(kwargs["compilation_config"], dict) or not kwargs["compilation_config"]:
+        raise ValueError("Explicit production compilation configuration required")
+    if kwargs.get("trust_remote_code", False) is not False:
+        raise ValueError("This local built-in model fixture does not load remote code")
+    if "model" in kwargs or "model_name" in kwargs:
+        raise ValueError("Use the separately bound local checkpoint path")
+    requests = spec["requests"]
+    if (not isinstance(requests, list) or len(requests) < 2
