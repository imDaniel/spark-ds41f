+def decode_tool_arguments(raw: Any) -> Dict[str, Any]:
+    """Unwrap an OpenAI function.arguments envelope, preserving the DSML fallback."""
+    arguments = raw
+    for _ in range(2):
+        if not isinstance(arguments, str):
+            break
+        try:
+            arguments = json.loads(arguments)
+        except (ValueError, RecursionError):
+            break
+    return arguments if isinstance(arguments, dict) else {"arguments": raw}
+
