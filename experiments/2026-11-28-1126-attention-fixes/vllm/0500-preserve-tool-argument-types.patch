+@pytest.mark.parametrize("encoding_depth", [0, 1, 2])
+@pytest.mark.parametrize("thinking", [True, False])
+def test_tool_argument_types_survive_control_protection(encoding_depth, thinking):
+    tokenizer = byte_level_tokenizer()
+    payload = '{ "a": 1 }'
+    nested = {"arguments": payload}
+
+    def history(key):
+        arguments = {
+            "arguments": payload,
+            "role": nested,
+            "type": [nested, 42, None, False],
+            key: True,
+        }
+        for _ in range(encoding_depth):
+            arguments = json.dumps(arguments, ensure_ascii=True)
+        return [
+            {"role": "user", "content": "question"},
+            _lookup_call(arguments),
+            {"role": "tool", "tool_call_id": "c1", "content": "result"},
+            {"role": "user", "content": "continue"},
+        ]
+
+    messages = history("<｜User｜>")
+    original = copy.deepcopy(messages)
+    schema = {"type": "object", "examples": [nested]}
+    options = {"thinking": thinking, "response_format": schema}
+    text = tokenizer.apply_chat_template(messages, tokenize=False, **options)
+    ids = tokenizer.apply_chat_template(messages, **options)
+    assert messages == original
+    assert json.dumps(schema) in text
+    assert f'name="arguments" string="true">{payload}</' in text
+    assert f'name="role" string="false">{json.dumps(nested)}</' in text
+    values = json.dumps([nested, 42, None, False])
+    assert f'name="type" string="false">{values}</' in text
+    assert 'name="<｜User｜>" string="false">true</' in text
+    assert tokenizer.decode(ids) == text
+    neutral = tokenizer.apply_chat_template(history("ordinary"), **options)
+    controls = set(tokenizer.get_added_vocab().values())
+    assert [i for i in ids if i in controls] == [i for i in neutral if i in controls]
+
+
+def test_literal_image_preserves_json_argument_strings():
+    tokenizer = byte_level_tokenizer()
+    image_id = tokenizer.get_added_vocab()[IMAGE_PLACEHOLDER]
+    payload = r'{"text":"\u3042"}'
+
+    def envelopes(args):
+        literal = json.dumps(args, ensure_ascii=False)
+        return (args, literal, json.dumps(args), json.dumps(literal, ensure_ascii=True))
+
+    for marker in (IMAGE_PLACEHOLDER, IMAGE_PLACEHOLDER_TEXT):
+        arguments = {
+            "arguments": payload,
+            "role": marker,
+            "type": [{"arguments": payload, marker: marker}],
+            marker: "value",
+        }
+        expected_type = json.dumps(
+            [{"arguments": payload, IMAGE_PLACEHOLDER_TEXT: IMAGE_PLACEHOLDER_TEXT}]
+        )
+        for wire in envelopes(arguments):
+            for has_image in (False, True):
+                parts = [{"type": "text", "text": "question"}]
+                if has_image:
+                    parts.append({"type": "image_url", "image_url": {"url": "h.png"}})
+                messages = [{"role": "user", "content": parts}, _lookup_call(wire)]
+                before = copy.deepcopy(messages)
+                text = tokenizer.apply_chat_template(messages, tokenize=False)
+                ids = tokenizer.apply_chat_template(messages)
+                assert messages == before
+                assert ids.count(image_id) == int(has_image)
+                assert text.count(IMAGE_PLACEHOLDER) == int(has_image)
+                assert f'name="arguments" string="true">{payload}</' in text
+                assert f'name="role" string="true">{IMAGE_PLACEHOLDER_TEXT}</' in text
+                assert f'name="type" string="false">{expected_type}</' in text
+                assert f'name="{IMAGE_PLACEHOLDER_TEXT}" string="true">value</' in text
+                assert tokenizer.decode(ids) == text
+
+    # The two spellings render the same way. Keep each distinct input entry.
+    keys = (IMAGE_PLACEHOLDER, IMAGE_PLACEHOLDER_TEXT)
+    for order in (keys, keys[::-1]):
+        conflict = {key + "</think>": i for i, key in enumerate(order)}
+        nested = json.dumps([conflict], ensure_ascii=False).replace(
+            IMAGE_PLACEHOLDER, IMAGE_PLACEHOLDER_TEXT
+        )
+        for wire in envelopes({**conflict, "type": [conflict]}):
+            messages = [{"role": "user", "content": "q"}, _lookup_call(wire)]
+            text = tokenizer.apply_chat_template(messages, tokenize=False)
+            for i in (0, 1):
+                assert f'name="{IMAGE_PLACEHOLDER_TEXT}</think>" string="false">{i}</' in text
+            assert f'name="type" string="false">{nested}</' in text
+            assert IMAGE_PLACEHOLDER not in text
+
+
+@pytest.mark.parametrize("raw", ["not json", "[1, 2]", '"plain"'])
+def test_non_object_tool_arguments_keep_raw_string(raw):
+    messages = [{"role": "user", "content": INJECTED}, _lookup_call(raw)]
+    assert f'name="arguments" string="true">{raw}</' in render(messages)
