+def _decode_message_tool_calls(message: ChatCompletionMessageParam):
+    """Expose escaped control spellings at the protocol's JSON boundary only."""
+    if message.get("role") != "assistant" or not (calls := message.get("tool_calls")):
+        return message
+    decoded_calls = []
+    for call in calls:
+        function = call["function"]
+        arguments = decode_tool_arguments(function["arguments"])
+        decoded_calls.append({**call, "function": {**function, "arguments": arguments}})
+    return {**message, "tool_calls": decoded_calls}
 
 
