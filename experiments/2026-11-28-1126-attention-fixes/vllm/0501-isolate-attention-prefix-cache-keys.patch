+@pytest.mark.parametrize("hash_fn", [sha256, sha256_cbor])
+@pytest.mark.parametrize("via_frontend", [False, True], ids=["prebuilt", "frontend"])
+def test_attention_cache_namespace(hash_fn, via_frontend):
+    from unittest.mock import Mock
+
+    from vllm import weightless
+    from vllm.exceptions import VLLMValidationError
+    from vllm.inputs.engine import tokens_input
+    from vllm.v1.engine import EngineCoreRequest
+    from vllm.v1.engine.core import EngineCore
+    from vllm.v1.engine.input_processor import InputProcessor
+
+    profile = SimpleNamespace(profile_id="test-profile", identity="a" * 64)
+    core = SimpleNamespace(
+        mm_receiver_cache=None,
+        _steering_profile=profile,
+        request_block_hasher=get_request_block_hasher(3, hash_fn),
+    )
+    processor = Mock(spec=InputProcessor)
+    processor._steering_profile = profile
+    processor.vllm_config = SimpleNamespace(
+        parallel_config=SimpleNamespace(
+            data_parallel_size=1, data_parallel_size_local=1, local_engines_only=True
+        )
+    )
+    processor.tokenizer = None
+    processor.renderer = Mock()
+    processor.renderer.get_eos_token_id.return_value = None
+    processor.generation_config_fields = {}
+
+    def submit(extra=None, salt=None, **kwargs):
+        params = SamplingParams(max_tokens=1, extra_args=extra)
+        tokens = list(range(6))
+        if via_frontend:
+            prompt = tokens_input(tokens, cache_salt=salt)
+            wire = InputProcessor.process_inputs(
+                processor, "request", prompt, params, ("generate",), **kwargs
+            )
+        else:
+            wire = EngineCoreRequest(
+                request_id="request",
+                prompt_token_ids=tokens,
+                mm_features=None,
+                sampling_params=params,
+                pooling_params=None,
+                arrival_time=0.0,
+                lora_request=None,
+                cache_salt=salt,
+                data_parallel_rank=None,
+                **kwargs,
+            )
+        assert wire.cache_salt == salt
+        req, _ = EngineCore.preprocess_add_request(core, wire)
+        assert req.cache_salt == salt
+        return req
+
+    args = {"steering_profile": profile.profile_id}
+    stock = submit()
+    active = submit(args)
+    assert stock.block_hashes == submit({**args, "steering_scale": 0}).block_hashes
+    assert active.block_hashes == submit({**args, "steering_scale": 1}).block_hashes
+    assert len(active.block_hashes) == len(stock.block_hashes) == 2
+    assert all(x != y for x, y in zip(active.block_hashes, stock.block_hashes))
+    assert active.block_hashes != submit({**args, "steering_scale": 2}).block_hashes
+
+    key = ("ds41-attention-v1", profile.identity, 0x3F800000)
+
+    def first_keys(req):
+        return generate_block_hash_extra_keys(req, 0, 3, 0)[0]
+
+    assert first_keys(active) == (key,)
+    assert generate_block_hash_extra_keys(active, 3, 6, 0) == (None, 0)
+    # Caller salts keep their own slot, including text matching the internal tag.
+    assert first_keys(submit(salt=key[0])) == (key[0],)
+    assert first_keys(submit(args, "caller")) == ("caller", key)
+    salted_chains = {
+        tuple(submit(args, salt).block_hashes) for salt in (None, "", "caller", "other")
+    }
+    assert len(salted_chains) == 4
+    glp = submit({weightless.EXTRA_ARGS_KEY: True}, "caller")
+    assert first_keys(glp) == ("caller", weightless.BLOCK_HASH_KEY)
+
+    with pytest.raises(VLLMValidationError, match="unknown steering_profile"):
+        submit({"steering_profile": "unknown"})
+    with pytest.raises(VLLMValidationError, match="resumable"):
+        submit(args, resumable=True)
+    with pytest.raises(VLLMValidationError, match="resumable"):
+        submit(args, session_id="session")
+
+
