--- a/vllm/tokenizers/deepseek_v41.py
+++ b/vllm/tokenizers/deepseek_v41.py
@@ -247,6 +247,7 @@ class _ControlSpellings:
     def __init__(self, pattern: re.Pattern[str] | None) -> None:
         self.pattern = pattern
         self.originals: list[str] = []
+        self._sentinels: dict[str, str] = {}
         self.open = self.close = ""
         self._sentinel_re: re.Pattern[str] | None = None
 
@@ -278,8 +279,12 @@ class _ControlSpellings:
         )
 
     def _sentinel(self, match: re.Match[str]) -> str:
-        self.originals.append(match.group(0))
-        return f"{self.open}{len(self.originals) - 1}{self.close}"
+        spelling = match.group(0)
+        if spelling not in self._sentinels:
+            # Repeated identifiers must still compare equal during rendering.
+            self._sentinels[spelling] = f"{self.open}{len(self.originals)}{self.close}"
+            self.originals.append(spelling)
+        return self._sentinels[spelling]
 
     def restore(self, text: str) -> str:
         if not self.originals or self.open not in text:
@@ -418,12 +423,32 @@ def _escape_image_token_literal(value: Any) -> Any:
     )
 
 
+def _escape_image_text_in_message(message: dict[str, Any]) -> dict[str, Any]:
+    escaped = _escape_image_token_literal(message)
+    # These fields join a tool result to its call. They never contribute text
+    # to the prompt, so neither image spelling may alter their identities.
+    if message.get("role") == "assistant" and message.get("tool_calls"):
+        for call, target in zip(message["tool_calls"], escaped["tool_calls"]):
+            if "id" in call:
+                target["id"] = call["id"]
+            function = call.get("function")
+            if isinstance(function, Mapping) and "id" in function:
+                target["function"]["id"] = function["id"]
+    elif message.get("role") == "tool" and "tool_call_id" in message:
+        escaped["tool_call_id"] = message["tool_call_id"]
+    elif message.get("role") == "user" and message.get("content_blocks"):
+        for block, target in zip(message["content_blocks"], escaped["content_blocks"]):
+            if block.get("type") == "tool_result" and "tool_use_id" in block:
+                target["tool_use_id"] = block["tool_use_id"]
+    return escaped
+
+
 def _normalize_messages(
     messages: list[ChatCompletionMessageParam],
 ) -> list[dict[str, Any]]:
     result = [dict(message) for message in messages]
     if any(IMAGE_PLACEHOLDER in text for text in _strings(result)):
