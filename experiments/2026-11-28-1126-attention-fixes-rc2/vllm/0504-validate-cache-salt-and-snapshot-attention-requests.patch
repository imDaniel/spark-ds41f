+@pytest.mark.parametrize("client_kind", ["inproc", "sync", "async", "dp_async"])
+def test_attention_cache_namespace_rechecks_salt_at_dispatch(client_kind, attention_wire):
+    import asyncio
+    from functools import partial
+    from unittest.mock import AsyncMock, Mock
+
+    from vllm.v1.engine.core import EngineCore
+    from vllm.v1.engine.core_client import (
+        AsyncMPClient,
+        DPAsyncMPClient,
+        InprocClient,
+        SyncMPClient,
+    )
+
+    profile, make_wire = attention_wire
+    wire = make_wire(False, {"steering_profile": profile.profile_id}, "original")
+    if client_kind == "inproc":
+        core = SimpleNamespace(
+            mm_receiver_cache=None, _steering_profile=profile, request_block_hasher=None
+        )
+        core.preprocess_add_request = partial(EngineCore.preprocess_add_request, core)
+        core.add_request = Mock()
+        client = SimpleNamespace(engine_core=core)
+        dispatch = partial(InprocClient.add_request, client)
+        send = core.add_request
+    else:
+        send = Mock() if client_kind == "sync" else AsyncMock()
+        client = SimpleNamespace(
+            is_dp=True, engines_running=False, client_index=1, current_wave=0,
+            _send_input=send, _ensure_stats_update_task=Mock(),
+            _ensure_output_queue_task=Mock(), get_core_engine_for_request=Mock(),
+            first_req_send_socket=SimpleNamespace(send=AsyncMock()),
+        )
+        client.get_core_engine_for_request.return_value = b"core"
+        if client_kind == "sync":
+            dispatch = partial(SyncMPClient.add_request, client)
+        else:
+            cls = AsyncMPClient if client_kind == "async" else DPAsyncMPClient
+
+            def dispatch(req):
+                asyncio.run(cls.add_request_async(client, req))
+
+    # A public prebuilt request can be edited after its constructor returns.
+    wire.cache_salt = 42
+    with pytest.raises(ValueError, match="cache_salt must be a string or absent"):
+        dispatch(wire)
+    send.assert_not_called()
+    if client_kind != "inproc":
+        assert not client.engines_running
+        client._ensure_stats_update_task.assert_not_called()
+        client.get_core_engine_for_request.assert_not_called()
+
+    wire.cache_salt = ""
+    dispatch(wire)
+    send.assert_called_once()
+
+
+@pytest.mark.parametrize("caching", [False, True])
+@pytest.mark.parametrize(
+    "extra",
+    [None, {}, {"other": 5}, {"steering_profile": "test-profile"}],
+    ids=["stock", "empty", "unrelated", "active"],
+)
+def test_attention_cache_namespace_snapshots_prebuilt(caching, extra, attention_wire):
+    from vllm.models.deepseek_v4_1.steering.request import parse_selection
+    from vllm.v1.engine.core import EngineCore
+
+    profile, make_wire = attention_wire
+    wire = make_wire(False, None if extra is None else dict(extra))
+    params = wire.sampling_params
+    submitted = params.extra_args
+    expected = parse_selection(submitted, profile)
+    core = SimpleNamespace(
+        mm_receiver_cache=None,
+        _steering_profile=profile,
+        request_block_hasher=get_request_block_hasher(3, sha256) if caching else None,
+    )
+    req, _ = EngineCore.preprocess_add_request(core, wire)
+    assert params.extra_args is submitted and submitted == extra
+    assert req.attention_cache_key == expected.cache_key
+    assert len(req.block_hashes) == (2 if caching else 0)
+    # The runner reads req.sampling_params.extra_args when the scheduler sends
+    # the request. Reusing either the caller's dict or its params is harmless.
+    next_selection = {"steering_profile": profile.profile_id, "steering_scale": 2}
+    if submitted is not None:
+        submitted.update(next_selection)
+        assert parse_selection(req.sampling_params.extra_args, profile) == expected
+    params.extra_args = next_selection
+    assert parse_selection(req.sampling_params.extra_args, profile) == expected
+
+
 @pytest.mark.parametrize("hash_fn", [sha256, sha256_cbor])
 def test_hash_block_tokens(hash_fn):
     parent_block_hash = BlockHash(b"123")
