+@pytest.mark.parametrize("via_frontend", [False, True], ids=["prebuilt", "frontend"])
+def test_attention_cache_namespace_validates_wire_salt(via_frontend, attention_wire):
+    profile, make_wire = attention_wire
+    # Assert the frontend boundary alone, before core admission or transport.
+    with pytest.raises(ValueError, match="cache_salt must be a string or absent"):
