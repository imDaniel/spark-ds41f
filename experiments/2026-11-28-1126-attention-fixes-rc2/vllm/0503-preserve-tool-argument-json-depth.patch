 def _strings(value: Any):
-    if isinstance(value, str):
-        yield value
-    elif isinstance(value, Mapping):
-        for k, item in value.items():
-            yield from _strings(k)
-            yield from _strings(item)
-    elif isinstance(value, (list, tuple)):
-        for item in value:
-            yield from _strings(item)
+    # A wire-format tool argument can be deeper than Python's call stack.
+    # Stay lazy so a match at the start of a large request can short-circuit.
+    ancestors: set[int] = set()
+    pending: list[tuple[int | None, Any]] = [(None, iter((value,)))]
+    while pending:
+        for item in pending[-1][1]:
+            if isinstance(item, str):
+                yield item
+            elif isinstance(item, Mapping):
+                identity = _enter_request_container(item, ancestors)
+                pending.append((identity, chain.from_iterable(item.items())))
+                break
+            elif isinstance(item, (list, tuple)):
+                identity = _enter_request_container(item, ancestors)
+                pending.append((identity, iter(item)))
+                break
+        else:
+            identity, _ = pending.pop()
+            if identity is not None:
+                ancestors.remove(identity)
+
+
+def _map_request_text(
+    value: Any, replace: Callable[[str], str], *, images: bool = False
+) -> Any:
+    """Copy a request tree without requiring a Python frame per JSON level.
+
+    Rebuild each container after its children. Image escaping keeps mapping
+    keys and protocol identifiers verbatim; control protection rewrites both.
+    """
+    # Nonnegative stages hold an output offset for a container to rebuild.
+    visit, keep = -1, -2
+    output: list[Any] = []
+    ancestors: set[int] = set()
+    pending = [(value, visit)]
+    while pending:
+        node, stage = pending.pop()
+        if stage == keep:
+            output.append(node)
+        elif stage >= 0:
+            ancestors.remove(id(node))
+            children = output[stage:]
+            if isinstance(node, Mapping):
+                items = iter(children)
+                output[stage:] = [dict(zip(items, items))]
+            else:
+                output[stage:] = [type(node)(children)]
+        elif isinstance(node, Mapping):
+            _enter_request_container(node, ancestors)
+            pending.append((node, len(output)))
+            for key, item in reversed(list(node.items())):
+                item_stage = keep if images and key in _PROTOCOL_KEYS else visit
+                pending.append((item, item_stage))
+                pending.append((key, keep if images else visit))
+        elif isinstance(node, (tuple, list)):
+            _enter_request_container(node, ancestors)
+            pending.append((node, len(output)))
+            pending.extend((item, visit) for item in reversed(node))
+        else:
+            output.append(replace(node) if isinstance(node, str) else node)
+    return output[0]
 
 
