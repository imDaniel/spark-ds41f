+def test_deep_tool_argument_json_keeps_renderer_depth():
+    tokenizer = byte_level_tokenizer()
+    image_id = tokenizer.get_added_vocab()[IMAGE_PLACEHOLDER]
+    for opening, closing in (("[", "]"), ('{"layer":', "}")):
+        for marker in ("ordinary", "<｜User｜>", IMAGE_PLACEHOLDER):
+            value = opening * 1024 + json.dumps(marker) + closing * 1024
+            wire = '{"levels":' + value + "}"
+            messages = [
+                {"role": "user", "content": marker}, _lookup_call(wire),
+            ]
+            # The DSML renderer determines whether this Python JSON codec can
+            # decode the value or preserves the original wire string.
+            expected = encode_arguments_to_dsml({"arguments": wire})
+            text = tokenizer.apply_chat_template(messages, tokenize=False)
+            ids = tokenizer.apply_chat_template(messages)
+            assert expected in text
+            assert tokenizer.decode(ids) == text
+            assert ids.count(image_id) == 0
+
+    # Direct Python callers can use shared acyclic data or pass a cycle.
+    shared = ["<｜User｜>"]
+    calls = _lookup_call({"left": shared, "right": shared})
+    text = tokenizer.apply_chat_template([calls], tokenize=False)
+    assert 'name="left" string="false">["<｜User｜>"]' in text
+    assert 'name="right" string="false">["<｜User｜>"]' in text
+    loop = {"image": IMAGE_PLACEHOLDER}
+    loop["again"] = [loop]
+    messages = [_lookup_call(loop)]
+    with pytest.raises(RecursionError, match="Cycle"):
+        tokenizer.apply_chat_template(messages)
+    with pytest.raises(RecursionError, match="Cycle"):
+        _normalize_messages(messages)
