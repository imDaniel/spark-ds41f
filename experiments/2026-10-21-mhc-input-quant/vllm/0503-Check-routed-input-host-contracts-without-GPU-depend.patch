+class QuartetMappingContracts(unittest.TestCase):
+    def test_reference_mapping_covers_every_column_and_scale_once(self):
+        """Integer design enumeration only, not execution of the GPU kernel."""
+        columns, scale_writers = [], []
+        for step in range(7):
+            valid_workers = 0
+            for worker in range(96):
+                chunk = step * 96 + worker
+                if chunk >= 640:
+                    continue
+                valid_workers += 1
+                columns.extend(chunk * 8 + v for v in range(8))
+                if worker % 4 == 0:
+                    scale_writers.append(chunk // 4)
+                quartet = {worker, worker ^ 1, worker ^ 2, worker ^ 3}
+                self.assertEqual({lane // 4 for lane in quartet}, {worker // 4})
+                self.assertEqual({(lane + 32) // 32 for lane in quartet},
+                                 {(worker + 32) // 32})
+            self.assertEqual(valid_workers, 64 if step == 6 else 96)
+        self.assertEqual(sorted(columns), list(range(5120)))
+        self.assertEqual(sorted(scale_writers), list(range(160)))
+
+    def test_xor_four_mutant_crosses_scale_group(self):
+        self.assertNotEqual({0 // 4, (0 ^ 4) // 4}, {0})
+
