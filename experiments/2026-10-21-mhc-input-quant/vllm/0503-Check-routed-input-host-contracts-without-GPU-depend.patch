+class RoutedInputContracts(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.host = load_host(source_path("BRIDGE", REL / "routed_input.py"))
+
+    def test_valid_pair_keeps_identity(self):
+        x, q, sf = buffers()
+        self.assertEqual(self.host.validate_input_quant(x, (q, sf)), (q, sf))
+
+    def test_invalid_pairs_fail_even_for_zero_rows(self):
+        for rows in (0, 1, 6, 8192):
+            for field in ("half", "list", "q_dtype", "sf_dtype", "q_shape",
+                          "sf_shape", "q_stride", "sf_stride", "device",
+                          "source_dtype", "source_stride", "source_width"):
+                with self.subTest(rows=rows, field=field):
+                    x, q, sf = buffers(rows)
+                    pair = (q, sf)
+                    if field == "half":
+                        pair = (q, None)
+                    elif field == "list":
+                        pair = [q, sf]
+                    elif field == "q_dtype":
+                        q.dtype = "bf16"
+                    elif field == "sf_dtype":
+                        sf.dtype = "uint32"
+                    elif field == "q_shape":
+                        q.shape = (rows + 1, 5120)
+                    elif field == "sf_shape":
+                        sf.shape = (rows, 40)
+                    elif field == "q_stride":
+                        q._stride = (1, max(rows, 1))
+                    elif field == "sf_stride":
+                        sf._stride = (320, 2)
+                    elif field == "device":
+                        sf.device = Device("cuda:1")
+                    elif field == "source_dtype":
+                        x.dtype = "float32"
+                    elif field == "source_stride":
+                        x._stride = (10240, 2)
+                    elif field == "source_width":
+                        x.shape = (rows, 576)
+                    with self.assertRaises(ValueError):
+                        self.host.validate_input_quant(x, pair)
+
+    def test_storage_alias_and_alignment_rejected(self):
+        for kind in ("q_sf", "q_x", "sf_x", "q_alignment", "sf_alignment"):
+            with self.subTest(kind=kind):
+                x, q, sf = buffers()
+                if kind == "q_sf":
+                    sf.address = q.address + 256
+                elif kind == "q_x":
+                    q.address = x.address + 256
+                elif kind == "sf_x":
+                    sf.address = x.address
+                elif kind == "q_alignment":
+                    q.address += 1
+                else:
+                    sf.address += 4
+                with self.assertRaises(ValueError):
+                    self.host.validate_input_quant(x, (q, sf))
+
+    def test_fake_metadata_does_not_access_storage(self):
+        x, q, sf = buffers()
+        def forbidden():
+            raise AssertionError("metadata validation read storage")
+        for tensor in (x, q, sf):
+            tensor.data_ptr = forbidden
+        self.host.validate_input_quant_metadata(x, (q, sf))
+
+    def test_exactly_once_consumption_and_baseline_reset(self):
+        x, q, sf = buffers()
+        owner = object()
+        with self.host.scoped_routed_input(owner, x, (q, sf)):
+            self.assertEqual(self.host.consume_routed_input(owner, x), (q, sf))
+            with self.assertRaises(RuntimeError):
+                self.host.consume_routed_input(owner, x)
+        self.assertIsNone(self.host.consume_routed_input(owner, x))
+
+    def test_wrong_owner_and_same_address_replacement_rejected(self):
+        x, q, sf = buffers()
+        owner = object()
+        for consumer, source in ((object(), x), (owner, buffers()[0])):
+            with self.subTest(same_owner=consumer is owner):
+                with self.assertRaises(RuntimeError):
+                    with self.host.scoped_routed_input(owner, x, (q, sf)):
+                        self.host.consume_routed_input(consumer, source)
+                self.assertIsNone(self.host.consume_routed_input(owner, x))
+
+    def test_scoped_helper_resets_for_injected_stage_exceptions(self):
+        x, q, sf = buffers()
+        owner = object()
+        for stage in ("router", "dispatch", "expert", "shared_wait"):
+            with self.subTest(stage=stage):
+                with self.assertRaisesRegex(LookupError, stage):
+                    with self.host.scoped_routed_input(owner, x, (q, sf)):
+                        if stage == "shared_wait":
+                            self.host.consume_routed_input(owner, x)
+                        raise LookupError(stage)
+                self.assertIsNone(self.host.consume_routed_input(owner, x))
+                with self.host.scoped_routed_input(owner, x, (q, sf)):
+                    self.host.consume_routed_input(owner, x)
+
+    def test_unconsumed_and_nested_scope_fail_then_recover(self):
+        x, q, sf = buffers()
+        owner = object()
+        with self.assertRaisesRegex(RuntimeError, "not consumed"):
+            with self.host.scoped_routed_input(owner, x, (q, sf)):
+                pass
+        with self.host.scoped_routed_input(owner, x, (q, sf)):
+            with self.assertRaisesRegex(RuntimeError, "nested"):
+                with self.host.scoped_routed_input(owner, x, (q, sf)):
+                    pass
+            self.host.consume_routed_input(owner, x)
+        self.assertIsNone(self.host.consume_routed_input(owner, x))
+
