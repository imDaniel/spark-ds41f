+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import socket
+import sys
+from types import ModuleType, SimpleNamespace
+import unittest
+
+ROOT = Path(os.environ.get("Q03_SOURCE_ROOT", Path(__file__).resolve().parents[2]))
+REL = Path("vllm/models/deepseek_v4_1/tilelang")
+SOURCE_LOADS = []
+
