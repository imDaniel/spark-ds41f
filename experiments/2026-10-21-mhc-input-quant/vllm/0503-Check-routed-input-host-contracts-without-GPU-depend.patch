+class ArenaHostContracts(unittest.TestCase):
+    def setUp(self):
+        self.allocations = []
+        self.retained = []
+        def allocate(size, dtype, device):
+            address = 0x10000000 + len(self.allocations) * 0x10000000
+            tensor = MetadataTensor((size,), dtype, address, device=device.value)
+            self.allocations.append(tensor)
+            return tensor
+        facade = SimpleNamespace(**vars(TORCH_METADATA))
+        facade.empty = allocate
+        facade.device = lambda d: d if isinstance(d, Device) else Device(d)
+        self.host = load_host(
+            source_path("MODEL", REL / "input_quant_arena.py"),
+            {"torch": facade,
+             "retain_cuda_graph_capture_resource": self.retained.append},
+            {"RoutedInputQuantArena", "RoutedInputQuantLease"},
+        )
+
+    def test_two_fixed_allocations_have_exact_budget_and_stable_slices(self):
+        arena = self.host.RoutedInputQuantArena(8192, "cuda:0")
+        self.assertEqual(len(self.allocations), 2)
+        self.assertEqual(sum(arena.storage_sizes(8192)), 43253760)
+        self.assertIsNot(arena.q_storage, arena.sf_storage)
+        bases = (arena.q.data_ptr(), arena.sf.data_ptr())
+        for rows in (1, 6, 16, 96, 4096, 4097, 8192, 6):
+            lease = arena.borrow(rows)
+            self.assertIs(lease.owner, arena)
+            self.assertEqual((lease.q.data_ptr(), lease.sf.data_ptr()), bases)
+            self.assertEqual(lease.q.shape, (rows, 5120))
+            self.assertEqual(lease.sf.shape, (rows, 160))
+            lease.release()
+        self.assertEqual(len(self.allocations), 2)
+        self.assertEqual(self.retained, [])  # No ContextVar call outside opaque op.
+
+    def test_lease_bounds_nesting_and_duplicate_release(self):
+        arena = self.host.RoutedInputQuantArena(6, "cuda:0")
+        for rows, slot in ((0, 0), (-1, 0), (7, 0), (1, 1)):
+            with self.assertRaises(ValueError):
+                arena.borrow(rows, slot)
+        lease = arena.borrow(6)
+        with self.assertRaises(RuntimeError):
+            arena.borrow(1)
+        lease.release()
+        with self.assertRaises(RuntimeError):
+            lease.release()
+        arena.borrow(1).release()
+
+    def test_zero_budget_is_arithmetic_only_not_an_allocated_arena(self):
+        self.assertEqual(self.host.RoutedInputQuantArena.storage_sizes(0), (0, 0))
+        for capacity, device in ((0, "cuda:0"), (-1, "cuda:0"), (1, "cpu")):
+            with self.assertRaises(ValueError):
+                self.host.RoutedInputQuantArena(capacity, device)
+        self.assertEqual(self.allocations, [])
+
