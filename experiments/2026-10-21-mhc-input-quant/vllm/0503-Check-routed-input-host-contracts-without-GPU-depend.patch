+                        events.append((kind + "_key", a, k))
+                        return lambda *a: events.append((kind + "_launch", a))
+                    return factory
+                scratch = SimpleNamespace(get_simultaneous=lambda *specs:
+                    tuple(tensor(shape, dtype) for shape, dtype in specs))
