+class ProducerHostContracts(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        import math
+        cls.host = load_host(
+            source_path("KERNEL", REL / "mhc.py"),
+            {"isfinite": math.isfinite, "finalize": object(),
+             "prepare": SimpleNamespace(call=lambda f, *a, **k: (f, a, k))},
+            {"_validate_mxfp8_config", "_validate_mxfp8_outputs",
+             "_validate_mxfp8_storage", "_finalize_call"},
+        )
+
+    def config(self, clamp=1e-4):
+        return SimpleNamespace(
+            torch_dtype="e4m3", sf_block=(1, 32),
+            use_tma_aligned_col_major_sf=False, round_sf=True,
+            use_packed_ue8m0=True, use_e4m3_sf=False, clamp_min_value=clamp,
+        )
+
+    def test_false_key_is_exact_legacy_six_arguments_no_kwargs(self):
+        args = (5120, 20480, 1e-20, 1e-6, 20)
+        call = self.host._finalize_call(*args)
+        self.assertEqual(call[1], (*args, args[2]))
+        self.assertEqual(call[2], {})
+        self.assertEqual(call, self.host._finalize_call(
+            *args, emit_mxfp8=False, quant_config=self.config()
+        ))
+
+    def test_true_key_contains_actual_config_and_distinguishes_clamp(self):
+        calls = []
+        for clamp in (1e-4, 2e-4):
+            config = self.config(clamp)
+            call = self.host._finalize_call(
+                5120, 20480, 1e-20, 1e-6, 20,
+                emit_mxfp8=True, quant_config=config,
+            )
+            self.assertEqual(set(call[2]), {"emit_mxfp8", "quant_config"})
+            self.assertIs(call[2]["quant_config"], config)
+            self.assertIs(call[2]["emit_mxfp8"], True)
+            calls.append(call)
+        self.assertNotEqual(calls[0], calls[1])
+
+    def test_invalid_quant_config_rejected_before_factory(self):
+        for clamp in (0, -1, float("nan"), float("inf"), None):
+            with self.subTest(clamp=clamp), self.assertRaises(ValueError):
+                self.host._finalize_call(
+                    5120, 20480, 1e-20, 1e-6, 20,
+                    emit_mxfp8=True, quant_config=self.config(clamp),
+                )
+
+    def test_producer_rejects_disjoint_views_with_shared_backing_allocation(self):
+        x, q, sf = buffers()
+        sf.untyped_storage = q.untyped_storage
+        with self.assertRaises(ValueError):
+            self.host._validate_mxfp8_storage(q, sf, x)
+
+    def test_zero_row_sink_metadata_is_still_validated(self):
+        x, q, sf = buffers(0)
+        self.host._validate_mxfp8_outputs(x, q, sf)
+        for pair in ((q, None), (None, sf)):
+            with self.assertRaises(ValueError):
+                self.host._validate_mxfp8_outputs(x, *pair)
+        sf._stride = (320, 2)
+        with self.assertRaises(ValueError):
+            self.host._validate_mxfp8_outputs(x, q, sf)
+
+    def test_dual_schema_declares_sinks_and_fake_signature_matches(self):
+        tree = ast.parse(source_path("KERNEL", REL / "mhc.py").read_text())
+        functions = {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef)}
+        real = functions["_mhc_pre_mxfp8"]
+        fake = functions["_mhc_pre_mxfp8_fake"]
+        for signature in (real.args, fake.args):
+            for argument in (*signature.args, *signature.kwonlyargs):
+                argument.annotation = None
+        self.assertEqual(ast.dump(real.args), ast.dump(fake.args))
+        decorator = real.decorator_list[0]
+        mutations = next(k.value for k in decorator.keywords
+                         if k.arg == "mutates_args")
+        self.assertEqual(set(ast.literal_eval(mutations)), {
+            "residual_out", "y", "post", "comb", "pre_out", "q_out", "sf_out",
+        })
+        legacy = functions["_mhc_pre"]
+        self.assertNotIn("q_out", {a.arg for a in legacy.args.args})
+        self.assertNotIn("sf_out", {a.arg for a in legacy.args.args})
