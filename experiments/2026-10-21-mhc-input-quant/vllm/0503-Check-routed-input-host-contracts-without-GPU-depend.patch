+                q, sf = tensor((rows, 5120), "e4m3"), tensor((rows, 160), "u8")
+                if state != "legacy":
+                    args.update(q_out=q, sf_out=sf)
+                if rows and state in ("missing", "drift"):
+                    with self.assertRaisesRegex(RuntimeError, "unprepared or changed"):
+                        native._mhc_pre_impl(**args)
