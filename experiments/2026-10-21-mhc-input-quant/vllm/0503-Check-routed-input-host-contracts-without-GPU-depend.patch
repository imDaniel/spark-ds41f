+def load_host(path, env=None, definitions=None):
+    """Keep selected source bodies exact; omit imports/decorators only as stated."""
+    tree = ast.parse(path.read_text())
+    if definitions is None:
+        tree.body = [node for node in tree.body if not (
+            isinstance(node, ast.Import)
+            and any(alias.name == "torch" for alias in node.names)
+        )]
+    else:
+        selected = []
+        for node in tree.body:
+            if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
+                if node.name in definitions:
+                    node.decorator_list = []
+                    selected.append(node)
+                if isinstance(node, ast.ClassDef):
+                    for method in node.body:
+                        if (isinstance(method, ast.FunctionDef)
+                                and f"{node.name}.{method.name}" in definitions):
+                            method.decorator_list = []
+                            selected.append(method)
+        assert len(selected) == len(definitions), (path, definitions)
+        tree.body = selected
+    class OmitRuntimeImports(ast.NodeTransformer):
+        def visit_ImportFrom(self, node):
+            if node.level or (node.module or "").startswith("vllm"):
+                return ast.copy_location(ast.Pass(), node)
+            return node
+    # Selected bodies retain logic; project-local imports bind explicit env adapters.
+    tree = OmitRuntimeImports().visit(tree)
+    tree.body.insert(0, ast.ImportFrom(
+        module="__future__", names=[ast.alias(name="annotations")], level=0
+    ))
+    module = ModuleType(f"q03_host_{len(SOURCE_LOADS)}")
+    sys.modules[module.__name__] = module
+    module.__dict__.update(torch=TORCH_METADATA)
+    module.__dict__.update(env or {})
+    exec(compile(ast.fix_missing_locations(tree), str(path), "exec"), module.__dict__)
+    SOURCE_LOADS.append((str(path), hashlib.sha256(path.read_bytes()).hexdigest()))
+    return module
+
+
+def buffers(rows=6):
+    return (MetadataTensor((rows, 5120)),
+            MetadataTensor((rows, 5120), "e4m3", 0x200000),
+            MetadataTensor((rows, 160), "u8", 0x300000))
+
