+class MetadataTensor:
+    """No payload/driver: integer addresses are explicit test fixtures only."""
+
+    def __init__(self, shape, dtype="bf16", address=0x100000, strides=None,
+                 device="cuda:0"):
+        self.shape = tuple(shape)
+        self.ndim = len(shape)
+        self.dtype = dtype
+        self.address = address
+        expected, product = [], 1
+        for dimension in reversed(shape):
+            expected.insert(0, product)
+            product *= dimension
+        self._stride = strides or tuple(expected)
+        self.device = Device(device)
+
+    def is_contiguous(self):
+        expected, product = [], 1
+        for dimension in reversed(self.shape):
+            expected.insert(0, product)
+            product *= dimension
+        return self._stride == tuple(expected)
+
+    def __getitem__(self, key):
+        assert isinstance(key, slice) and key.start in (None, 0)
+        rows = self.shape[0] if key.stop is None else key.stop
+        return MetadataTensor((rows, *self.shape[1:]), self.dtype,
+                              self.address, device=self.device.value)
+
+    def unsqueeze(self, dimension):
+        assert dimension == 0
+        return MetadataTensor((1, *self.shape), self.dtype, self.address,
+                              device=self.device.value)
+
+    def view(self, *args):
+        if len(args) == 1 and isinstance(args[0], str):
+            dtype = args[0]
+            shape = self.shape
+            if dtype == "uint32":
+                shape = (*shape[:-1], shape[-1] // 4)
+            return MetadataTensor(shape, dtype, self.address, device=self.device.value)
+        return MetadataTensor(args, self.dtype, self.address, device=self.device.value)
+
+    def stride(self):
+        return self._stride
+
+    def numel(self):
+        result = 1
+        for dimension in self.shape:
+            result *= dimension
+        return result
+
+    def element_size(self):
+        return {"bf16": 2, "fp32": 4, "uint32": 4}.get(self.dtype, 1)
+
+    def untyped_storage(self):
+        return SimpleNamespace(data_ptr=self.data_ptr,
+                               nbytes=lambda: self.numel() * self.element_size())
+
+    def data_ptr(self):
+        return self.address
+
+
+class Device:
+    def __init__(self, value):
+        self.value = value
+        self.type = value.split(":")[0]
+
+    def __eq__(self, other):
+        return isinstance(other, Device) and self.value == other.value
+
+
+TORCH_METADATA = SimpleNamespace(
+    Tensor=MetadataTensor, bfloat16="bf16", float8_e4m3fn="e4m3",
+    uint8="u8", uint32="uint32", float32="fp32",
+)
