+                    "_MXFP8_CONFIGS": {} if state == "missing" else {key: config},
+                    "_mxfp8_config": lambda: object() if state == "drift" else config,
+                    "retain_cuda_graph_capture_resource": lambda value:
+                        events.append(("retain", value)),
+                    "current_workspace_manager": lambda: scratch,
+                    "_project": launch("project"), "_finalize": launch("finalize"),
+                }, {"_mhc_pre_impl", "_validate_mxfp8_outputs",
