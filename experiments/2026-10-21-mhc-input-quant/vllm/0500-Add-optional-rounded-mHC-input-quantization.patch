+def _q03_finalize_inputs(tokens):
+    """Isolate finalize with fixed finite norm partials, even for nonfinite C."""
+    splits = HIDDEN // BLOCK_H
+    generator = torch.Generator(device=DEVICE).manual_seed(3021 + tokens)
+    collapsed = torch.randn(
+        tokens, HIDDEN, generator=generator, device=DEVICE, dtype=torch.bfloat16
+    )
+    return (
+        torch.zeros(splits, tokens, 1, MIXES, device=DEVICE),
+        torch.ones(splits, tokens, 1, device=DEVICE),
+        collapsed,
+        torch.full((splits, tokens), 1.25 * HIDDEN / splits, device=DEVICE),
+        torch.ones(3, device=DEVICE),
+        torch.zeros(MIXES, device=DEVICE),
+        torch.linspace(0.5, 0.75, HIDDEN, device=DEVICE).bfloat16(),
+    )
+
+
+def _q03_finalize_outputs(tokens):
+    return (
+        torch.empty(tokens, 4, device=DEVICE),
+        torch.empty(tokens, 4, 4, device=DEVICE),
+        torch.empty(tokens, 4, device=DEVICE),
+        torch.empty(tokens, HIDDEN, device=DEVICE, dtype=torch.bfloat16),
+    )
+
+
+def _q03_sinks(tokens):
+    """Independent aligned allocations, with prefix and suffix write canaries."""
+    allocations, views = [], []
+    for width, dtype in ((HIDDEN, torch.float8_e4m3fn), (HIDDEN // 32, torch.uint8)):
+        storage = torch.full(
+            (256 + tokens * width + 256,), 0xA5, device=DEVICE, dtype=torch.uint8
+        )
+        views.append(storage[256:-256].view(dtype).view(tokens, width))
+        allocations.append(storage)
+    return tuple(views), tuple(allocations)
+
+
+def _q03_assert_canaries(allocations):
+    for storage in allocations:
+        assert torch.all(storage[:256] == 0xA5).item()
+        assert torch.all(storage[-256:] == 0xA5).item()
+
+
+def _q03_assert_bytes(actual, expected):
+    assert actual.shape == expected.shape
+    assert actual.dtype == expected.dtype
+    assert torch.equal(
+        actual.contiguous().view(torch.uint8),
+        expected.contiguous().view(torch.uint8),
+    )
+
+
+def _q03_assert_cast(y, q, sf):
+    """The patched CUDA cast, not a CPU codec, owns all bytes including NaNs."""
+    import tile_kernels
+
+    expected_q = torch.empty_like(q)
+    expected_sf = torch.empty_like(sf)
+    tile_kernels.quant.per_token_cast(
+        y,
+        "e4m3",
+        32,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(expected_q, expected_sf),
+    )
+    _q03_assert_bytes(q, expected_q)
+    _q03_assert_bytes(sf, expected_sf)
+    assert sf.view(torch.uint32).shape == (y.shape[0], HIDDEN // 128)
+
