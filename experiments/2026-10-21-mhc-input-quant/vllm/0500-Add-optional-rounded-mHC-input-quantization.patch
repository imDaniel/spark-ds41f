+def test_q03_finalize_alternating_graphs(q03_finalize_kernels):
+    """Finalize-only graphs share sinks; this is not model/owner-lifetime coverage."""
+    stock, dual = q03_finalize_kernels
+    capacity = 96
+    capacity_pair, allocations = _q03_sinks(capacity)
+    cases = {}
+    for tokens in (1, 16, 96):
+        inputs = _q03_finalize_inputs(tokens)
+        outputs = _q03_finalize_outputs(tokens)
+        pair = tuple(tensor[:tokens] for tensor in capacity_pair)
+        # Each graph has its own static row shape but uses the same sink bases.
+        # Compile and initialize before capture; retain every allocation here.
+        dual(*inputs, *outputs, *pair)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            dual(*inputs, *outputs, *pair)
+        cases[tokens] = inputs, outputs, pair, allocations, graph
+    for index, tokens in enumerate((96, 1, 16, 1, 96, 16)):
+        inputs, actual, (q, sf), allocations, graph = cases[tokens]
+        inputs[2].mul_(-0.5)
+        inputs[2][:, -1] = index + 1
+        for storage in allocations:
+            storage.fill_(0xA5)
+        graph.replay()
+        expected = _q03_finalize_outputs(tokens)
+        stock(*inputs, *expected)
+        for got, before in zip(actual, expected):
+            _q03_assert_bytes(got, before)
+        _q03_assert_cast(expected[-1], q, sf)
+        _q03_assert_canaries(allocations)
+        for tensor in capacity_pair:
+            assert torch.all(tensor[tokens:].view(torch.uint8) == 0xA5).item()
