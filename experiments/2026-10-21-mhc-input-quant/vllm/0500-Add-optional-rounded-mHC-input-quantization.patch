+# These are executable correctness gates for a separately authorized GPU window.
+# CPU parsing or module-level skips are not evidence that any Q03 kernel passed.
+@pytest.fixture(scope="module")
+def q03_sm121():
+    if not current_platform.is_device_capability(121):
+        pytest.skip("Q03 qualification requires SM121; a skip is not a pass")
