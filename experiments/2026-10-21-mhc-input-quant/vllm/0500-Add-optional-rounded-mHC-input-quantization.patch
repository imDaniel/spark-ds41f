+    post = torch.rand(tokens, 4, generator=generator, device=DEVICE)
+    comb = torch.softmax(
+        torch.randn(tokens, 4, 4, generator=generator, device=DEVICE), dim=-1
+    )
+    controls = {}
+    if steering != "off":
+        direction = F.normalize(
+            torch.randn(HIDDEN, generator=generator, device=DEVICE), dim=0
+        )
+        doses = torch.zeros(tokens, device=DEVICE)
