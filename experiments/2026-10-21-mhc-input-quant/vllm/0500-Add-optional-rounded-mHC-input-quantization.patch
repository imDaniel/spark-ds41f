+@pytest.mark.parametrize("tokens", [1, 6, 16, 96, 4096, 4097, 8192])
+def test_q03_finalize_exact_cuda_cast(q03_finalize_kernels, tokens):
+    """Both cast buckets and the 8192-row capacity preserve every live byte."""
+    stock, dual = q03_finalize_kernels
+    inputs = _q03_finalize_inputs(tokens)
+    # Distinct quartet/warp/iteration/tail edges expose misplaced stores.
+    columns = [0, 7, 8, 15, 16, 23, 24, 31, 32, 767, 768, 4607, 4608, 5119]
+    inputs[2][:, columns] = torch.arange(
+        1, len(columns) + 1, device=DEVICE, dtype=torch.bfloat16
+    )
+    expected, actual = _q03_finalize_outputs(tokens), _q03_finalize_outputs(tokens)
+    (q, sf), allocations = _q03_sinks(tokens)
+    stock(*inputs, *expected)
+    dual(*inputs, *actual, q, sf)
+    for got, before in zip(actual, expected):
+        _q03_assert_bytes(got, before)
+    _q03_assert_cast(expected[-1], q, sf)
+    _q03_assert_canaries(allocations)
+
+
+def test_q03_finalize_signed_zero_and_finite_boundaries(q03_finalize_kernels):
+    stock, dual = q03_finalize_kernels
+    inputs = _q03_finalize_inputs(6)
+    collapsed = inputs[2]
+    collapsed.zero_()
+    collapsed[:, 1:32:2] = -0.0
+    # BF16 min subnormal/min normal, FP8 ties, clamp/scale edges and max finite.
+    values = torch.tensor(
+        [
+            2**-133, 2**-126, 1e-4, 1.0625, 1.0626, 448.0, 449.0,
+            torch.finfo(torch.bfloat16).max,
+        ],
+        device=DEVICE,
+        dtype=torch.bfloat16,
+    )
+    for row in range(6):
+        collapsed[row, 32:40] = values if row % 2 == 0 else -values
+        collapsed[row, -8:] = values.roll(row)
+    expected, actual = _q03_finalize_outputs(6), _q03_finalize_outputs(6)
+    (q, sf), allocations = _q03_sinks(6)
+    stock(*inputs, *expected)
+    dual(*inputs, *actual, q, sf)
+    for got, before in zip(actual, expected):
+        _q03_assert_bytes(got, before)
+    assert torch.signbit(actual[-1][:, 1:32:2]).all().item()
+    _q03_assert_cast(expected[-1], q, sf)
+    _q03_assert_canaries(allocations)
+
+
+@pytest.mark.parametrize("value", [float("nan"), float("inf"), -float("inf")])
+def test_q03_finalize_nonfinite_cuda_oracle(q03_finalize_kernels, value):
+    """No xfail or tolerance: an unexplained nonfinite byte mismatch blocks Q03."""
+    stock, dual = q03_finalize_kernels
+    tokens = 36
+    inputs = _q03_finalize_inputs(tokens)
+    collapsed = inputs[2]
+    for position in range(32):
+        collapsed[position, position] = value
+    collapsed[32, :32] = value
+    collapsed[33, :32:2] = value
+    collapsed[34, -32:] = value
+    expected, actual = _q03_finalize_outputs(tokens), _q03_finalize_outputs(tokens)
+    (q, sf), allocations = _q03_sinks(tokens)
+    stock(*inputs, *expected)
+    dual(*inputs, *actual, q, sf)
+    assert torch.equal(torch.isnan(actual[-1]), torch.isnan(expected[-1]))
+    assert torch.equal(torch.isinf(actual[-1]), torch.isinf(expected[-1]))
+    for got, before in zip(actual, expected):
+        _q03_assert_bytes(got, before)
+    _q03_assert_cast(expected[-1], q, sf)
+    _q03_assert_canaries(allocations)
+
