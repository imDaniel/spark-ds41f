+@pytest.fixture(scope="module")
+def q03_finalize_kernels(q03_sm121):
+    from vllm.models.deepseek_v4_1.tilelang.mhc import _mxfp8_config, finalize
+
+    args = (
+        HIDDEN,
+        4 * HIDDEN,
+        CONFIG.rms_norm_eps,
+        CONFIG.hc_eps,
+        CONFIG.hc_sinkhorn_iters,
+        CONFIG.rms_norm_eps,
+    )
+    return (
+        finalize(*args),
+        finalize(*args, emit_mxfp8=True, quant_config=_mxfp8_config()),
+    )
+
