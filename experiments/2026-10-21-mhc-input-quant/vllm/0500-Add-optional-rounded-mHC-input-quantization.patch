+    (q, sf), allocations = _q03_sinks(tokens)
+    actual = q03_mhc.post_pre(*args, **controls, q_out=q, sf_out=sf)
+    assert len(actual) == len(expected) == 5
+    for got, before in zip(actual, expected):
+        _q03_assert_bytes(got, before)
