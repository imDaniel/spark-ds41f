+def test_q03_zero_rows_validate_without_launch(mhc, q03_sm121, monkeypatch):
+    from vllm.models.deepseek_v4_1.tilelang import mhc as module
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("zero-row mHC must not launch or acquire scratch")
+
+    candidate = TileKernelsMHC(CONFIG)
+    candidate.q03_enabled = True
+    candidate._q03_quant_config = module._mxfp8_config()
+    for name in ("_project", "_finalize", "current_workspace_manager"):
+        monkeypatch.setattr(module, name, forbidden)
+    residual, fn, scale, base, weight, incoming = _inputs(0, 8000)
+    x = torch.empty(0, HIDDEN, device=DEVICE, dtype=torch.bfloat16)
+    post = torch.empty(0, 4, device=DEVICE)
+    comb = torch.empty(0, 4, 4, device=DEVICE)
+    args = (x, residual, post, comb, fn, scale, base, weight, incoming)
+    (q, sf), allocations = _q03_sinks(0)
+    actual = candidate.post_pre(*args, q_out=q, sf_out=sf)
+    assert len(actual) == 5 and actual[3].shape == (0, HIDDEN)
+    with pytest.raises(ValueError, match="both q_out and sf_out"):
+        candidate.post_pre(*args, q_out=q)
+    with pytest.raises(ValueError, match="dtype, device, shape or stride"):
+        candidate.post_pre(*args, q_out=q, sf_out=sf.to(torch.float32))
+    _q03_assert_canaries(allocations)
