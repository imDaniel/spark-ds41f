+def _validate_mxfp8_config(config) -> None:
+    if (
+        config is None
+        or config.torch_dtype != torch.float8_e4m3fn
+        or config.sf_block != (1, 32)
+        or config.use_tma_aligned_col_major_sf
+        or not config.round_sf
+        or not config.use_packed_ue8m0
+        or config.use_e4m3_sf
+        or config.clamp_min_value is None
+        or not isfinite(config.clamp_min_value)
+        or config.clamp_min_value <= 0
+    ):
+        raise ValueError("Invalid MXFP8 mHC quantization config")
+
+
+def _mxfp8_config():
+    from tile_kernels.quant.common import get_cast_output_config
+
+    config = get_cast_output_config(
+        "e4m3", (1, 32), round_sf=True, use_packed_ue8m0=True
+    )
+    _validate_mxfp8_config(config)
+    return config
+
+
+def _validate_mxfp8_outputs(y, q_out, sf_out) -> None:
+    """Metadata-only checks, also safe for fake tensors."""
+    if q_out is None or sf_out is None:
+        raise ValueError("MXFP8 mHC requires both q_out and sf_out")
+    if (
+        y.ndim != 2
+        or y.shape[1] != 5120
+        or y.dtype != torch.bfloat16
+        or y.device.type != "cuda"
+        or y.stride() != (5120, 1)
+        or not y.is_contiguous()
+    ):
+        raise ValueError("MXFP8 mHC requires contiguous CUDA BF16 [M, 5120]")
+    for tensor, dtype, width in (
+        (q_out, torch.float8_e4m3fn, 5120),
+        (sf_out, torch.uint8, 160),
+    ):
+        if (
+            tensor.dtype != dtype
+            or tensor.device != y.device
+            or tensor.shape != (y.shape[0], width)
+            or tensor.stride() != (width, 1)
+            or not tensor.is_contiguous()
+        ):
+            raise ValueError("Invalid MXFP8 mHC output dtype, device, shape or stride")
+
+
+def _validate_mxfp8_storage(q_out, sf_out, *live) -> None:
+    """Real-op storage checks; never read activation values or fake pointers."""
+
+    def span(tensor):
+        if tensor is None or tensor.numel() == 0:
+            return None
+        start = tensor.data_ptr()
+        extent = 1 + sum(
+            (n - 1) * abs(s) for n, s in zip(tensor.shape, tensor.stride())
+        )
+        return start, start + extent * tensor.element_size()
+
+    if q_out.numel() and sf_out.numel() and (
+        q_out.untyped_storage().data_ptr() == sf_out.untyped_storage().data_ptr()
+    ):
+        raise ValueError("MXFP8 mHC outputs require independent allocations")
+    sinks = (q_out, sf_out)
+    for i, tensor in enumerate(sinks):
