@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Explicit routed-input contracts, scoped inside the opaque MoE operators."""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+
+import torch
+
+InputQuant = tuple[torch.Tensor, torch.Tensor]
+
+
+def validate_input_quant_metadata(x: torch.Tensor, pair: InputQuant) -> InputQuant:
+    """Validate metadata without reading tensor data or storage (also fake-safe)."""
+    if not isinstance(pair, tuple) or len(pair) != 2:
+        raise ValueError("routed input quantization requires a q/sf pair")
+    q, sf = pair
+    if not isinstance(q, torch.Tensor) or not isinstance(sf, torch.Tensor):
+        raise ValueError("both routed input quantization tensors are required")
+    if x.ndim != 2 or x.shape[1] != 5120 or x.dtype != torch.bfloat16:
+        raise ValueError("routed input requires BF16 [rows, 5120]")
+    if x.device.type != "cuda" or x.stride() != (5120, 1):
+        raise ValueError("routed input requires contiguous CUDA rows")
+    formats = ((q, torch.float8_e4m3fn, 5120), (sf, torch.uint8, 160))
+    for tensor, dtype, width in formats:
+        if (
+            tensor.dtype != dtype
+            or tensor.device != x.device
+            or tensor.shape != (x.shape[0], width)
+            or tensor.stride() != (width, 1)
+        ):
+            raise ValueError(
+                "invalid routed input quantization shape/dtype/device/stride"
+            )
+    return q, sf
+
+
+def _span(tensor: torch.Tensor) -> tuple[int, int]:
+    start = tensor.data_ptr()
+    return start, start + tensor.numel() * tensor.element_size()
+
+
+def validate_input_quant(
+    x: torch.Tensor, pair: InputQuant, *, check_storage: bool = True
+) -> InputQuant:
+    q, sf = validate_input_quant_metadata(x, pair)
+    if check_storage and x.numel():
+        if q.data_ptr() % 256 or sf.data_ptr() % 256:
+            raise ValueError("routed quantization allocations must be 256-byte aligned")
+        spans = [_span(tensor) for tensor in (x, q, sf)]
+        for i, (start, end) in enumerate(spans):
+            if any(
+                start < other_end and other_start < end
+                for other_start, other_end in spans[i + 1:]
+            ):
+                raise ValueError("routed input quantization overlaps a live tensor")
+    return q, sf
+
+
+def validate_input_quant_disjoint(pair: InputQuant, *tensors: torch.Tensor) -> None:
+    """Reject overlap with workspaces/outputs before any candidate launches."""
+    for quant in pair:
+        if not quant.numel():
+            continue
+        start, end = _span(quant)
+        for tensor in tensors:
+            storage = tensor.untyped_storage()
+            other_start = storage.data_ptr()
+            if start < other_start + storage.nbytes() and other_start < end:
+                raise ValueError(
+                    "routed quantization overlaps workspace/output storage"
+                )
+
+
+@dataclass
+class _RoutedInput:
+    consumer: object
+    source: torch.Tensor
+    pair: InputQuant
+    consumed: bool = False
+
+
+_routed_input: ContextVar[_RoutedInput | None] = ContextVar(
+    "dsv41_routed_input", default=None
+)
+
+
+@contextmanager
+def scoped_routed_input(consumer: object, source: torch.Tensor, pair: InputQuant):
+    """Enter only inside a real opaque op with explicit q and sf operands."""
+    if _routed_input.get() is not None:
+        raise RuntimeError("nested routed input quantization scope")
+    validate_input_quant(source, pair)
+    record = _RoutedInput(consumer, source, pair)
+    token = _routed_input.set(record)
+    try:
+        yield
+        if not record.consumed:
+            raise RuntimeError("routed input quantization was not consumed")
+    finally:
+        _routed_input.reset(token)
+
+
+def consume_routed_input(consumer: object, source: torch.Tensor) -> InputQuant | None:
+    record = _routed_input.get()
+    if record is None:
+        return None
+    if record.consumer is not consumer or record.source is not source:
+        raise RuntimeError("routed input quantization consumer/source mismatch")
+    if record.consumed:
+        raise RuntimeError("routed input quantization consumed more than once")
+    validate_input_quant(source, record.pair)
+    record.consumed = True
+    return record.pair
