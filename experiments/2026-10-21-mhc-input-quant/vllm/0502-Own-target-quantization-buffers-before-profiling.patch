+    def prepare_q03_input_arena(self) -> None:
+        """Reserve the target slot after loading, before profiling and capture."""
+        if not self.q03_enabled or not kernels.uses_tilelang():
+            return
+        if (
+            self.parallel_config.tensor_parallel_size != 4
+            or self.parallel_config.use_ubatching
+            or self.use_sequence_parallel
+        ):
+            return
+        if self.config.hidden_size != 5120 or self.hc_mult != 4:
+            return
+        layers = []
+        for layer in islice(self.layers, self.start_layer, self.end_layer):
+            eligible = getattr(layer.ffn.experts, "q03_input_quant_eligible", None)
+            if (
+                not layer.is_draft
+                and not layer.use_sequence_parallel
+                and layer.ffn_norm.weight.dtype == torch.bfloat16
+                and eligible is not None
+                and eligible()
+            ):
+                layers.append(layer)
+        if self.q03_input_arena is not None:
+            if tuple(layers) != self.q03_input_layers:
+                raise RuntimeError("Cannot change prepared Q03 target layer bindings")
+            if self.q03_input_arena.capacity != self.q03_capacity:
+                raise RuntimeError("Cannot resize a prepared Q03 input arena")
+        if not layers or self.q03_capacity <= 0:
+            return
+        from vllm.platforms import current_platform
+
+        from ..tilelang.input_quant_arena import RoutedInputQuantArena
+
+        device = layers[0].ffn_norm.weight.device
+        if any(layer.ffn_norm.weight.device != device for layer in layers):
+            raise ValueError("Q03 target layers must share one device")
+        if device.type != "cuda":
+            raise ValueError("Q03 input arena requires loaded CUDA weights")
+        # This candidate is scoped only to the four-rank SM121 target.
+        if not current_platform.is_device_capability(121, device_id=device.index):
+            return
+        arena = self.q03_input_arena
+        if arena is None:
+            arena = RoutedInputQuantArena(self.q03_capacity, device)
+            self.q03_input_arena = arena
+            self.q03_input_layers = tuple(layers)
+            logger.info(
+                "Q03 routed input arena: %d rows, %d bytes, one target slot",
+                arena.capacity,
+                sum(arena.storage_sizes(arena.capacity)),
+            )
+        elif arena.capacity != self.q03_capacity or arena.device != device:
+            raise RuntimeError("Cannot rebind a prepared Q03 input arena")
+        for layer in layers:
+            if layer.q03_input_arena not in (None, arena):
+                raise RuntimeError("Cannot replace a target layer's Q03 input arena")
+            layer.q03_input_arena = arena
+            layer.mhc.q03_enabled = True
+
     def prepare_disk_engram(
