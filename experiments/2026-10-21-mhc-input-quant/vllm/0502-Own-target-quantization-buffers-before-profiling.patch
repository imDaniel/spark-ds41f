+++ b/vllm/models/deepseek_v4_1/tilelang/input_quant_arena.py
@@ -0,0 +1,77 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Persistent, routed-only input storage shared by sequential target layers."""
+
+import torch
+
+
+class RoutedInputQuantLease:
+    def __init__(
+        self, owner: "RoutedInputQuantArena", q: torch.Tensor, sf: torch.Tensor
+    ) -> None:
+        self.owner = owner
+        self.q = q
+        self.sf = sf
+        self.slot = 0
+        self._released = False
+
+    def release(self) -> None:
+        if self._released:
+            raise RuntimeError("Q03 input lease was already released")
+        self._released = True
+        self.owner._busy = False
+
+
+class RoutedInputQuantArena:
+    """One fixed-capacity slot, never borrowed from transient workspace.
+
+    The target runtime already excludes DBO. Writers and routed readers must
+    remain ordered on its execution stream, including alternating graph replays.
+    Host lease exclusion is not synchronization for concurrent graph replays.
+    """
+
+    hidden_size = 5120
+    scale_columns = hidden_size // 32
+
+    def __init__(self, capacity: int, device: torch.device) -> None:
+        if capacity <= 0:
+            raise ValueError("Q03 input arena requires a positive capacity")
+        device = torch.device(device)
+        if device.type != "cuda":
+            raise ValueError("Q03 input arena requires loaded CUDA weights")
+        self.capacity = capacity
+        self.device = device
+        self._busy = False
+        q_bytes, sf_bytes = self.storage_sizes(capacity)
+        # Separate allocations avoid cross-operand mutation aliases in the op.
+        self.q_storage = torch.empty(q_bytes, dtype=torch.uint8, device=device)
+        self.sf_storage = torch.empty(sf_bytes, dtype=torch.uint8, device=device)
+        if self.q_storage.data_ptr() % 256 or self.sf_storage.data_ptr() % 256:
+            raise RuntimeError("Q03 input arena allocations must be 256-byte aligned")
+        self.q = (
+            self.q_storage[: capacity * self.hidden_size]
+            .view(torch.float8_e4m3fn)
+            .view(capacity, self.hidden_size)
+        )
+        self.sf = self.sf_storage[: capacity * self.scale_columns].view(
+            capacity, self.scale_columns
+        )
+
+    @classmethod
+    def storage_sizes(cls, capacity: int) -> tuple[int, int]:
+        if capacity < 0:
+            raise ValueError("Q03 input arena capacity cannot be negative")
+        q_bytes = (capacity * cls.hidden_size + 255) // 256 * 256
+        sf_bytes = (capacity * cls.scale_columns + 255) // 256 * 256
+        return q_bytes, sf_bytes
+
+    def borrow(self, rows: int, slot: int = 0) -> RoutedInputQuantLease:
+        if slot != 0:
+            raise ValueError("Q03 input arena has no reserved slot for this execution")
+        if rows <= 0 or rows > self.capacity:
+            raise ValueError("Q03 input rows exceed the prepared nonempty capacity")
+        if self._busy:
+            raise RuntimeError("Q03 input arena slot is already borrowed")
+        q, sf = self.q[:rows], self.sf[:rows]
+        self._busy = True
+        return RoutedInputQuantLease(self, q, sf)
