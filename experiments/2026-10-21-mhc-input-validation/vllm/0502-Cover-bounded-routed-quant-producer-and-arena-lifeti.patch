+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in real SM121 producer/plan and owner tests, not TP4 model qualification."""
+
+import gc
+import os
+import weakref
+from types import SimpleNamespace
+
+import pytest
+
+
+def _gpu_requested(environ):
+    return environ.get("VLLM_Q03_RUN_G2_GPU", "0") == "1"
+
+
+if not _gpu_requested(os.environ):
+    pytest.skip("G2 GPU execution requires explicit opt-in", allow_module_level=True)
+
+# Missing dependencies or wrong hardware after opt-in are errors, not skips.
+import torch  # noqa: E402
+
+from vllm.platforms import current_platform  # noqa: E402
+
+if not current_platform.is_cuda() or not current_platform.is_device_capability(121):
+    pytest.fail("G2 requires the authorized SM121 device", pytrace=False)
+
+from vllm.models.deepseek_v4_1.steering.ops import prepare_consumer  # noqa: E402
+from vllm.models.deepseek_v4_1.tilelang.input_quant_arena import (  # noqa: E402
+    RoutedInputQuantArena,
+)
+from vllm.models.deepseek_v4_1.tilelang.mhc import TileKernelsMHC  # noqa: E402
+from vllm.models.deepseek_v4_1.tilelang.moe import (  # noqa: E402
+    MoeExpertsV41Plan,
+    workspace_bytes,
+)
+from vllm.v1.worker.workspace import (  # noqa: E402
+    collect_cuda_graph_capture_resources,
+    init_workspace_manager,
+)
+
+pytestmark = pytest.mark.usefixtures("default_vllm_config")
+HIDDEN, INTERMEDIATE, EXPERTS, TOPK = 5120, 576, 8, 2
+CAPACITY, MAX_ROWS = 8192, 96
+# Packed source weights plus conservative prepared weights, activations, scratch,
+# arena and three small captured cases. This is NOT a measured JIT/driver peak.
+PAYLOAD_BUDGET = 512 * 1024**2
+MIN_FREE_BYTES = 2 * 1024**3
+CONFIG = SimpleNamespace(
+    hidden_size=HIDDEN, hc_mult=4, rms_norm_eps=1e-6,
+    hc_eps=1e-6, hc_sinkhorn_iters=20,
+)
+
+
+def _bytes_equal(actual, expected):
+    assert actual.shape == expected.shape and actual.dtype == expected.dtype
+    assert torch.equal(actual.contiguous().view(torch.uint8),
+                       expected.contiguous().view(torch.uint8))
+
+
+@pytest.fixture
+def kernels(default_vllm_config):
+    # Bound the fixture BEFORE constructing any expert/activation tensors.
+    raw_weights = EXPERTS * (
+        2 * INTERMEDIATE * HIDDEN // 2 + HIDDEN * INTERMEDIATE // 2
+    )
+    estimated_payload = 4 * raw_weights + 128 * 1024**2
+    assert (HIDDEN, INTERMEDIATE, EXPERTS, TOPK) == (5120, 576, 8, 2)
+    assert estimated_payload < PAYLOAD_BUDGET
+    free, _ = torch.cuda.mem_get_info()
+    if free < MIN_FREE_BYTES:
+        pytest.fail("G2 requires 2 GiB free before bounded fixture construction")
+    device = torch.device("cuda", torch.cuda.current_device())
+    init_workspace_manager(device)
+    mhc = TileKernelsMHC(CONFIG)
+    mhc.q03_enabled = True
+    mhc.steering_enabled = True
+    mhc.declare_kernels()
+    plan = MoeExpertsV41Plan(
+        EXPERTS, TOPK, HIDDEN, INTERMEDIATE,
+        swiglu_limit=10.0, out_dtype=torch.float32,
+    )
+    plan.declare_kernels()
+    generator = torch.Generator(device=device).manual_seed(4103)
+
+    def weight(n, k):
+        packed = torch.randint(
+            0, 256, (EXPERTS, n, k // 2), dtype=torch.uint8,
+            device=device, generator=generator,
+        )
+        scales = torch.full(
+            (EXPERTS, n, k // 32), 116, dtype=torch.uint8, device=device,
+        )
+        return packed, scales
+
+    weights = plan.prepare_weights(
+        *weight(2 * INTERMEDIATE, HIDDEN), *weight(HIDDEN, INTERMEDIATE)
+    )
+    return SimpleNamespace(mhc=mhc, plan=plan, weights=weights, device=device)
+
+
+def _case(kernels, rows, steering="off", owner=None):
+    assert 0 < rows <= MAX_ROWS
+    device = kernels.device
+    gen = torch.Generator(device=device).manual_seed(4200 + rows)
+
+    def random(*shape):
+        return torch.randn(*shape, device=device, generator=gen)
+
+    x = random(rows, HIDDEN).bfloat16()
+    residual = random(rows, 4, HIDDEN).bfloat16()
+    post = torch.sigmoid(random(rows, 4))
+    comb = torch.softmax(random(rows, 4, 4), dim=-1)
+    fn = random(24, 4 * HIDDEN) * 0.02
+    scale = torch.ones(3, device=device)
+    base = random(24) * 0.1
+    norm = (1 + random(HIDDEN) * 0.1).bfloat16()
+    pre = torch.softmax(random(rows, 4), dim=-1)
+    ids = (torch.arange(rows * TOPK, device=device) % EXPERTS).to(
+        torch.int32
+    ).view(rows, TOPK)
+    routing = torch.full((rows, TOPK), 0.5, device=device)
+    nbytes = workspace_bytes(kernels.plan.workspace_specs(rows, torch.int32))
+    assert nbytes < PAYLOAD_BUDGET // 4
+    direction = torch.nn.functional.normalize(random(HIDDEN), dim=0)
+    dose = torch.zeros(rows, device=device)
+    if steering == "active":
+        dose.copy_(torch.tensor([0., 2.5, 4.], device=device).repeat(
+            (rows + 2) // 3
+        )[:rows])
+        dose[-1] = 4.0
+    return SimpleNamespace(
+        args=(x, residual, post, comb, fn, scale, base, norm, pre),
+        ids=ids, routing=routing,
+        workspace=torch.empty(nbytes, device=device, dtype=torch.uint8),
+        out=torch.empty(rows, HIDDEN, device=device, dtype=torch.float32),
+        owner=owner if owner is not None else RoutedInputQuantArena(CAPACITY, device),
+        steering=steering, direction=direction, dose=dose,
+        dots=torch.empty(rows, 2, device=device), scratch=torch.empty_like(x),
+    )
+
+
+def _controls(case):
+    if case.steering == "off":
+        return {}
+    writer, controls = prepare_consumer(
+        case.args[0], case.direction, case.dose, case.dots, case.scratch, 2.5,
+    )
+    assert writer is case.args[0]
+    return controls
+
+
+def _run(kernels, case, *, dual, shared=None):
+    """Real post_pre and real plan; no fake kernel/consumer replacement."""
+    controls = _controls(case)
+    lease = case.owner.borrow(case.args[0].shape[0]) if dual else None
+    try:
+        sinks = {} if lease is None else {"q_out": lease.q, "sf_out": lease.sf}
+        outputs = kernels.mhc.post_pre(*case.args, **controls, **sinks)
+        pair = None if lease is None else (lease.q, lease.sf)
+        out = case.out if shared is None else torch.empty_like(outputs[3])
+        kernels.plan.run(
+            outputs[3], case.ids, case.routing, kernels.weights, out,
+            case.workspace, shared=shared, input_quant=pair,
+        )
+        return outputs, out
+    finally:
+        if lease is not None:
+            lease.release()
+
+
+def _snapshot(result):
+    mhc, out = result
+    return tuple(t.clone() for t in mhc), out.clone()
+
+
+def _equal_results(actual, expected):
+    for got, want in zip(actual[0], expected[0]):
+        _bytes_equal(got, want)
+    _bytes_equal(actual[1], expected[1])
+
+
+@pytest.mark.parametrize("rows", [1, 16, 96])
+@pytest.mark.parametrize("steering", ["off", "loaded_zero", "active"])
+def test_legal_producer_to_plan_matches_bf16_path(kernels, rows, steering, monkeypatch):
+    """Candidate BF16 versus dual; the separate G1 gate supplies original-188 proof."""
+    case = _case(kernels, rows, steering)
+    casts = []
+    original = kernels.plan.tk.quant.per_token_cast
+
+    def counted(*args, **kwargs):
+        casts.append(args[0].shape)
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(kernels.plan.tk.quant, "per_token_cast", counted)
+    baseline = _snapshot(_run(kernels, case, dual=False))
+    assert casts == [torch.Size((rows, HIDDEN))]
+    casts.clear()
+    actual = _run(kernels, case, dual=True)
+    assert casts == [], "explicit routed pair must eliminate exactly the input cast"
+    _equal_results(actual, baseline)
+    assert not case.owner._busy
+
+
+def test_shared_addend_wait_and_scratch_do_not_overwrite_quant_pair(kernels):
+    """Real plan deferred-addend boundary, not the production shared-expert runner."""
+    case = _case(kernels, 16, "active")
+    baseline_outputs, _ = _run(kernels, case, dual=False)
+    source = baseline_outputs[3].clone()
+    shared = source.bfloat16()
+    baseline = _snapshot(_run(kernels, case, dual=False, shared=shared))
+    side, ready = torch.cuda.Stream(), torch.cuda.Event()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        delayed = source.bfloat16().clone()
+        ready.record(side)
+    calls = []
+
+    def resolve():
+        calls.append(1)
+        ready.wait(torch.cuda.current_stream())
+        return delayed
+
+    actual = _run(kernels, case, dual=True, shared=resolve)
+    assert calls == [1]
+    _equal_results(actual, baseline)
+    # The original cast is an independent real oracle for the retained pair.
+    q, sf = kernels.plan.tk.quant.per_token_cast(
+        actual[0][3], "e4m3", 32, round_sf=True, use_packed_ue8m0=True,
+    )
+    _bytes_equal(case.owner.q[:16], q)
+    _bytes_equal(case.owner.sf[:16], sf.view(torch.uint8).reshape(16, -1)[:, :160])
+
+
+def test_owner_alternating_graphs_and_eager_reuse(kernels):
+    owner = RoutedInputQuantArena(CAPACITY, kernels.device)
+    pointers = owner.q_storage.data_ptr(), owner.sf_storage.data_ptr()
+    assert sum(owner.storage_sizes(CAPACITY)) == 43_253_760
+    cases, graphs, resources, outputs = {}, {}, {}, {}
+    for rows in (1, 16, 96):
+        case = cases[rows] = _case(kernels, rows, "active", owner)
+        _run(kernels, case, dual=True)
+        _run(kernels, case, dual=False)  # Warm baseline oracle before capture too.
+        torch.cuda.synchronize()
+        graph = graphs[rows] = torch.cuda.CUDAGraph()
+        with collect_cuda_graph_capture_resources() as retained:
+            with torch.cuda.graph(graph):
+                outputs[rows] = _run(kernels, case, dual=True)
+        resources[rows] = retained
+        assert any(isinstance(r, tuple) and len(r) == 2
+                   and r[0].data_ptr() == pointers[0]
+                   and r[1].data_ptr() == pointers[1] for r in retained)
+        assert not owner._busy
+    for index, rows in enumerate((96, 1, 16, 1, 96, 16)):
+        case = cases[rows]
+        case.args[0].mul_(-0.5)
+        case.args[0][:, -1] = index + 1
+        case.dose.fill_(0.0 if index % 2 else 4.0)
+        baseline = _snapshot(_run(kernels, case, dual=False))
+        owner.q_storage.fill_(0xA5)
+        owner.sf_storage.fill_(0xA5)
+        graphs[rows].replay()
+        _equal_results(outputs[rows], baseline)
+        assert torch.all(owner.q[rows:].view(torch.uint8) == 0xA5).item()
+        assert torch.all(owner.sf[rows:] == 0xA5).item()
+        _equal_results(_run(kernels, case, dual=True), baseline)
+        assert (owner.q_storage.data_ptr(), owner.sf_storage.data_ptr()) == pointers
+    torch.cuda.synchronize()
+
+
+def test_capture_retains_quant_allocations_after_owner_is_dropped(kernels):
+    case = _case(kernels, 6)
+    _run(kernels, case, dual=True)
+    baseline = _snapshot(_run(kernels, case, dual=False))
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    owner_ref = weakref.ref(case.owner)
+    with collect_cuda_graph_capture_resources() as resources:
+        with torch.cuda.graph(graph):
+            actual = _run(kernels, case, dual=True)
+    qptr = case.owner.q_storage.data_ptr()
+    assert any(isinstance(r, tuple) and len(r) == 2
+               and r[0].data_ptr() == qptr for r in resources)
+    case.owner = None
+    gc.collect()
+    assert owner_ref() is None
+    # Resources, not a Python lease/owner, retain the captured q/sf allocations.
+    for _ in range(3):
+        graph.replay()
+        _equal_results(actual, baseline)
+    torch.cuda.synchronize()
-- 
