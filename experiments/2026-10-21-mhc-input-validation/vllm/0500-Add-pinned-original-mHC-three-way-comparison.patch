+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Original-188 -> candidate-off -> dual finalize qualification on SM121.
+
+These tests execute CUDA only in an explicitly authorized validation window.
+A skipped/missing case is incomplete qualification, never a passing gate.
+The baseline is an offline pinned original function, not a full model import.
+"""
+
+import os
+
+import pytest
+
+if os.environ.get("VLLM_Q03_RUN_G1_GPU") != "1":
+    pytest.skip(
+        "G1 is opt-in; skipped qualification is incomplete", allow_module_level=True
+    )
+
+import torch  # noqa: E402
+
+from vllm.platforms import current_platform  # noqa: E402
+
+if not (current_platform.is_cuda() and current_platform.is_device_capability(121)):
+    raise RuntimeError("Opted-in G1 requires SM121; qualification incomplete")
+
+# After explicit opt-in, missing runtime dependencies are errors, not skips.
+import tile_kernels  # noqa: E402, F401
+import tilelang as real_tilelang  # noqa: E402, F401
+
+from tests.kernels import test_deepseek_v41_tilelang_mhc as common  # noqa: E402
+from tests.kernels.deepseek_v41_mhc_baseline import (  # noqa: E402
+    load_baseline_finalize,
+    validate_baseline_fixture,
+)
+from vllm.models.deepseek_v4_1.tilelang.mhc import (  # noqa: E402
+    _mxfp8_config,
+    finalize,
+    project_streams,
+)
+from vllm.tilelang_utils import T, tilelang  # noqa: E402
+
+
+@pytest.fixture(autouse=True)
+def baseline_receipt(record_property):
+    for key, value in validate_baseline_fixture().items():
+        record_property("original_188_" + key, str(value))
+
+
+@pytest.fixture(scope="module")
+def three_way_kernels():
+    original = load_baseline_finalize(T, tilelang)
+    assert original is not finalize
+    config = common.CONFIG
+    args = (
+        common.HIDDEN,
+        4 * common.HIDDEN,
+        config.rms_norm_eps,
+        config.hc_eps,
+        config.hc_sinkhorn_iters,
+        config.rms_norm_eps,
+    )
+    baseline = original(*args)
+    off = finalize(*args)
+    dual = finalize(*args, emit_mxfp8=True, quant_config=_mxfp8_config())
+    assert baseline is not off, "Original kernel must not reuse the candidate object"
+    return baseline, off, dual
+
+
+def _same_bytes(actual, expected, label):
+    try:
+        common._q03_assert_bytes(actual, expected)
+    except AssertionError as error:
+        raise AssertionError(label) from error
+
+
+def _compare_three_way(kernels, inputs):
+    """All three launches read identical objects; verify they remain unchanged."""
+    rows = inputs[2].shape[0]
+    immutable = tuple(tensor.clone() for tensor in inputs)
+    baseline_out = common._q03_finalize_outputs(rows)
+    off_out = common._q03_finalize_outputs(rows)
+    dual_out = common._q03_finalize_outputs(rows)
+    (q, sf), allocations = common._q03_sinks(rows)
+    for label, kernel, outputs, extra in (
+        ("original188", kernels[0], baseline_out, ()),
+        ("candidate_off", kernels[1], off_out, ()),
+        ("candidate_dual", kernels[2], dual_out, (q, sf)),
+    ):
+        kernel(*inputs, *outputs, *extra)
+        for index, (value, before) in enumerate(zip(inputs, immutable)):
+            _same_bytes(value, before, f"{label} mutated input {index}")
+    for name, before, off, dual in zip(
+        ("post", "comb", "pre", "y"), baseline_out, off_out, dual_out
+    ):
+        _same_bytes(off, before, f"Original188 -> candidate-off {name} mismatch")
+        _same_bytes(dual, before, f"Original188 -> candidate-dual {name} mismatch")
+    # Compare to the real patched cast of ORIGINAL output, not candidate y.
+    common._q03_assert_cast(baseline_out[-1], q, sf)
+    common._q03_assert_canaries(allocations)
