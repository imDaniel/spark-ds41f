+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Offline, hash-pinned original mHC finalize; not a full serving-module import."""
+
+import ast
+import hashlib
+import json
+import sys
+from pathlib import Path
+from types import ModuleType
+
+BASELINE_HEAD = "ebb44766d6f04d3a9272b712778d7f2fa2cec1fd"
+BASELINE_TREE = "ac79557915e3ee2778f8f6353a3d35f848f564e4"
+BASELINE_BLOB = "d238757bb886e5df208dcffbea6abda9332f4749"
+BASELINE_SHA256 = "19e3f85d32ec917dc62839e564f494cfb44d1ebbb6d42008e2d213a1b789f23b"
+BASELINE_PATH = "vllm/models/deepseek_v4_1/tilelang/mhc.py"
+_CONSTANTS = ("MULT", "MIXES", "BLOCK_H", "BLOCK_M", "VEC", "_PASS_CONFIGS")
+_FIXTURE = Path(__file__).parent / "fixtures" / "mhc_188"
+
+
+def _verified_source(directory: Path | None = None):
+    directory = _FIXTURE if directory is None else Path(directory)
+    source_path = directory / "mhc.py.txt"
+    data = source_path.read_bytes()
+    digest = hashlib.sha256(data).hexdigest()
+    if digest != BASELINE_SHA256:
+        raise ValueError("Original mHC source SHA256 mismatch")
+    # SHA1 here is Git object identity, not an authentication mechanism.
+    blob = hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest()
+    if blob != BASELINE_BLOB:
+        raise ValueError("Original mHC Git blob mismatch")
+    provenance = json.loads((directory / "provenance.json").read_text())
+    expected = {
+        "schema_version": 1,
+        "patch_head": BASELINE_HEAD,
+        "tree": BASELINE_TREE,
+        "source_path": BASELINE_PATH,
+        "source_blob": BASELINE_BLOB,
+        "source_sha256": BASELINE_SHA256,
+        "selected_constants": list(_CONSTANTS),
+        "selected_function": "finalize",
+        "scope": "Exact original decorated finalize and constants; not full module",
+    }
+    if provenance != expected:
+        raise ValueError("Original mHC provenance manifest mismatch")
+    return source_path, data.decode("utf-8"), provenance
+
+
+def _selected_nodes(source: str):
+    parsed = ast.parse(source)
+    nodes = []
+    selected = []
+    for node in parsed.body:
+        if (
+            isinstance(node, ast.Assign)
+            and len(node.targets) == 1
+            and isinstance(node.targets[0], ast.Name)
+            and node.targets[0].id in _CONSTANTS
+        ):
+            nodes.append(node)
+            selected.append(node.targets[0].id)
+        elif isinstance(node, ast.FunctionDef) and node.name == "finalize":
+            nodes.append(node)
+            selected.append(node.name)
+    if selected != [*_CONSTANTS, "finalize"]:
+        raise ValueError("Original mHC selected definition inventory mismatch")
+    return nodes
+
+
+def validate_baseline_fixture(directory: Path | None = None) -> dict:
+    """Check bytes, Git identity, manifest and AST inventory without any runtime."""
+    _, source, provenance = _verified_source(directory)
+    _selected_nodes(source)
+    return provenance
+
+
+def load_baseline_finalize(T, tilelang):
+    """Compile original AST definitions with real TileLang supplied by GPU tests.
+
+    No decorator, constant, function body or line number is rewritten. Keeping
+    the original file and locations lets TileLang inspect the original source.
+    The original factory does not call any candidate implementation.
+    """
+    source_path, source, _ = _verified_source()
+    nodes = _selected_nodes(source)
+    module = ModuleType("tests.kernels._original_188_mhc_finalize")
+    # Retain each independent factory namespace for inspect.getmodule and JIT
+    # source parsing. Do not overwrite an earlier live factory's module.
+    module.__name__ += f"_{id(module):x}"
+    module.__file__ = str(source_path)
+    module.__dict__.update(T=T, tilelang=tilelang)
+    sys.modules[module.__name__] = module
+    try:
+        exec(
+            compile(ast.Module(body=nodes, type_ignores=[]), str(source_path), "exec"),
+            module.__dict__,
+        )
+    except BaseException:
+        del sys.modules[module.__name__]
+        raise
+    return module.finalize
