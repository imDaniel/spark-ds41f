+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Check existing Q03 JUnit evidence. Never collects or executes GPU tests.
+
+The expected collection and its SHA256 must be frozen independently before the
+run (for example in the deployment experiment), not inferred from its results.
+Source-tree equality checks the supplied identity, not the execution machine.
+"""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+
+class EvidenceError(ValueError):
+    pass
+
+
+def require(condition, message):
+    if not condition:
+        raise EvidenceError(message)
+
+
+def junit_identity(nodeid):
+    """Map pytest file/class/function IDs to pytest's JUnit classname/name."""
+    prefix, bracket, parameters = nodeid.partition("[")
+    parts = prefix.split("::")
+    parts[-1] += bracket + parameters
+    path = parts[0]
+    require(len(parts) >= 2 and path.endswith(".py"), "invalid pytest node ID")
+    require(not path.startswith("/") and ".." not in path.split("/"),
+            "node ID must be repository relative")
+    require(all(parts) and "\\" not in path, "invalid pytest node ID")
+    classname = path[:-3].replace("/", ".")
+    if len(parts) > 2:
+        classname += "." + ".".join(parts[1:-1])
+    return classname, parts[-1]
+
+
+def check_evidence(
+    stage, expected_bytes, expected_sha256, source_tree, xml_bytes, exit_code
+):
+    require(type(exit_code) is int and exit_code == 0, "pytest process did not exit 0")
+    require(stage in ("G1", "G2"), "unsupported Q03 stage")
+    require(re.fullmatch(r"[0-9a-f]{40}", source_tree) is not None,
+            "invalid frozen source tree")
+    digest = hashlib.sha256(expected_bytes).hexdigest()
+    require(digest == expected_sha256, "expected collection SHA256 mismatch")
+    expected = json.loads(expected_bytes)
+    require(isinstance(expected, dict), "expected manifest must be an object")
+    require(expected.get("schema_version") == 1, "unsupported expected schema")
+    require(expected.get("stage") == stage, "expected collection stage mismatch")
+    require(expected.get("source_tree") == source_tree, "source tree mismatch")
+    nodeids = expected.get("nodeids")
+    require(isinstance(nodeids, list) and nodeids, "empty expected collection")
+    require(all(isinstance(n, str) for n in nodeids), "invalid expected node ID")
+    require(len(set(nodeids)) == len(nodeids), "duplicate expected node ID")
+    identities = [junit_identity(n) for n in nodeids]
+    require(len(set(identities)) == len(identities), "ambiguous JUnit identities")
+    root = ET.fromstring(xml_bytes)
+    require(root.tag in ("testsuite", "testsuites"), "invalid JUnit root")
+    cases = list(root.iter("testcase"))
+    require(cases, "zero executed cases")
+    for tag in ("failure", "error", "skipped"):
+        require(not list(root.iter(tag)), f"JUnit contains {tag}")
+    suites = list(root.iter("testsuite"))
+    if root.tag == "testsuites":
+        suites.append(root)
+    for suite in suites:
+        suite_cases = list(suite.iter("testcase"))
+        if "tests" in suite.attrib:
+            require(int(suite.attrib["tests"]) == len(suite_cases),
+                    "JUnit test total differs from case inventory")
+        for key in ("failures", "errors", "skipped"):
+            require(int(suite.attrib.get(key, "0")) == 0,
+                    f"JUnit suite reports {key}")
+    for case in cases:
+        require(case.attrib.get("status") in (None, "run", "passed"),
+                "JUnit testcase was not run successfully")
+        require(all(child.tag in ("properties", "system-out", "system-err")
+                    for child in case), "unexpected JUnit testcase outcome")
+    actual = [(c.attrib.get("classname"), c.attrib.get("name")) for c in cases]
+    require(len(set(actual)) == len(actual), "duplicate JUnit case identity")
+    require(set(actual) == set(identities), "JUnit collection identity mismatch")
+    return {
+        "schema_version": 1, "stage": stage, "result": "passed",
+        "source_tree": source_tree, "expected_sha256": digest,
+        "junit_sha256": hashlib.sha256(xml_bytes).hexdigest(),
+        "passed": len(cases), "failed": 0, "errors": 0, "skipped": 0,
+        "pytest_exit_code": exit_code,
+        "nodeids": nodeids,
+        "scope": "Existing evidence accounting only; no runtime execution",
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--stage", required=True, choices=("G1", "G2"))
+    parser.add_argument("--expected", type=Path, required=True)
+    parser.add_argument("--expected-sha256", required=True)
+    parser.add_argument("--source-tree", required=True)
+    parser.add_argument("--junit", type=Path, required=True)
+    parser.add_argument("--exit-code", type=int, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.output.exists():
+        parser.error("output must be a new file; existing evidence is never replaced")
+    try:
+        report = check_evidence(
+            args.stage, args.expected.read_bytes(), args.expected_sha256,
+            args.source_tree, args.junit.read_bytes(), args.exit_code,
+        )
+    except (ValueError, TypeError, OSError, ET.ParseError) as exc:
+        report = {"schema_version": 1, "stage": args.stage, "result": "failed",
+                  "reason": str(exc), "scope": "Evidence accounting only"}
+    try:
+        with args.output.open("x") as output:
+            output.write(json.dumps(report, indent=2) + "\n")
+    except OSError as exc:
+        print(f"cannot create new receipt: {exc}", file=sys.stderr)
+        return 2
+    print(json.dumps(report, sort_keys=True))
+    return 0 if report["result"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
