+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from types import SimpleNamespace
+
+import pytest
+
+from tests.models.steering_test_support import valid_profile
+
+# The helper installs this isolated package before its contracts are imported.
+# isort: off
+from ds41_steering_test.cache import steering_cache_salt
+from ds41_steering_test.config import admit
+from ds41_steering_test.request import STOCK, parse_selection
+# isort: on
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        None,
+        True,
+        False,
+        "0.5",
+        float("nan"),
+        float("inf"),
+        -1e-100,
+        1.00000000001,
+        10**500,
+    ],
+)
+def test_scale_rejects_before_float32_rounding(tmp_path, value):
+    with pytest.raises(ValueError):
+        parse_selection(
+            {"steering_profile": "test-profile", "steering_scale": value},
+            valid_profile(tmp_path),
+        )
+
+
+def test_named_default_zero_and_unknown(tmp_path):
+    p = valid_profile(tmp_path)
+    assert parse_selection(None, p) == STOCK
+    assert parse_selection({"steering_profile": p.profile_id}, p).scale == 1
+    for scale in [0, -0.0, 1e-100]:
+        assert (
+            parse_selection(
+                {"steering_profile": p.profile_id, "steering_scale": scale}, p
+            )
+            == STOCK
+        )
+    assert parse_selection({"steering_scale": 0}, None) == STOCK
+    for args in [
+        {"steering_scale": 0.1},
+        {"steering_profile": "bad", "steering_scale": 0},
+        {"steering_profile": None, "steering_scale": 0},
+    ]:
+        with pytest.raises(ValueError):
+            parse_selection(args, p)
+    with pytest.raises(ValueError):
+        parse_selection({"steering_profile": p.profile_id, "steering_scale": 0}, None)
+
+
+def test_cache_identity_and_admission_do_not_mutate_caller(tmp_path):
+    p = valid_profile(tmp_path)
+    args = {"steering_profile": p.profile_id, "steering_scale": 0.5, "other": 7}
+    clone = SimpleNamespace(extra_args=args)
+    salt = admit(clone, p, "caller")
+    assert args == {"steering_profile": p.profile_id, "steering_scale": 0.5, "other": 7}
+    assert clone.extra_args is not args
+    assert salt != "caller"
+    a = parse_selection(args, p)
+    b = parse_selection({**args, "steering_scale": 0.50000000000001}, p)
+    assert a == b and steering_cache_salt("caller", a) == steering_cache_salt(
+        "caller", b
+    )
+    assert len({steering_cache_salt(x, a) for x in [None, "", "caller", "other"]}) == 4
+    assert steering_cache_salt(None, STOCK) is None
+    assert steering_cache_salt("caller", STOCK) == "caller"
+    c = parse_selection({**args, "steering_scale": 0.75}, p)
+    assert steering_cache_salt("caller", c) != salt
+    for kw in [{"resumable": True}, {"session_id": "existing"}]:
+        with pytest.raises(ValueError):
+            admit(clone, p, "caller", **kw)
+    # Ordinary streamed HTTP responses do not set resumable/session_id.
+    assert admit(clone, p, "caller", resumable=False) == salt
diff --git a/vllm/models/deepseek_v4_1/steering/cache.py b/vllm/models/deepseek_v4_1/steering/cache.py
new file mode 100644
index 000000000..796934d7c
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/steering/cache.py
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A content-addressed namespace in the existing request cache-salt field."""
+
+import hashlib
+import struct
+
+from .request import SteeringSelection
+
+
+def steering_cache_salt(
+    original: str | None, selection: SteeringSelection
+) -> str | None:
+    if not selection.active:
+        return original
+    if original is not None and not isinstance(original, str):
+        raise ValueError("cache_salt must be a string or absent")
+    salt = b"" if original is None else original.encode("utf-8")
+    identity = bytes.fromhex(selection.profile_identity)
+    payload = (
+        b"DS41-STEERING-CACHE\x00\x01"
+        + identity
+        + struct.pack("!I", selection.scale_bits)
+        + bytes([original is not None])
+        + struct.pack("!Q", len(salt))
+        + salt
+    )
+    return "ds41-steering-v1:" + hashlib.sha256(payload).hexdigest()
