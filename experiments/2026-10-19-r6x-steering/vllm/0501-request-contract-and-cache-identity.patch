+++ b/vllm/models/deepseek_v4_1/steering/request.py
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Pure CPU request contract, independent of CUDA and model imports."""
+
+from __future__ import annotations
+
+import math
+import struct
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from .profile import SteeringProfile
+
+
+@dataclass(frozen=True)
+class SteeringSelection:
+    profile_identity: str | None = None
+    scale_bits: int = 0
+
+    @property
+    def scale(self) -> float:
+        return struct.unpack("!f", struct.pack("!I", self.scale_bits))[0]
+
+    @property
+    def active(self) -> bool:
+        return self.scale_bits != 0
+
+
+STOCK = SteeringSelection()
+
+
+def parse_selection(
+    extra_args: dict[str, Any] | None, profile: SteeringProfile | None
+) -> SteeringSelection:
+    args = extra_args or {}
+    named, scaled = "steering_profile" in args, "steering_scale" in args
+    if not named and not scaled:
+        return STOCK
+    if named:
+        name = args["steering_profile"]
+        if not isinstance(name, str) or profile is None or name != profile.profile_id:
+            raise ValueError("steering_profile must name the profile loaded at startup")
+    value = args["steering_scale"] if scaled else 1
+    if type(value) not in (int, float):
+        raise ValueError("steering_scale must be a finite number in [0, 1]")
+    # Validate before rounding: an out-of-range double must not round into range.
+    if not 0 <= value <= 1 or not math.isfinite(value):
+        raise ValueError("steering_scale must be a finite number in [0, 1]")
+    if not named and value != 0:
+        raise ValueError("A nonzero steering_scale requires steering_profile")
+    bits = struct.unpack("!I", struct.pack("!f", float(value)))[0] & 0x7FFFFFFF
+    if bits == 0:
+        return STOCK
+    assert profile is not None
+    return SteeringSelection(profile.identity, bits)
