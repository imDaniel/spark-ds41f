+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Validate the opt-in startup contract before admission or graph preparation."""
+
+import os
+
+from .profile import OPERATOR_VERSION, load_profile, model_identity, template_identity
+
+OFFICIAL_1017_REVISION = "1bae0e1088993b9b82de08f59de5be5a34e42170"
+
+
+def load_configured_profile(vllm_config):
+    additional = vllm_config.additional_config or {}
+    if "ds41_steering" not in additional:
+        return None
+    config = additional["ds41_steering"]
+    keys = {"schema_version", "operator_version", "profile_path", "profile_sha256"}
+    if (
+        not isinstance(config, dict)
+        or set(config) != keys
+        or type(config["schema_version"]) is not int
+        or config["schema_version"] != 1
+        or config["operator_version"] != OPERATOR_VERSION
+        or not isinstance(config["profile_path"], str)
+    ):
+        raise ValueError("Invalid additional_config.ds41_steering")
+    parallel = vllm_config.parallel_config
+    if (
+        parallel.tensor_parallel_size != 4
+        or parallel.pipeline_parallel_size != 1
+        or parallel.data_parallel_size != 1
+        or parallel.decode_context_parallel_size != 1
+        or getattr(parallel, "prefill_context_parallel_size", 1) != 1
+        or parallel.use_ubatching
+        or vllm_config.lora_config is not None
+        or vllm_config.kv_transfer_config is not None
+        or vllm_config.use_request_boundary_checkpoints
+    ):
+        raise ValueError(
+            "Steering requires TP4 without PP/DP/DBO/LoRA/KV connectors "
+            "or boundary checkpoints"
+        )
+    cache = vllm_config.cache_config
+    offload = vllm_config.offload_config
+    if offload.uva.cpu_offload_gb or offload.prefetch.offload_group_size:
+        raise ValueError("Steering weight offload is not qualified")
+    if getattr(cache, "kv_offloading_size", None) or getattr(
+        cache, "enable_kv_cache_transfer", False
+    ):
+        raise ValueError("Steering KV offload/transfer is not qualified")
+    if (
+        os.environ.get("VLLM_USE_V2_MODEL_RUNNER") != "1"
+        or os.environ.get("VLLM_DS41_KERNEL_BACKEND") != "tilelang"
+    ):
+        raise ValueError("Steering requires the V2 model runner and TileLang backend")
+    model = vllm_config.model_config
+    hf = model.hf_config
+    if (
+        getattr(hf, "model_type", None) != "deepseek_v41"
+        or hf.hidden_size != 5120
+        or hf.num_hidden_layers != 40
+        or model.tokenizer_mode != "deepseek_v41"
+    ):
+        raise ValueError(
+            "Steering requires DeepSeek V4.1 Flash 1017 with its native tokenizer"
+        )
+    profile = load_profile(
+        config["profile_path"],
+        config["profile_sha256"],
+        expected_model_identity=model_identity(model.model),
+        expected_template_identity=template_identity(model.model),
+    )
+    if (
+        profile.model_revision != OFFICIAL_1017_REVISION
+        or profile.hidden_size != hf.hidden_size
+        or profile.num_hidden_layers != hf.num_hidden_layers
+    ):
+        raise ValueError("Steering profile and model revision/geometry do not match")
+    return profile
+
+
+def admit(sampling_params, profile, original_salt, *, resumable=False, session_id=None):
+    from .cache import steering_cache_salt
+    from .request import parse_selection
+
+    selection = parse_selection(sampling_params.extra_args, profile)
+    if selection.active and (resumable or session_id is not None):
+        raise ValueError(
+            "Steering identity changes require a new request; "
+            "resumable sessions are not qualified"
+        )
+    if sampling_params.extra_args and (
+        "steering_profile" in sampling_params.extra_args
+        or "steering_scale" in sampling_params.extra_args
+    ):
+        extra = dict(sampling_params.extra_args)
+        if "steering_profile" in extra or "steering_scale" in extra:
+            extra["steering_scale"] = selection.scale
+        sampling_params.extra_args = extra
+    return steering_cache_salt(original_salt, selection)
