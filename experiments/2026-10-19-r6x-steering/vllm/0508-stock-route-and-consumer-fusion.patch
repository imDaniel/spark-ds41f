diff --git a/vllm/v1/worker/gpu/model_input_variant.py b/vllm/v1/worker/gpu/model_input_variant.py
new file mode 100644
index 000000000..799f2409e
--- /dev/null
+++ b/vllm/v1/worker/gpu/model_input_variant.py
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU-only helpers for model optional-input CUDA graph topologies."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import replace
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .cudagraph_utils import BatchExecutionDescriptor
+
+
+def expand_capture_variants(
+    descs: Sequence[BatchExecutionDescriptor], variants: tuple[int, ...]
+) -> list[BatchExecutionDescriptor]:
+    if not variants or variants[0] != 0 or len(set(variants)) != len(variants):
+        raise ValueError("Model input variants must be unique, starting with stock (0)")
+    return [replace(desc, model_input_variant=v) for desc in descs for v in variants]
+
+
+def select_input_variant(
+    desc: BatchExecutionDescriptor, variant: int
+) -> BatchExecutionDescriptor:
+    if variant == desc.model_input_variant:
+        return desc
+    # Piecewise caches also key off optional arguments. Until their wrappers
+    # support this dimension, non-stock inputs run eager, never a stock graph.
+    mode = type(desc.cg_mode)
+    return replace(
+        desc,
+        model_input_variant=variant,
+        cg_mode=mode.NONE
+        if variant and desc.cg_mode == mode.PIECEWISE
+        else desc.cg_mode,
+    )
+
+
+def sample_capture_variants(
+    descs: Sequence[BatchExecutionDescriptor], count: int
+) -> list[BatchExecutionDescriptor]:
+    groups: dict[int, list[BatchExecutionDescriptor]] = {}
+    for desc in descs:
+        groups.setdefault(desc.model_input_variant, []).append(desc)
+    sampled: list[BatchExecutionDescriptor] = []
+    for group in groups.values():
+        sampled.extend(
+            group if len(group) <= count else [*group[: count - 1], group[-1]]
+        )
+    return sampled
