+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Projection update inside the existing mHC register fold.
+
+The dot producer and consumer use the same rank-order FP32 sum -> BF16 writer
+boundary. Explicit IEEE FP32 operations preserve the compensated writer math
+without changing the enclosing mHC kernel's compiler settings.
+"""
+
+from vllm.tilelang_utils import T
+
+
+@T.macro
+def project_columns(xv, direction, scales, dots, alpha, src, col, columns):
+    # This branch precedes every direction/dot load. Zero rows keep xv's bits,
+    # including signed zero and nonfinite stock values.
+    if scales[src] != 0.0 and alpha != 0.0:
+        dose = scales[src]
+        hi = dots[src, 0]
+        lo = dots[src, 1]
+        factor = T.ieee_mul(dose, alpha)
+        factor_lo = T.ieee_fmaf(dose, alpha, -factor)
+        for v in T.unroll(columns):
+            value = T.Cast(T.float32, xv[v])
+            d = direction[col + v]
+            if T.abs(hi) < T.float32(float("inf")):
+                coefficient = T.ieee_mul(factor, d)
+                coefficient_lo = T.ieee_add(
+                    T.ieee_fmaf(factor, d, -coefficient), T.ieee_mul(factor_lo, d)
+                )
+                correction = T.ieee_add(
+                    T.ieee_add(
+                        T.ieee_mul(coefficient, lo), T.ieee_mul(coefficient_lo, hi)
+                    ),
+                    T.ieee_mul(coefficient_lo, lo),
+                )
+                value = T.ieee_sub(T.ieee_fmaf(-coefficient, hi, value), correction)
+            else:
+                value = T.ieee_sub(value, T.ieee_mul(T.ieee_mul(factor, d), hi))
+            xv[v] = T.Cast(T.bfloat16, value)
