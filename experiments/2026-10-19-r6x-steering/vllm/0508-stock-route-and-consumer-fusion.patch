+def register_projection_warmups(hidden, worlds=(1, 4)):
+    for world in worlds:
         for scales_aligned in (True, False):
             _launcher.register_warmup(
                 hidden=hidden, world=world, scales_aligned=scales_aligned
@@ -177,3 +177,133 @@ def apply_projection(writer, direction, scales, scratch, alpha):
         return output
     project_writer(writer, direction, scales, alpha)
     return writer
+
+
+@triton.jit(do_not_specialize=["part_stride"])
+def _dot_kernel(
+    source,
+    direction,
+    scales,
+    dots,
+    part_stride,
+    HIDDEN: tl.constexpr,
+    WORLD: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    # Inactive rows do not read the writer, direction or dot workspace. The
+    # consumer takes the same branch before reading either component.
+    if tl.load(scales + row) != 0.0:
+        h = tl.arange(0, BLOCK)
+        value = tl.load(source + row * HIDDEN + h, h < HIDDEN, other=0).to(tl.float32)
+        for rank in tl.static_range(1, WORLD):
+            value = value + tl.load(
+                source + rank * part_stride + row * HIDDEN + h, h < HIDDEN, other=0
+            ).to(tl.float32)
+        value = value.to(tl.bfloat16).to(tl.float32)
+        d = tl.load(direction + h, h < HIDDEN, other=0).to(tl.float32)
+        product = value * d
+        residual = tl.fma(value, d, -product)
+        residual = tl.where(tl.abs(product) < float("inf"), residual, 0.0)
+        hi, lo = tl.reduce((product, residual), axis=0, combine_fn=_sum_pair)
+        tl.store(dots + row * 2, hi)
+        tl.store(dots + row * 2 + 1, lo)
+
+
+def _dot_warmup_inputs(*, hidden, world, scales_aligned):
+    return triton_warmup_inputs(
+        _dot_kernel,
+        TritonWarmupTensor(torch.bfloat16),
+        TritonWarmupTensor(torch.float32),
+        TritonWarmupTensor(torch.float32, aligned=scales_aligned),
+        TritonWarmupTensor(torch.float32),
+        128 * hidden if world != 1 else 0,
+        HIDDEN=hidden,
+        WORLD=world,
+        BLOCK=triton.next_power_of_2(hidden),
+        grid=(128,),
+        num_warps=8,
+        enable_fp_fusion=False,
+    )
+
+
+_dot_launcher = triton_kernel_dispatcher_with_warmup(warmup_inputs=_dot_warmup_inputs)(
+    _dot_kernel
+)
+
+
+def register_dot_warmups(hidden):
+    for world in (1,):
+        for aligned in (True, False):
+            _dot_launcher.register_warmup(
+                hidden=hidden, world=world, scales_aligned=aligned
+            )
+
+
+@torch.library.custom_op("ds41_steering::projection_dot", mutates_args=("dots",))
+def projection_dot(
+    source: torch.Tensor,
+    direction: torch.Tensor,
+    scales: torch.Tensor,
+    dots: torch.Tensor,
+) -> None:
+    world, rows, hidden = source.shape
+    if (
+        world not in (1, 4)
+        or source.dtype != torch.bfloat16
+        or direction.dtype != torch.float32
+        or scales.dtype != torch.float32
+        or dots.dtype != torch.float32
+        or direction.shape != (hidden,)
+        or scales.shape != (rows,)
+        or dots.shape != (rows, 2)
+        or any(not t.is_contiguous() for t in (source, direction, scales, dots))
+        or any(t.device != source.device for t in (direction, scales, dots))
+    ):
+        raise ValueError("Invalid steering dot tensor geometry/dtype/layout/device")
+    if rows:
+        _dot_launcher[(rows,)](
+            source,
+            direction,
+            scales,
+            dots,
+            source.stride(0) if world != 1 else 0,
+            HIDDEN=hidden,
+            WORLD=world,
+            BLOCK=triton.next_power_of_2(hidden),
+            num_warps=8,
+            enable_fp_fusion=False,
+        )
+
+
+@projection_dot.register_fake
+def _projection_dot_fake(source, direction, scales, dots):
+    return None
+
+
+def projection_dots(writer, direction, scales, dots):
+    if scales is None or dots is None:
+        raise ValueError("Active steering requires explicit row controls")
+    from vllm.models.deepseek_v4_1.tilelang.collectives import RankOrderParts
+
+    source = (
+        writer.packed if isinstance(writer, RankOrderParts) else writer.unsqueeze(0)
+    )
+    output = dots[: source.shape[1]]
+    projection_dot(source, direction, scales, output)
+    return output
+
+
+def prepare_consumer(writer, direction, scales, dots, scratch, alpha):
+    from vllm.models.deepseek_v4_1.tilelang.collectives import RankOrderParts
+
+    if isinstance(writer, RankOrderParts):
+        # 4H parts read + H write/read beats two reads of 4H for large SP
+        # batches. Keep that path until an SP fusion avoids the second read.
+        return apply_projection(writer, direction, scales, scratch, alpha), {}
+    return writer, {
+        "steering_direction": direction,
+        "steering_scales": scales,
+        "steering_dots": projection_dots(writer, direction, scales, dots),
+        "steering_alpha": alpha,
+    }
