+@pytest.fixture(scope="module")
+def wire_request():
+    # Load the real wire base without importing FastAPI's serving initializer.
+    path = (
+        Path(__file__).resolve().parents[2]
+        / "vllm/entrypoints/serve/engine/protocol.py"
+    )
+    spec = importlib.util.spec_from_file_location("steering_wire_contract", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+
+    class Request(module.SteeringRequest):
+        use_beam_search: bool = False
+        vllm_xargs: dict[str, str | int | float | list[str | int | float]] | None = None
+
+    return Request
+
+
+def test_top_level_fields_reach_admission_and_roundtrip(wire_request, tmp_path):
+    profile = valid_profile(tmp_path)
+    original = {"unrelated_plugin": True}
+    request = wire_request(
+        steering_profile=profile.profile_id, steering_scale=2.5, vllm_xargs=original
+    )
+    assert original == {"unrelated_plugin": True}
+    selection = parse_selection(request.vllm_xargs, profile)
+    assert selection.scale == 2.5
+    assert (
+        wire_request.model_validate(request.model_dump()).vllm_xargs
+        == request.vllm_xargs
+    )
+    assert request.vllm_xargs["unrelated_plugin"] == 1
+    for key, value in (("steering_scale", 3), ("steering_profile", "other")):
+        with pytest.raises(ValueError, match="Conflicting"):
+            wire_request(
+                steering_profile=profile.profile_id,
+                steering_scale=2.5,
+                vllm_xargs={key: value},
+            )
+
+
+def test_wire_nulls_match_absence_without_coercing_non_numeric_values(
+    wire_request, tmp_path
+):
+    profile = valid_profile(tmp_path)
+    for body in (
+        {},
+        {"steering_profile": None, "steering_scale": None},
+        {"vllm_xargs": {"steering_profile": None, "steering_scale": None}},
+        {"steering_scale": 1e-50},
+    ):
+        assert parse_selection(wire_request(**body).vllm_xargs, None) == STOCK
+    request = wire_request(steering_profile=profile.profile_id, steering_scale=None)
+    assert parse_selection(request.vllm_xargs, profile).scale == 1
+    for value in (True, False, "0.5", [], {}):
+        with pytest.raises(ValueError):
+            wire_request(steering_profile=profile.profile_id, steering_scale=value)
+    for value in (True, False):
+        with pytest.raises(ValueError, match="steering_scale"):
+            wire_request(vllm_xargs={"steering_scale": value})
+
+
+def test_unqualified_request_paths_reject_instead_of_dropping_steering(wire_request):
+    with pytest.raises(ValueError, match="beam search"):
+        wire_request(use_beam_search=True, steering_profile="test-profile")
+    assert wire_request(use_beam_search=True).use_beam_search
+    base = wire_request.__bases__[0].__bases__[0]
+    for body in (
+        {"steering_profile": "test-profile"},
+        {"vllm_xargs": {"steering_scale": 0.5}},
+    ):
+        with pytest.raises(ValueError, match="not supported"):
+            base(**body)
