+class SteeringRequest(OpenAIBaseModel):
+    steering_profile: StrictStr | None = Field(
+        default=None, description="Select the immutable profile loaded at startup."
+    )
+    steering_scale: StrictInt | StrictFloat | None = Field(
+        default=None,
+        description="Request strength in [0, 4]; a named profile defaults to 1.",
+    )
+
+    @model_validator(mode="before")
+    @classmethod
+    def _forward_steering_fields(cls, data: Any):
+        if not isinstance(data, dict):
+            return data
+        original = data.get("vllm_xargs")
+        if original is not None and not isinstance(original, dict):
+            return data
+        keys = ("steering_profile", "steering_scale")
+        if not any(key in data or key in (original or {}) for key in keys):
+            return data
+        extra = dict(original or {})
+        for key in keys:
+            value = data.get(key)
+            if value is not None:
+                if extra.get(key) is not None and extra[key] != value:
+                    raise ValueError(f"Conflicting {key} in request and vllm_xargs")
+                extra[key] = value
+            elif extra.get(key) is None:
+                extra.pop(key, None)
+        return {**data, "vllm_xargs": extra or None}
+
+    @model_validator(mode="after")
+    def _reject_unsupported_beam_search(self):
+        if getattr(self, "use_beam_search", False) and any(
+            (getattr(self, "vllm_xargs", None) or {}).get(key) is not None
+            for key in ("steering_profile", "steering_scale")
+        ):
+            raise ValueError("Steering with beam search is not supported")
+        return self
+
+
 class ErrorInfo(OpenAIBaseModel):
     message: str
     type: str
