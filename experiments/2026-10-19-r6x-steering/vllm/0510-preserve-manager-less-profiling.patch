@@ -301,6 +303,190 @@ def test_actual_model_state_real_dummy_and_capture_hooks(host_modules, tmp_path)
         state.prepare_dummy_inputs_for_variant(1, 8, 1)
 
 
+def source_definitions(path, names, namespace, *, owner=None):
+    """Execute complete production bodies without importing the GPU dependency tree.
+
+    Only decorators are removed. No statements, branches or expressions in the
+    tested methods are replaced. Device/allocator/connector boundaries are fakes.
+    """
+    source = ROOT / path
+    tree = ast.parse(source.read_text())
+    nodes = tree.body
+    if owner is not None:
+        nodes = next(
+            n for n in nodes if isinstance(n, ast.ClassDef) and n.name == owner
+        ).body
+    selected = [n for n in nodes if getattr(n, "name", None) in names]
+    assert {n.name for n in selected} == set(names)
+    for node in selected:
+        if isinstance(node, ast.FunctionDef):
+            node.decorator_list = []
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            *selected,
+        ],
+        type_ignores=[],
+    )
+    exec(compile(ast.fix_missing_locations(module), str(source), "exec"), namespace)
+
+
+@pytest.mark.parametrize("loaded", [False, True])
+@pytest.mark.parametrize("explicit_kv_bytes", [None, 1024])
+def test_actual_runner_initial_profile_before_graph_manager(
+    host_modules, tmp_path, loaded, explicit_kv_bytes
+):
+    """profile_run -> _dummy_run -> execute_model must reach eager model forward.
+
+    This runs complete production host bodies and real DeepSeek prepare_inputs,
+    not a reimplementation of their dispatch. It does not emulate GPU allocation,
+    the separate attention-cache profile, or initialize_kv_cache's GPU setup.
+    """
+    h = host_modules
+    events = []
+    state = h.state.__new__(h.state)
+    state.steering = (
+        SteeringRuntime(valid_profile(tmp_path), 4, 16, "cpu") if loaded else None
+    )
+    state.ced_state = state.lookback_token_ids = None
+    state.disk_engram_models = ()
+    state.single_request_prefill_cudagraph_tokens = 0
+    # A profile has no scheduled real requests and must never select an active
+    # graph or clear/expand GPU controls, even when a profile is loaded.
+    state.get_model_input_variant = lambda *a, **kw: pytest.fail(
+        "profiling must not select a graph variant"
+    )
+    if state.steering is not None:
+        state.steering.row_scales.fill_(31)
+
+    def make_empty():
+        return SimpleNamespace(
+            finished_req_ids=set(), resolve_num_spec_tokens_to_schedule=lambda n: 0
+        )
+
+    def make_dummy(num_reqs, num_tokens, buffers, **kwargs):
+        return SimpleNamespace(
+            num_reqs=num_reqs,
+            num_reqs_after_padding=num_reqs,
+            num_tokens=num_tokens,
+            num_tokens_after_padding=num_tokens,
+            is_dummy=True,
+            req_ids=[f"_dummy_req_{i}" for i in range(num_reqs)],
+            input_ids=torch.zeros(num_tokens, dtype=torch.int64),
+            positions=torch.arange(num_tokens),
+            logits_indices=torch.arange(num_reqs),
+            idx_mapping=torch.arange(num_reqs),
+            is_padding=torch.zeros(num_tokens, dtype=torch.bool),
+        )
+
+    def forward_context(*args, **kwargs):
+        events.append(("forward", kwargs["cudagraph_runtime_mode"]))
+        return nullcontext()
+
+    def model(**inputs):
+        assert not inputs.get("steering_active", False)
+        assert "steering_scales" not in inputs
+        events.append(("model", loaded))
+        return torch.ones(8, 8)
+
+    ns = dict(
+        dataclass=dataclass,
+        CUDAGraphMode=Mode,
+        np=np,
+        torch=SimpleNamespace(
+            Tensor=torch.Tensor, accelerator=SimpleNamespace(synchronize=lambda: None)
+        ),
+        SchedulerOutput=SimpleNamespace(make_empty=make_empty),
+        InputBatch=SimpleNamespace(make_dummy=make_dummy),
+        ExecuteModelState=SimpleNamespace,
+        BatchDescriptor=lambda **kw: SimpleNamespace(**kw),
+        normalize_model_token_inputs=lambda *a: None,
+        set_forward_context=forward_context,
+        current_workspace_manager=lambda: SimpleNamespace(reserve_by_lane=lambda: None),
+        gc=SimpleNamespace(collect=lambda: None),
+    )
+    source_definitions(
+        "vllm/v1/worker/gpu/cudagraph_utils.py", ["BatchExecutionDescriptor"], ns
+    )
+    source_definitions(
+        "vllm/v1/worker/gpu/dp_utils.py", ["dispatch_cg_and_sync_dp"], ns
+    )
+    methods = ["profile_run", "_dummy_run", "execute_model"]
+    source_definitions(
+        "vllm/v1/worker/gpu/model_runner.py", methods, ns, owner="GPUModelRunner"
+    )
+    runner = type("HostRunner", (), {name: ns[name] for name in methods})()
+    for key, value in dict(
+        cudagraph_manager=None,
+        model_state=state,
+        model=model,
+        max_num_tokens=8,
+        max_num_reqs=4,
+        decode_query_len=1,
+        supports_mm_inputs=False,
+        is_first_pp_rank=True,
+        is_last_pp_rank=True,
+        pooling_runner=None,
+        speculator=None,
+        lora_config=None,
+        pcp_manager=None,
+        ubatch_runner=None,
+        is_encoder_decoder=False,
+        uses_inputs_embeds=False,
+        dp_size=1,
+        dp_rank=0,
+        parallel_config=None,
+        model_config=None,
+        vllm_config=None,
+        input_buffers=None,
+        req_states=None,
+        num_speculative_steps=0,
+        use_aux_hidden_state_outputs=False,
+        cache_config=SimpleNamespace(kv_cache_memory_bytes=explicit_kv_bytes),
+        maybe_dummy_run_with_lora=lambda *a, **kw: nullcontext(),
+        gather_batch_req_state=lambda *a: (None, None),
+        _reserve_profile_scratch=lambda: None,
+        _dummy_sampler_run=lambda output: events.append(
+            ("sampler", tuple(output.shape))
+        ),
+        _profile_deepseek_v4_attention=lambda *a: events.append(
+            ("attention-profile-boundary", None)
+        ),
+        reset_encoder_cache=lambda: None,
+        kv_connector=SimpleNamespace(
+            set_disabled=lambda flag: events.append(("connector", flag)),
+            pre_forward=lambda **kw: None,
+            finish_forward=lambda: None,
+        ),
+        eplb=SimpleNamespace(prepare_forward=lambda *a: None),
+        step_timing=SimpleNamespace(
+            record_batch=lambda *a: None,
+            forward_start=lambda: None,
+            forward_end=lambda: None,
+        ),
+    ).items():
+        setattr(runner, key, value)
+
+    runner.profile_run()
+    assert runner.cudagraph_manager is None
+    assert events == [
+        ("connector", True),
+        ("forward", Mode.NONE),
+        ("model", loaded),
+        ("connector", False),
+        ("sampler", (4, 8)),
+        ("attention-profile-boundary", None),
+    ]
+    assert runner.execute_model_state is None
+    if loaded:
+        assert (state.steering.row_scales == 31).all()
+    # The existing dispatch contract must still reject a manager-less real run.
+    with pytest.raises(AssertionError, match="only be None during profile run"):
+        ns["dispatch_cg_and_sync_dp"](None, 1, 8, None, 1, 0)
+
+
 @pytest.mark.parametrize("world", [1, 4])
