+# Adapted from kindlingai/gr8 tools/steering/release.py at
+# c53b5b869818950a96a9b72c647d4b156b057127.
+"""Pack and unpack the explicit DeepSeek attention extension deterministically.
+
+The payload has one F32 tensor, ``directions``. Metadata preserves the exact
+UTF-8 manifest. Only the standard library is needed to materialize a profile.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import shutil
+import struct
+import tempfile
+
+FORMAT = "gr8-steering-profile-v1+ds41-attention-v1"
+OPERATOR_VERSION = "attn-writer-project-bf16-rank-order-v1"
+MAX_HEADER = 1 << 20
+MAX_PAYLOAD = 64 << 20
+
+
+class ProfileError(ValueError):
+    pass
+
+
+def canonical(value):
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    )
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _unique_object(pairs):
+    out = {}
+    for key, value in pairs:
+        if key in out:
+            raise ProfileError(f"duplicate JSON key {key}")
+        out[key] = value
+    return out
+
+
+def parse_json(raw, where):
+    def number(token):
+        value = float(token)
+        if not math.isfinite(value):
+            raise ProfileError(f"invalid {where}: non-finite number")
+        return value
+
+    def constant(token):
+        raise ProfileError(f"invalid {where}: non-finite number {token}")
+
+    def check(value, depth=0):
+        if depth > 64:
+            raise ProfileError(f"invalid {where}: nested too deeply")
+        if isinstance(value, str):
+            value.encode(
+                "utf-8"
+            )  # reject lone escaped surrogates, as the C++ reader does
+        elif isinstance(value, dict):
+            for key, item in value.items():
+                key.encode("utf-8")
+                check(item, depth + 1)
+        elif isinstance(value, list):
+            for item in value:
+                check(item, depth + 1)
+
+    try:
+        if isinstance(raw, bytes):
+            raw = raw.decode("utf-8")  # JSON here never accepts UTF-16/32 or a BOM
+        value = json.loads(
+            raw,
+            object_pairs_hook=_unique_object,
+            parse_float=number,
+            parse_constant=constant,
+        )
+        check(value)
+        return value
+    except ProfileError:
+        raise
+    except (UnicodeError, ValueError, RecursionError) as e:
+        raise ProfileError(f"invalid {where}: {e}") from None
+
+
+def read_limited(path, limit, what):
+    with open(path, "rb") as f:
+        raw = f.read(limit + 1)
+    if len(raw) > limit:
+        raise ProfileError(f"{what} is too large")
+    return raw
+
+
+def _object(value, keys, where):
+    if not isinstance(value, dict) or set(value) != set(keys):
+        raise ProfileError(f"invalid {where}")
+
+
+def _integer(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _u32(value):
+    return _integer(value) and 0 <= value <= 0xFFFFFFFF
+
+
+def _digest(value):
+    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None
+
+
+def validate_manifest(manifest, payload, expected=None):
+    _object(
+        manifest,
+        (
+            "schema_version",
+            "profile_name",
+            "model",
+            "scope",
+            "layers",
+            "alphas",
+            "directions",
+            "provenance",
+            "operator_version",
+        ),
+        "manifest fields",
+    )
+    if not _integer(manifest.get("schema_version")) or manifest["schema_version"] != 1:
+        raise ProfileError("want a schema-v1 steering manifest")
+    name = manifest.get("profile_name")
+    if not isinstance(name, str) or not re.fullmatch(
+        r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name
+    ):
+        raise ProfileError("invalid profile_name")
+    layers, alphas = manifest.get("layers"), manifest.get("alphas")
+    model, directions = manifest.get("model"), manifest.get("directions")
+    if (
+        not isinstance(layers, list)
+        or not layers
+        or not isinstance(alphas, list)
+        or len(layers) != len(alphas)
+    ):
+        raise ProfileError("inconsistent layers and alphas")
+    _object(
+        model,
+        (
+            "name",
+            "revision",
+            "weight_set",
+            "tokenizer_revision",
+            "chat_template_sha256",
+            "hidden_size",
+            "layer_count",
+        ),
+        "model fields",
+    )
+    for field in ("name", "revision", "weight_set", "tokenizer_revision"):
+        if not isinstance(model.get(field), str) or not model[field]:
+            raise ProfileError(f"invalid model.{field}")
+    if not _digest(model["weight_set"]):
+        raise ProfileError("invalid model.weight_set")
+    if (
+        not _u32(model.get("hidden_size"))
+        or model["hidden_size"] == 0
+        or not _u32(model.get("layer_count"))
+        or model["layer_count"] == 0
+    ):
+        raise ProfileError("invalid model dimensions")
+    if not _digest(model.get("chat_template_sha256")):
+        raise ProfileError("invalid model.chat_template_sha256")
+    if expected is not None:
+        _object(expected, model.keys(), "expected model identity fields")
+        if any(
+            type(expected[key]) is not type(value) or expected[key] != value
+            for key, value in model.items()
+        ):
+            raise ProfileError("model identity mismatch")
+    last = -1
+    for layer in layers:
+        if not _integer(layer) or layer <= last or layer >= model["layer_count"]:
+            raise ProfileError("layers must be unique, ordered, and in range")
+        last = layer
+    for alpha in alphas:
+        if (
+            isinstance(alpha, bool)
+            or not isinstance(alpha, (int, float))
+            or not 0.0 <= alpha <= 4.0
+            or not math.isfinite(alpha)
+        ):
+            raise ProfileError("alpha must be finite and in [0, 4]")
+    if manifest.get("scope") != "attention":
+        raise ProfileError("this operator requires attention scope")
+    if manifest.get("operator_version") != OPERATOR_VERSION:
+        raise ProfileError("unsupported attention operator version")
+    want = len(layers) * model["hidden_size"] * 4
+    _object(directions, ("file", "dtype", "byte_count", "sha256"), "directions record")
+    if (
+        directions.get("file") != "directions.f32"
+        or directions.get("dtype") != "float32-le"
+        or not _u32(directions.get("byte_count"))
+        or directions["byte_count"] != want
+    ):
+        raise ProfileError("invalid directions record")
+    if len(payload) != want or len(payload) > MAX_PAYLOAD:
+        raise ProfileError("directions payload size mismatch")
+    if directions.get("sha256") != sha256(payload):
+        raise ProfileError("directions payload digest mismatch")
+    provenance = manifest.get("provenance")
+    if not isinstance(provenance, dict):
+        raise ProfileError("invalid provenance")
+    kind = provenance.get("kind")
+    if kind == "imported":
+        _object(
+            provenance,
+            ("kind", "source", "conversion", "dataset_manifests"),
+            "import provenance",
+        )
+        if provenance["dataset_manifests"] is not None:
+            raise ProfileError(
+                "imported directions must declare unknown extraction datasets as null"
+            )
+        original = provenance["source"]
+        _object(
+            original,
+            ("repository", "revision", "license", "directions", "schedule"),
+            "source",
+        )
+        for field in ("repository", "license"):
+            if not isinstance(original[field], str) or not original[field]:
+                raise ProfileError(f"invalid source.{field}")
+        if not isinstance(original["revision"], str) or not re.fullmatch(
+            "[0-9a-f]{40}", original["revision"]
+        ):
+            raise ProfileError("invalid source revision")
+        for key, detail in (("directions", "tensor"), ("schedule", "value")):
+            record = original[key]
+            _object(record, ("file", "sha256", detail), f"source.{key}")
+            for field in ("file", detail):
+                if not isinstance(record[field], str) or not record[field]:
+                    raise ProfileError(f"invalid source.{key}.{field}")
+            if not _digest(record["sha256"]):
+                raise ProfileError(f"invalid source.{key} digest")
+        conversion = provenance["conversion"]
+        _object(conversion, ("tool", "sha256"), "conversion")
+        if (
+            not isinstance(conversion["tool"], str)
+            or not conversion["tool"]
+            or not _digest(conversion["sha256"])
+        ):
+            raise ProfileError("invalid conversion identity")
+    elif kind == "extracted":
+        _object(
+            provenance,
+            ("kind", "extraction_tool", "extraction_commit", "dataset_manifests"),
+            "extraction provenance",
+        )
+        for field in ("extraction_tool", "extraction_commit"):
+            if not isinstance(provenance[field], str) or not provenance[field]:
+                raise ProfileError(f"invalid {field}")
+        datasets = provenance["dataset_manifests"]
+        _object(datasets, ("train", "validation", "final"), "dataset manifests")
+        if not all(_digest(value) for value in datasets.values()):
+            raise ProfileError("extraction requires all dataset manifest digests")
+    else:
+        raise ProfileError("unknown provenance kind")
+    values = struct.iter_unpack("<f", payload)
+    width = model["hidden_size"]
+    norm2 = 0.0
+    for i, (value,) in enumerate(values, 1):
+        if not math.isfinite(value):
+            raise ProfileError("non-finite direction")
+        norm2 += value * value
+        if i % width == 0:
+            norm = math.sqrt(norm2)
+            if not 0.999 <= norm <= 1.001:
+                raise ProfileError("direction norm outside [0.999, 1.001]")
+            norm2 = 0.0
+    return name, [len(layers), model["hidden_size"]]
+
+
+def read_directory(profile_dir, expected_sha256=None):
+    """Read one manifest/payload pair with an optional exact manifest pin."""
+    manifest_path = os.path.join(profile_dir, "manifest.json")
+    payload_path = os.path.join(profile_dir, "directions.f32")
+    try:
+        raw = read_limited(manifest_path, MAX_HEADER, "manifest")
+        manifest = parse_json(raw, "manifest JSON")
+        payload = read_limited(payload_path, MAX_PAYLOAD, "directions payload")
+    except OSError as e:
+        raise ProfileError(str(e)) from None
+    if expected_sha256 is not None and sha256(raw) != expected_sha256:
+        raise ProfileError("steering manifest SHA-256 mismatch")
+    validate_manifest(manifest, payload)
+    return manifest, payload, raw
+
+
+def validate_directory(profile_dir, expected=None):
+    """Validate the directory against an optional complete model identity."""
+    manifest, payload, _ = read_directory(profile_dir)
+    validate_manifest(manifest, payload, expected)
+    return manifest
+
+
+def _atomic_write(path, chunks):
+    parent = os.path.dirname(os.path.abspath(path))
+    os.makedirs(parent, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=".steering-", dir=parent)
+    try:
+        with os.fdopen(fd, "wb") as f:
+            for chunk in chunks:
+                f.write(chunk)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    finally:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+
+
+def pack(profile_dir, output):
+    """Pack exact input bytes and atomically publish the artifact."""
+    manifest_raw = read_limited(
+        os.path.join(profile_dir, "manifest.json"), MAX_HEADER, "manifest"
+    )
+    manifest = parse_json(manifest_raw, "manifest JSON")
+    payload = read_limited(
+        os.path.join(profile_dir, "directions.f32"), MAX_PAYLOAD, "directions payload"
+    )
+    _, shape = validate_manifest(manifest, payload)
+    manifest_json = manifest_raw.decode("utf-8")
+    header = {
+        "__metadata__": {
+            "format": FORMAT,
+            "gr8_manifest": manifest_json,
+            "manifest_sha256": sha256(manifest_raw),
+        },
+        "directions": {
+            "dtype": "F32",
+            "shape": shape,
+            "data_offsets": [0, len(payload)],
+        },
+    }
+    raw_header = canonical(header).encode()
+    raw_header += b" " * ((8 - len(raw_header) % 8) % 8)
+    if len(raw_header) > MAX_HEADER:
+        raise ProfileError("safetensors header is too large")
+    _atomic_write(output, (struct.pack("<Q", len(raw_header)), raw_header, payload))
+
+
+def read_artifact(path, expected_sha256=None):
+    with open(path, "rb") as f:
+        size = os.fstat(f.fileno()).st_size
+        raw = f.read(8)
+        if len(raw) != 8:
+            raise ProfileError("truncated safetensors header length")
+        (n,) = struct.unpack("<Q", raw)
+        if n <= 0 or n % 8 or n > MAX_HEADER or 8 + n > size:
+            raise ProfileError("invalid safetensors header length")
+        header_raw = f.read(n)
+        header = parse_json(header_raw, "safetensors header")
+        _object(
+            header,
+            ("__metadata__", "directions"),
+            "safetensors fields; want exactly one directions tensor",
+        )
+        meta, tensor = header["__metadata__"], header["directions"]
+        _object(
+            meta, ("format", "gr8_manifest", "manifest_sha256"), "GR8 metadata fields"
+        )
+        if meta.get("format") != FORMAT or not isinstance(
+            meta.get("gr8_manifest"), str
+        ):
+            raise ProfileError("missing GR8 steering metadata")
+        if (
+            not isinstance(tensor, dict)
+            or set(tensor) != {"dtype", "shape", "data_offsets"}
+            or tensor["dtype"] != "F32"
+        ):
+            raise ProfileError("directions must be one F32 tensor")
+        offsets = tensor["data_offsets"]
+        if (
+            not isinstance(offsets, list)
+            or len(offsets) != 2
+            or not all(_integer(x) for x in offsets)
+            or offsets != [0, size - 8 - n]
+            or not 0 <= offsets[1] <= MAX_PAYLOAD
+        ):
+            raise ProfileError("invalid directions data offsets")
+        payload = f.read(MAX_PAYLOAD + 1)
+        if len(payload) != offsets[1]:
+            raise ProfileError("directions payload size mismatch")
+    if (
+        expected_sha256 is not None
+        and sha256(raw + header_raw + payload) != expected_sha256
+    ):
+        raise ProfileError("steering profile SHA-256 mismatch")
+    manifest = parse_json(meta["gr8_manifest"], "embedded manifest")
+    manifest_raw = meta["gr8_manifest"].encode("utf-8")
+    if len(manifest_raw) > MAX_HEADER or meta.get("manifest_sha256") != sha256(
+        manifest_raw
+    ):
+        raise ProfileError("embedded manifest is too large or has the wrong digest")
+    _, shape = validate_manifest(manifest, payload)
+    if (
+        not isinstance(tensor["shape"], list)
+        or not all(_integer(x) for x in tensor["shape"])
+        or tensor["shape"] != shape
+    ):
+        raise ProfileError("directions tensor shape mismatch")
+    return manifest, payload, manifest_raw
+
+
+def read(path):
+    """Return the validated manifest mapping and directions bytes from an artifact."""
+    manifest, payload, _ = read_artifact(path)
+    return manifest, payload
+
+
+def resolve_bundled(model_dir, selector):
+    """Resolve only an explicitly selected artifact in a verified local release."""
+    if not isinstance(selector, str) or not selector.startswith("hf:"):
+        raise ProfileError("want hf:default or hf:NAME")
+    root = os.path.abspath(model_dir)
+    raw = read_limited(os.path.join(root, "steering/index.json"), MAX_HEADER, "index")
+    index = parse_json(raw, "steering index")
+    _object(index, ("schema_version", "default_profile", "profiles"), "index")
+    if type(index["schema_version"]) is not int or index["schema_version"] != 1:
+        raise ProfileError("unsupported steering index version")
+    if not isinstance(index["profiles"], list):
+        raise ProfileError("invalid profile records")
+    records = {}
+    for entry in index["profiles"]:
+        _object(entry, ("name", "file", "sha256", "byte_count"), "index record")
+        name = entry["name"]
+        if (
+            not isinstance(name, str)
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name)
+            or name in records
+            or entry["file"] != f"steering/{name}.safetensors"
+            or not _digest(entry["sha256"])
+            or type(entry["byte_count"]) is not int
+            or not 8 < entry["byte_count"] <= 8 + MAX_HEADER + MAX_PAYLOAD
+        ):
+            raise ProfileError("invalid or duplicate steering index record")
+        records[name] = entry
+    default = index["default_profile"]
+    if not isinstance(default, str) or default not in records:
+        raise ProfileError("default_profile is not listed")
+    name = default if selector == "hf:default" else selector[3:]
+    if name not in records:
+        raise ProfileError("requested profile is not listed")
+    entry = records[name]
+    path = os.path.join(root, entry["file"])
+    if os.path.getsize(path) != entry["byte_count"]:
+        raise ProfileError("bundled profile size mismatch")
+    manifest, _, _ = read_artifact(path, entry["sha256"])
+    if manifest["profile_name"] != name:
+        raise ProfileError("bundled profile name mismatch")
+    return name, path, entry["sha256"]
+
+
+def unpack(path, output_dir):
+    """Publish exact contents; reuse identical bytes and reject conflicts."""
+    manifest, payload, manifest_raw = read_artifact(path)
+    output_dir = os.path.abspath(output_dir)
+    if os.path.islink(output_dir):
+        raise ProfileError("output directory must not be a symlink")
+    if os.path.isdir(output_dir) and os.listdir(output_dir):
+        if (
+            read_limited(
+                os.path.join(output_dir, "manifest.json"), MAX_HEADER, "manifest"
+            )
+            == manifest_raw
+            and read_limited(
+                os.path.join(output_dir, "directions.f32"),
+                MAX_PAYLOAD,
+                "directions payload",
+            )
+            == payload
+        ):
+            return manifest
+        raise ProfileError("output directory contains a different profile")
+    parent = os.path.dirname(output_dir)
+    os.makedirs(parent, exist_ok=True)
+    stage = tempfile.mkdtemp(prefix=".steering-", dir=parent)
+    try:
+        _atomic_write(os.path.join(stage, "manifest.json"), (manifest_raw,))
+        _atomic_write(os.path.join(stage, "directions.f32"), (payload,))
+        os.replace(stage, output_dir)
+    finally:
+        shutil.rmtree(stage, ignore_errors=True)
+    return manifest
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="command", required=True)
+    p = sub.add_parser("pack")
+    p.add_argument("profile_dir")
+    p.add_argument("output")
+    p = sub.add_parser("unpack")
+    p.add_argument("input")
+    p.add_argument("output_dir")
+    args = ap.parse_args(argv)
+    try:
+        if args.command == "pack":
+            pack(args.profile_dir, args.output)
+        else:
+            unpack(args.input, args.output_dir)
+    except (OSError, ProfileError) as e:
+        ap.exit(2, f"{ap.prog}: {e}\n")
+
+
+if __name__ == "__main__":
+    main()
