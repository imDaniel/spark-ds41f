index 0000000000..2d09b1cf02
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/steering/profile.py
@@ -0,0 +1,238 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bounded, local-only profile loading. This module never loads pickle files."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import struct
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from .artifact import OPERATOR_VERSION, read_artifact, read_directory
+
+SCHEMA_VERSION = 1
+MODEL_NAME = "deepseek-v4.1-flash-1017"
+MAX_LAYERS = 256
+MAX_HIDDEN = 32768
+NORM_ATOL = 1e-3
+IDENTITY_FILES = (
+    "config.json",
+    "model.safetensors.index.json",
+    "tokenizer.json",
+    "tokenizer_config.json",
+    "chat_template.jinja",
+)
+
+
+def canonical_json(value: Any) -> bytes:
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("ascii")
+
+
+def content_hash(value: Any) -> str:
+    return hashlib.sha256(canonical_json(value)).hexdigest()
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"Duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+def sha256_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def model_identity(model_path: str | Path) -> str:
+    """Bind local checkpoint index, trusted weights inventory and tokenizer bytes.
+
+    Weight payload verification belongs to artifact preparation; never hash the
+    full checkpoint in each worker's startup. The trusted inventory is itself
+    bound here and the deployment verifier checks every hardlink against it.
+    """
+    root = Path(model_path)
+    if not root.is_dir():
+        raise ValueError("Steering requires a verified local model directory")
+    files = {
+        name: sha256_file(root / name)
+        for name in IDENTITY_FILES
+        if (root / name).is_file()
+    }
+    required = {
+        "config.json",
+        "model.safetensors.index.json",
+        "tokenizer.json",
+        "tokenizer_config.json",
+    }
+    if not required <= files.keys():
+        raise ValueError(
+            "Steering model is missing identity files or trusted weight inventory"
+        )
+    inventory_path = root / "model-file-hashes.json"
+    if not inventory_path.is_file():
+        raise ValueError("Steering model needs a trusted weight inventory")
+    inventory = json.loads(
+        inventory_path.read_bytes(), object_pairs_hook=_unique_object
+    )
+    if (
+        not isinstance(inventory, dict)
+        or inventory.get("schema_version") != 1
+        or inventory.get("algorithm") != "sha256"
+        or inventory.get("coverage") != "complete"
+        or not isinstance(inventory.get("files"), dict)
+    ):
+        raise ValueError("Invalid trusted weight inventory")
+    index = json.loads(
+        (root / "model.safetensors.index.json").read_bytes(),
+        object_pairs_hook=_unique_object,
+    )
+    shards = sorted(set(index["weight_map"].values()))
+    weights = {}
+    for name in shards:
+        if not isinstance(name, str) or Path(name).name != name:
+            raise ValueError("Invalid checkpoint shard name")
+        entry = inventory["files"].get(name)
+        if (
+            not isinstance(entry, dict)
+            or type(entry.get("size")) is not int
+            or entry["size"] <= 0
+        ):
+            raise ValueError("Checkpoint shard missing from trusted inventory")
+        weights[name] = {
+            "size": entry["size"],
+            "sha256": _digest(entry.get("sha256"), "weight"),
+        }
+    if not weights:
+        raise ValueError("Empty trusted weight inventory")
+    # Hostname, timestamp and inode identities differ between replicas. Bind
+    # verified content only so the same checkpoint has one identity on all ranks.
+    files["weight_inventory"] = content_hash(weights)
+    return content_hash(files)
+
+
+def template_identity(model_path: str | Path) -> str:
+    root = Path(model_path)
+    vllm_root = Path(__file__).resolve().parents[3]
+    files = {
+        name: sha256_file(vllm_root / name)
+        for name in (
+            "tokenizers/deepseek_v41.py",
+            "tokenizers/deepseek_v41_encoding.py",
+            "renderers/deepseek_v41.py",
+        )
+    }
+    for name in ("tokenizer.json", "tokenizer_config.json", "chat_template.jinja"):
+        if (root / name).is_file():
+            files["model/" + name] = sha256_file(root / name)
+    return content_hash(files)
+
+
+def _digest(value: Any, name: str) -> str:
+    if not isinstance(value, str) or re.fullmatch("[0-9a-f]{64}", value) is None:
+        raise ValueError(f"Invalid {name} SHA-256")
+    return value
+
+
+@dataclass(frozen=True)
+class SteeringProfile:
+    profile_id: str
+    model_revision: str
+    model_identity: str
+    template_identity: str
+    operator_version: str
+    layers: tuple[int, ...]
+    alphas: tuple[float, ...]
+    hidden_size: int
+    num_hidden_layers: int
+    artifact_sha256: str | None
+    schedule_sha256: str
+    directions: Any
+    manifest_sha256: str
+    tokenizer_revision: str
+
+    @property
+    def identity(self) -> str:
+        return content_hash(
+            {
+                "schema": SCHEMA_VERSION,
+                "profile": self.profile_id,
+                "manifest": self.manifest_sha256,
+                "tokenizer_revision": self.tokenizer_revision,
+                "model": self.model_identity,
+                "model_revision": self.model_revision,
+                "template": self.template_identity,
+                "operator": self.operator_version,
+                "schedule": self.schedule_sha256,
+            }
+        )
+
+
+def load_profile(
+    path: str | Path,
+    expected_sha256: str,
+    *,
+    expected_model_identity: str | None = None,
+    expected_template_identity: str | None = None,
+    expected_revision: str | None = None,
+    expected_tokenizer_revision: str | None = None,
+) -> SteeringProfile:
+    import numpy as np
+
+    _digest(expected_sha256, "profile")
+    directory = Path(path).is_dir()
+    reader = read_directory if directory else read_artifact
+    manifest, payload, manifest_raw = reader(path, expected_sha256)
+    model = manifest["model"]
+    if model["name"] != MODEL_NAME:
+        raise ValueError("Steering profile targets a different model architecture")
+    for key in ("revision", "tokenizer_revision"):
+        if re.fullmatch("[0-9a-f]{40}", model[key]) is None:
+            raise ValueError(f"Invalid model {key}")
+    for key, expected in (
+        ("weight_set", expected_model_identity),
+        ("chat_template_sha256", expected_template_identity),
+        ("revision", expected_revision),
+        ("tokenizer_revision", expected_tokenizer_revision),
+    ):
+        if expected is not None and model[key] != expected:
+            raise ValueError(f"Steering profile model {key} identity mismatch")
+    hidden, count = model["hidden_size"], model["layer_count"]
+    if hidden > MAX_HIDDEN or count > MAX_LAYERS:
+        raise ValueError("Steering model geometry exceeds bounded operator limits")
+    layers = tuple(manifest["layers"])
+    alphas = tuple(
+        struct.unpack("<f", struct.pack("<f", alpha))[0] for alpha in manifest["alphas"]
+    )
+    directions = np.frombuffer(payload, dtype="<f4").reshape(len(layers), hidden)
+    directions.flags.writeable = False
+    schedule_bytes = b"\x03" + b"".join(
+        struct.pack("<If", layer, alpha) for layer, alpha in zip(layers, alphas)
+    )
+    return SteeringProfile(
+        profile_id=manifest["profile_name"],
+        model_revision=model["revision"],
+        model_identity=model["weight_set"],
+        template_identity=model["chat_template_sha256"],
+        operator_version=OPERATOR_VERSION,
+        layers=layers,
+        alphas=alphas,
+        hidden_size=hidden,
+        num_hidden_layers=count,
+        artifact_sha256=None if directory else expected_sha256,
+        schedule_sha256=hashlib.sha256(schedule_bytes).hexdigest(),
+        directions=directions,
+        manifest_sha256=hashlib.sha256(manifest_raw).hexdigest(),
+        tokenizer_revision=model["tokenizer_revision"],
+    )
diff --git a/vllm/models/deepseek_v4_1/steering/reference.py b/vllm/models/deepseek_v4_1/steering/reference.py
