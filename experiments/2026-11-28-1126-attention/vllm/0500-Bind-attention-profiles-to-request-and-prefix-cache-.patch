@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Numerical oracles, used by tests rather than the serving path."""
+
+import torch
+
+
+def project_reference(writer, direction, scales, alpha, *, fp64=False):
+    dtype = torch.float64 if fp64 else torch.float32
+    y, d = writer.to(dtype), direction.to(dtype)
+    dots = (y * d).sum(dim=-1, keepdim=True)
+    projected = y - (scales.to(dtype) * alpha)[:, None] * d * dots
+    # Bypass rather than multiply by zero: stock rows retain signed zeros/NaNs.
+    return torch.where((scales != 0)[:, None], projected.to(writer.dtype), writer)
+
+
+def rank_order_reference(parts):
+    total = parts[0].float()
+    for rank in range(1, parts.shape[0]):
+        total = total + parts[rank].float()
+    return total.to(parts.dtype)
diff --git a/vllm/models/deepseek_v4_1/steering/request.py b/vllm/models/deepseek_v4_1/steering/request.py
new file mode 100644
index 0000000000..4c2b02ddb0
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/steering/request.py
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Pure CPU request contract, independent of CUDA and model imports."""
+
+from __future__ import annotations
+
+import math
+import re
+import struct
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from .profile import SteeringProfile
+
+
+@dataclass(frozen=True)
+class SteeringSelection:
+    profile_identity: str | None = None
+    scale_bits: int = 0
+
+    @property
+    def scale(self) -> float:
+        return struct.unpack("!f", struct.pack("!I", self.scale_bits))[0]
+
+    @property
+    def active(self) -> bool:
+        return self.scale_bits != 0
+
+
+STOCK = SteeringSelection()
+
+
+class SteeringRequestError(ValueError):
+    def __init__(self, message: str, parameter: str):
+        super().__init__(message)
+        self.parameter = parameter
+
+
+def parse_selection(
+    extra_args: dict[str, Any] | None, profile: SteeringProfile | None
+) -> SteeringSelection:
+    args = extra_args or {}
+    named = args.get("steering_profile") is not None
+    scaled = args.get("steering_scale") is not None
+    if not named and not scaled:
+        return STOCK
+    if named:
+        name = args["steering_profile"]
+        if (
+            not isinstance(name, str)
+            or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name) is None
+        ):
+            raise SteeringRequestError(
+                "steering_profile must be a profile name", "steering_profile"
+            )
+    value = args["steering_scale"] if scaled else (1 if named else 0)
+    if type(value) not in (int, float):
+        raise SteeringRequestError("steering_scale must be a number", "steering_scale")
+    # Validate before rounding: an out-of-range double must not round into range.
+    if not 0 <= value <= 4 or not math.isfinite(value):
+        raise SteeringRequestError(
+            "steering_scale must be finite and in [0, 4]", "steering_scale"
+        )
+    bits = struct.unpack("!I", struct.pack("!f", float(value)))[0] & 0x7FFFFFFF
+    if not named and bits != 0:
+        raise SteeringRequestError(
+            "steering_scale requires steering_profile", "steering_scale"
+        )
+    if named:
+        if profile is None:
