+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Projection update inside the existing mHC register fold.
+
+The dot producer and consumer use the same rank-order FP32 sum -> BF16 writer
+boundary. Explicit IEEE FP32 operations preserve the compensated writer math
+without changing the enclosing mHC kernel's compiler settings.
+"""
+
+from vllm.tilelang_utils import T
+
+
+@T.macro
+def project_columns(xv, direction, scales, dots, alpha, src, col, columns):
+    # This branch precedes every direction/dot load. Zero rows keep xv's bits,
+    # including signed zero and nonfinite stock values.
+    if scales[src] != 0.0 and alpha != 0.0:
+        dose = scales[src]
+        hi = dots[src, 0]
+        lo = dots[src, 1]
+        factor = T.ieee_mul(dose, alpha)
+        factor_lo = T.ieee_fmaf(dose, alpha, -factor)
+        for v in T.unroll(columns):
+            value = T.Cast(T.float32, xv[v])
+            d = direction[col + v]
+            if T.abs(hi) < T.float32(float("inf")):
+                coefficient = T.ieee_mul(factor, d)
+                coefficient_lo = T.ieee_add(
+                    T.ieee_fmaf(factor, d, -coefficient), T.ieee_mul(factor_lo, d)
+                )
+                correction = T.ieee_add(
+                    T.ieee_add(
+                        T.ieee_mul(coefficient, lo), T.ieee_mul(coefficient_lo, hi)
+                    ),
+                    T.ieee_mul(coefficient_lo, lo),
+                )
+                xv[v] = T.Cast(
+                    T.bfloat16,
+                    T.ieee_sub(T.ieee_fmaf(-coefficient, hi, value), correction),
+                )
+            else:
+                xv[v] = T.Cast(
+                    T.bfloat16,
+                    T.ieee_sub(value, T.ieee_mul(T.ieee_mul(factor, d), hi)),
+                )
diff --git a/vllm/models/deepseek_v4_1/steering/ops.py b/vllm/models/deepseek_v4_1/steering/ops.py
new file mode 100644
index 0000000000..b1cc08ab95
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/steering/ops.py
@@ -0,0 +1,309 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opaque graph-safe projection at the attention writer -> mHC boundary."""
+
+import torch
+
+from vllm.model_executor.warmup.jit_warmup_triton_helper import (
+    TritonWarmupTensor,
+    triton_kernel_dispatcher_with_warmup,
+    triton_warmup_inputs,
+)
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _sum_pair(ah, al, bh, bl):
+    total = ah + bh
+    part = total - ah
+    residual = (ah - (total - part)) + (bh - part)
+    low = (al + bl) + residual
+    low = tl.where(tl.abs(total) < float("inf"), low, 0.0)
+    high = total + low
+    part = high - total
+    residual = (total - (high - part)) + (low - part)
+    return high, tl.where(tl.abs(high) < float("inf"), residual, 0.0)
+
+
+@triton.jit(do_not_specialize=["num_rows", "part_stride", "alpha"])
+def _project_kernel(
+    source,
+    direction,
+    scales,
+    output,
+    num_rows,
+    part_stride,
+    alpha,
+    HIDDEN: tl.constexpr,
+    WORLD: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    scale = tl.load(scales + row).to(tl.float32)
+    # A single writer can be left byte-for-byte intact. Rank parts must be
+    # materialized even at zero dose, with the existing BF16 sum boundary.
+    if (WORLD != 1) | ((scale != 0.0) & (alpha != 0.0)):
+        h = tl.arange(0, BLOCK)
+        value = tl.load(source + row * HIDDEN + h, h < HIDDEN, other=0).to(tl.float32)
+        for rank in tl.static_range(1, WORLD):
+            value = value + tl.load(
+                source + rank * part_stride + row * HIDDEN + h, h < HIDDEN, other=0
+            ).to(tl.float32)
+        value = value.to(tl.bfloat16).to(tl.float32)
+        if (scale != 0.0) & (alpha != 0.0):
+            d = tl.load(direction + h, h < HIDDEN, other=0).to(tl.float32)
+            product = value * d
+            residual = tl.fma(value, d, -product)
+            residual = tl.where(tl.abs(product) < float("inf"), residual, 0.0)
+            dot_hi, dot_lo = tl.reduce(
+                (product, residual), axis=0, combine_fn=_sum_pair
+            )
+            if tl.abs(dot_hi) < float("inf"):
+                factor = scale * alpha
+                factor_lo = tl.fma(scale, alpha, -factor)
+                coefficient = factor * d
+                coefficient_lo = tl.fma(factor, d, -coefficient) + factor_lo * d
+                correction = (
+                    coefficient * dot_lo + coefficient_lo * dot_hi
+                ) + coefficient_lo * dot_lo
+                value = tl.fma(-coefficient, dot_hi, value) - correction
+            else:
+                value = value - ((scale * alpha) * d) * dot_hi
+        tl.store(output + row * HIDDEN + h, value.to(tl.bfloat16), h < HIDDEN)
+
+
+def _warmup_inputs(*, hidden, world, scales_aligned):
+    return triton_warmup_inputs(
+        _project_kernel,
+        TritonWarmupTensor(torch.bfloat16),
+        TritonWarmupTensor(torch.float32),
+        TritonWarmupTensor(torch.float32, aligned=scales_aligned),
+        TritonWarmupTensor(torch.bfloat16),
+        128,
+        128 * hidden,
+        2.5,
+        HIDDEN=hidden,
+        WORLD=world,
+        BLOCK=triton.next_power_of_2(hidden),
+        grid=(128,),
+        num_warps=8,
+        enable_fp_fusion=False,
+    )
+
+
+_launcher = triton_kernel_dispatcher_with_warmup(warmup_inputs=_warmup_inputs)(
+    _project_kernel
+)
+
+
+def register_projection_warmups(hidden, worlds=(1, 4)):
+    for world in worlds:
+        for scales_aligned in (True, False):
+            _launcher.register_warmup(
+                hidden=hidden, world=world, scales_aligned=scales_aligned
+            )
+
+
+def _launch(source, direction, scales, output, alpha, world):
+    rows, hidden = output.shape
+    if (
+        output.dtype != torch.bfloat16
+        or source.dtype != torch.bfloat16
+        or direction.dtype != torch.float32
+        or scales.dtype != torch.float32
+        or scales.numel() != rows
+        or direction.numel() != hidden
+        or not source.is_contiguous()
+        or not output.is_contiguous()
+        or not direction.is_contiguous()
+        or not scales.is_contiguous()
+    ):
+        raise ValueError("Invalid steering projection tensor geometry/dtype/layout")
+    if rows:
+        _launcher[(rows,)](
+            source,
+            direction,
+            scales,
+            output,
+            rows,
+            source.stride(0) if world != 1 else 0,
+            alpha,
+            HIDDEN=hidden,
+            WORLD=world,
+            BLOCK=triton.next_power_of_2(hidden),
+            num_warps=8,
+            enable_fp_fusion=False,
+        )
+
+
+@torch.library.custom_op("ds41_steering::project_writer", mutates_args=("writer",))
+def project_writer(
+    writer: torch.Tensor, direction: torch.Tensor, scales: torch.Tensor, alpha: float
+) -> None:
+    _launch(writer, direction, scales, writer, alpha, 1)
+
+
+@project_writer.register_fake
+def _project_writer_fake(writer, direction, scales, alpha):
+    return None
+
+
+@torch.library.custom_op("ds41_steering::project_parts", mutates_args=("output",))
+def project_parts(
+    parts: torch.Tensor,
+    direction: torch.Tensor,
+    scales: torch.Tensor,
+    output: torch.Tensor,
+    alpha: float,
+) -> None:
+    if parts.ndim != 3 or parts.shape[0] != 4 or parts.shape[1:] != output.shape:
+        raise ValueError("Steering expects four rank-order parts of the output rows")
+    _launch(parts, direction, scales, output, alpha, 4)
+
+
+@project_parts.register_fake
+def _project_parts_fake(parts, direction, scales, output, alpha):
+    return None
+
+
+def apply_projection(writer, direction, scales, scratch, alpha):
+    if scales is None or scratch is None:
+        raise ValueError("Loaded steering profile requires explicit row controls")
+    from vllm.models.deepseek_v4_1.tilelang.collectives import RankOrderParts
+
+    if isinstance(writer, RankOrderParts):
+        output = scratch[: writer.shape[0]]
+        project_parts(writer.packed, direction, scales, output, alpha)
+        return output
+    project_writer(writer, direction, scales, alpha)
+    return writer
+
+
+@triton.jit(do_not_specialize=["part_stride"])
+def _dot_kernel(
+    source,
+    direction,
+    scales,
+    dots,
+    part_stride,
+    HIDDEN: tl.constexpr,
+    WORLD: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    # Inactive rows do not read the writer, direction or dot workspace. The
+    # consumer takes the same branch before reading either component.
+    if tl.load(scales + row) != 0.0:
+        h = tl.arange(0, BLOCK)
+        value = tl.load(source + row * HIDDEN + h, h < HIDDEN, other=0).to(tl.float32)
+        for rank in tl.static_range(1, WORLD):
+            value = value + tl.load(
+                source + rank * part_stride + row * HIDDEN + h, h < HIDDEN, other=0
+            ).to(tl.float32)
+        value = value.to(tl.bfloat16).to(tl.float32)
+        d = tl.load(direction + h, h < HIDDEN, other=0).to(tl.float32)
+        product = value * d
+        residual = tl.fma(value, d, -product)
+        residual = tl.where(tl.abs(product) < float("inf"), residual, 0.0)
+        hi, lo = tl.reduce((product, residual), axis=0, combine_fn=_sum_pair)
+        tl.store(dots + row * 2, hi)
+        tl.store(dots + row * 2 + 1, lo)
+
+
+def _dot_warmup_inputs(*, hidden, world, scales_aligned):
+    return triton_warmup_inputs(
+        _dot_kernel,
+        TritonWarmupTensor(torch.bfloat16),
+        TritonWarmupTensor(torch.float32),
+        TritonWarmupTensor(torch.float32, aligned=scales_aligned),
+        TritonWarmupTensor(torch.float32),
+        128 * hidden if world != 1 else 0,
+        HIDDEN=hidden,
+        WORLD=world,
+        BLOCK=triton.next_power_of_2(hidden),
+        grid=(128,),
+        num_warps=8,
+        enable_fp_fusion=False,
+    )
+
+
+_dot_launcher = triton_kernel_dispatcher_with_warmup(warmup_inputs=_dot_warmup_inputs)(
+    _dot_kernel
+)
+
+
+def register_dot_warmups(hidden):
+    for world in (1,):
+        for aligned in (True, False):
+            _dot_launcher.register_warmup(
+                hidden=hidden, world=world, scales_aligned=aligned
+            )
+
+
+@torch.library.custom_op("ds41_steering::projection_dot", mutates_args=("dots",))
+def projection_dot(
+    source: torch.Tensor,
+    direction: torch.Tensor,
+    scales: torch.Tensor,
+    dots: torch.Tensor,
+) -> None:
+    world, rows, hidden = source.shape
+    if (
+        world not in (1, 4)
+        or source.dtype != torch.bfloat16
+        or direction.dtype != torch.float32
+        or scales.dtype != torch.float32
+        or dots.dtype != torch.float32
+        or direction.shape != (hidden,)
+        or scales.shape != (rows,)
+        or dots.shape != (rows, 2)
+        or any(not t.is_contiguous() for t in (source, direction, scales, dots))
+        or any(t.device != source.device for t in (direction, scales, dots))
+    ):
+        raise ValueError("Invalid steering dot tensor geometry/dtype/layout/device")
+    if rows:
+        _dot_launcher[(rows,)](
+            source,
+            direction,
+            scales,
+            dots,
+            source.stride(0) if world != 1 else 0,
+            HIDDEN=hidden,
+            WORLD=world,
+            BLOCK=triton.next_power_of_2(hidden),
+            num_warps=8,
+            enable_fp_fusion=False,
+        )
+
+
+@projection_dot.register_fake
+def _projection_dot_fake(source, direction, scales, dots):
+    return None
+
+
+def projection_dots(writer, direction, scales, dots):
+    if scales is None or dots is None:
+        raise ValueError("Active steering requires explicit row controls")
+    from vllm.models.deepseek_v4_1.tilelang.collectives import RankOrderParts
+
+    source = (
+        writer.packed if isinstance(writer, RankOrderParts) else writer.unsqueeze(0)
+    )
