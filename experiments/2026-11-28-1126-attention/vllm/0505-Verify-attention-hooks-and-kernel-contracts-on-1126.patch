+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import hashlib
+import json
+import struct
+
+import numpy as np
+import pytest
+
+from tests.models.steering_test_support import make_profile
+
+# The helper installs this isolated package before its contracts are imported.
+# isort: off
+from ds41_steering_test.profile import load_profile
+from ds41_steering_test import artifact
+# isort: on
+
+
+def test_profile_identity_and_readonly_payload(tmp_path):
+    path, digest = make_profile(tmp_path)
+    p = load_profile(
+        path,
+        digest,
+        expected_model_identity="b" * 64,
+        expected_template_identity="c" * 64,
+    )
+    assert p.layers == (2, 3) and p.hidden_size == 8
+    assert p.directions.dtype == np.float32
+    assert not p.directions.flags.writeable
+    assert len(p.identity) == 64
+    with pytest.raises(ValueError):
+        load_profile(path, digest, expected_model_identity="e" * 64)
+    with pytest.raises(ValueError):
+        load_profile(path, digest, expected_template_identity="e" * 64)
+    p2 = load_profile(
+        *make_profile(tmp_path, changes={"alphas": [1.0, 2.5]}, suffix="2")
+    )
+    assert p2.schedule_sha256 != p.schedule_sha256
+    assert p2.identity != p.identity
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"schema_version": True},
+        {"schema_version": 2},
+        {"operator_version": "unknown"},
+        {"profile_name": "../bad"},
+        {"model.revision": "wrong"},
+        {"model.weight_set": "bad"},
+        {"model.chat_template_sha256": None},
+        {"layers": []},
+        {"layers": [2, 2]},
+        {"layers": [3, 2]},
+        {"layers": [True, 3]},
+        {"layers": [-1, 3]},
+        {"layers": [2, 6]},
+        {"alphas": [2.5]},
+        {"alphas": [True, 2.5]},
+        {"alphas": [float("nan"), 2.5]},
+        {"alphas": [float("inf"), 2.5]},
+        {"alphas": [4.00000001, 2.5]},
+        {"model.hidden_size": True},
+        {"model.layer_count": 257},
+        {"directions.sha256": "0" * 64},
+        {"provenance": {}},
+        {"unexpected": 1},
+    ],
+)
+def test_invalid_metadata(tmp_path, changes):
+    with pytest.raises(ValueError):
+        load_profile(*make_profile(tmp_path, changes=changes))
+
+
+@pytest.mark.parametrize("mode", ["zero", "nonunit", "nan", "inf", "shape", "dtype"])
+def test_invalid_directions(tmp_path, mode):
+    d = np.eye(8, dtype=np.float32)[2:4].copy()
+    if mode == "zero":
+        d[0] = 0
+    if mode == "nonunit":
+        d[0] *= 2
+    if mode == "nan":
+        d[0, 0] = np.nan
+    if mode == "inf":
+        d[0, 0] = np.inf
+    if mode == "shape":
+        d = d[:, :4]
+    if mode == "dtype":
+        d = d.astype(np.float16)
+    with pytest.raises(ValueError):
+        load_profile(*make_profile(tmp_path, directions=d))
+
+
+def test_corrupt_truncated_trailing_and_duplicate_header(tmp_path):
+    path, digest = make_profile(tmp_path)
+    original = path.read_bytes()
+    path.write_bytes(original[:-1])
+    with pytest.raises(ValueError):
+        load_profile(path, digest)
+    data = original + b"extra"
+    path.write_bytes(data)
+    with pytest.raises(ValueError):
+        load_profile(path, hashlib.sha256(data).hexdigest())
+    size = struct.unpack("<Q", original[:8])[0]
+    header = json.loads(original[8 : 8 + size])
+    text = json.dumps(header)[:-1] + ',"directions":{}}'
+    raw = text.encode()
+    raw += b" " * (-len(raw) % 8)
+    data = struct.pack("<Q", len(raw)) + raw + original[8 + size :]
+    path.write_bytes(data)
+    with pytest.raises(ValueError, match="[Dd]uplicate"):
+        load_profile(path, hashlib.sha256(data).hexdigest())
+
+
+def test_materialization_preserves_exact_manifest_and_repackages_identically(tmp_path):
+    path, digest = make_profile(tmp_path)
+    manifest, payload, raw = artifact.read_artifact(path, digest)
+    source = tmp_path / "source"
+    source.mkdir()
+    raw += b"\n\n"
+    (source / "manifest.json").write_bytes(raw)
+    (source / "directions.f32").write_bytes(payload)
+    first, second = tmp_path / "first.safetensors", tmp_path / "second.safetensors"
+    artifact.pack(source, first)
+    artifact.pack(source, second)
+    assert first.read_bytes() == second.read_bytes()
+    destination = tmp_path / "materialized"
+    assert artifact.unpack(first, destination) == manifest
+    assert (destination / "manifest.json").read_bytes() == raw
+    assert (destination / "directions.f32").read_bytes() == payload
+    assert artifact.unpack(first, destination) == manifest
+    artifact.pack(destination, second)
+    assert first.read_bytes() == second.read_bytes()
+    got = load_profile(first, hashlib.sha256(first.read_bytes()).hexdigest())
+    assert got.manifest_sha256 == hashlib.sha256(raw).hexdigest()
+    assert load_profile(destination, got.manifest_sha256).identity == got.identity
+    with pytest.raises(ValueError, match="manifest SHA-256"):
+        load_profile(destination, "0" * 64)
+    assert got.identity != load_profile(path, digest).identity
+    assert got.schedule_sha256 == load_profile(path, digest).schedule_sha256
+    (destination / "manifest.json").write_bytes(b"previous")
+    with pytest.raises(ValueError, match="different profile"):
+        artifact.unpack(first, destination)
+    assert (destination / "manifest.json").read_bytes() == b"previous"
+
+
+def test_imported_provenance_records_unknown_datasets_without_inventing_extraction(
+    tmp_path,
+):
+    imported = {
+        "kind": "imported",
+        "source": {
+            "repository": "synthetic/test",
+            "revision": "d" * 40,
+            "license": "synthetic-test",
+            "directions": {"file": "d.pt", "sha256": "e" * 64, "tensor": "projected"},
+            "schedule": {"file": "s.txt", "sha256": "f" * 64, "value": "attention"},
+        },
+        "conversion": {"tool": "synthetic-test", "sha256": "0" * 64},
+        "dataset_manifests": None,
+    }
+    path, digest = make_profile(tmp_path, changes={"provenance": imported})
+    assert load_profile(path, digest).profile_id == "test-profile"
+    for changes in (
+        {"provenance": {**imported, "extraction_commit": "unknown"}},
+        {"provenance": {**imported, "dataset_manifests": {}}},
+        {"provenance": {**imported, "kind": "unknown"}},
+        {"scope": "full"},
+        {"scope": "shared"},
+        {"model.tokenizer_revision": "wrong"},
+    ):
+        with pytest.raises(ValueError):
+            load_profile(*make_profile(tmp_path, changes=changes))
+
+
+def test_explicit_extension_rejects_legacy_envelopes_and_tampered_manifest(tmp_path):
+    path, digest = make_profile(tmp_path)
+    original = path.read_bytes()
+    n = struct.unpack("<Q", original[:8])[0]
+    header = json.loads(original[8 : 8 + n])
+    for metadata in (
+        {"ds41_steering": "{}"},
+        {**header["__metadata__"], "format": "gr8-steering-profile-v1"},
+        {**header["__metadata__"], "manifest_sha256": "0" * 64},
+        {
+            **header["__metadata__"],
+            "gr8_manifest": header["__metadata__"]["gr8_manifest"] + "\n",
+        },
+    ):
+        raw = json.dumps({**header, "__metadata__": metadata}).encode()
+        raw += b" " * (-len(raw) % 8)
+        data = struct.pack("<Q", len(raw)) + raw + original[8 + n :]
+        path.write_bytes(data)
+        with pytest.raises(ValueError):
+            load_profile(path, hashlib.sha256(data).hexdigest())
+
+
+def test_alphas_are_canonical_fp32_and_zero_is_valid(tmp_path):
+    profile = load_profile(*make_profile(tmp_path, changes={"alphas": [0, 1.1]}))
+    assert profile.alphas == (0, struct.unpack("<f", struct.pack("<f", 1.1))[0])
+    with pytest.raises(ValueError, match="tokenizer_revision"):
+        load_profile(*make_profile(tmp_path), expected_tokenizer_revision="e" * 40)
+
+
+def test_bundled_selection_checks_index_name_size_and_content(tmp_path):
+    path, digest = make_profile(tmp_path)
+    release = tmp_path / "release"
+    (release / "steering").mkdir(parents=True)
+    bundled = release / "steering/test-profile.safetensors"
+    bundled.write_bytes(path.read_bytes())
+    record = {
+        "name": "test-profile",
+        "file": "steering/test-profile.safetensors",
+        "sha256": digest,
+        "byte_count": bundled.stat().st_size,
+    }
+    index = {
+        "schema_version": 1,
+        "default_profile": "test-profile",
+        "profiles": [record],
+    }
+    index_path = release / "steering/index.json"
+    index_path.write_text(json.dumps(index))
+    for selector in ("hf:default", "hf:test-profile"):
+        name, selected, got_digest = artifact.resolve_bundled(release, selector)
+        assert (name, got_digest) == ("test-profile", digest)
+        assert load_profile(selected, digest).profile_id == name
+    for changed in (
+        {**index, "default_profile": "missing"},
+        {**index, "schema_version": True},
+        {**index, "profiles": [record, record]},
+        {**index, "profiles": [{**record, "file": "../profile.safetensors"}]},
+        {**index, "profiles": [{**record, "byte_count": True}]},
+        {**index, "profiles": [{**record, "byte_count": record["byte_count"] + 1}]},
+        {**index, "profiles": [{**record, "sha256": "0" * 64}]},
+    ):
+        index_path.write_text(json.dumps(changed))
+        with pytest.raises(ValueError):
+            artifact.resolve_bundled(release, "hf:default")
+    index_path.write_text(json.dumps(index))
+    with pytest.raises(ValueError, match="not listed"):
+        artifact.resolve_bundled(release, "hf:missing")
+
+
+@pytest.mark.parametrize("scale", [0, 1, 4])
+def test_1022_template_rebinding_separates_active_prefix_cache(tmp_path, scale):
+    from ds41_steering_test.cache import steering_cache_salt
+    from ds41_steering_test.request import parse_selection
+
+    old_path, old_sha = make_profile(tmp_path)
+    new_path, new_sha = make_profile(
+        tmp_path, changes={"model.chat_template_sha256": "e" * 64}, suffix="-1022"
+    )
+    old = load_profile(old_path, old_sha, expected_template_identity="c" * 64)
+    new = load_profile(new_path, new_sha, expected_template_identity="e" * 64)
+    assert old.directions.tobytes() == new.directions.tobytes()
+    assert old.schedule_sha256 == new.schedule_sha256
+    assert old.identity != new.identity
+    with pytest.raises(ValueError, match="chat_template_sha256 identity mismatch"):
+        load_profile(old_path, old_sha, expected_template_identity="e" * 64)
+    with pytest.raises(ValueError, match="chat_template_sha256 identity mismatch"):
+        load_profile(new_path, new_sha, expected_template_identity="c" * 64)
+    args = {"steering_profile": old.profile_id, "steering_scale": scale}
+    before = steering_cache_salt("caller", parse_selection(args, old))
+    after = steering_cache_salt("caller", parse_selection(args, new))
+    if scale:
+        assert before != after
+    else:
+        assert before == after == "caller"
