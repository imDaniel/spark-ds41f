+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Load CPU contracts without importing the CUDA model package initializer."""
+
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+from safetensors.numpy import save
+
+ROOT = Path(__file__).resolve().parents[2]
+PACKAGE = ROOT / "vllm/models/deepseek_v4_1/steering"
+if "ds41_steering_test" not in sys.modules:
+    spec = importlib.util.spec_from_file_location(
+        "ds41_steering_test",
+        PACKAGE / "__init__.py",
+        submodule_search_locations=[str(PACKAGE)],
+    )
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+
+from ds41_steering_test.profile import OPERATOR_VERSION, load_profile  # noqa: E402
+
+
+def make_profile(
+    tmp_path, *, changes=None, directions=None, suffix="", dtype="float32"
+):
+    if directions is None:
+        directions = np.eye(8, dtype=dtype)[2:4]
+    metadata = {
+        "schema_version": 1,
+        "operator_version": OPERATOR_VERSION,
+        "profile_name": "test-profile",
+        "model": {
+            "name": "deepseek-v4.1-flash-1017",
+            "revision": "a" * 40,
+            "weight_set": "b" * 64,
+            "tokenizer_revision": "a" * 40,
+            "chat_template_sha256": "c" * 64,
+            "hidden_size": 8,
+            "layer_count": 6,
+        },
+        "scope": "attention",
+        "layers": [2, 3],
+        "alphas": [2.5, 2.5],
+        "directions": {
+            "file": "directions.f32",
+            "dtype": "float32-le",
+            "byte_count": directions.nbytes,
+            "sha256": hashlib.sha256(directions.tobytes()).hexdigest(),
+        },
+        "provenance": {
+            "kind": "extracted",
+            "extraction_tool": "synthetic-test",
+            "extraction_commit": "synthetic-test",
+            "dataset_manifests": {
+                "train": "1" * 64,
+                "validation": "2" * 64,
+                "final": "3" * 64,
+            },
+        },
+    }
+    for key, value in (changes or {}).items():
+        parts = key.split(".")
+        target = metadata
+        for part in parts[:-1]:
+            target = target[part]
+        target[parts[-1]] = value
+    manifest_raw = json.dumps(metadata, allow_nan=True)
+    data = save(
+        {"directions": directions},
+        metadata={
+            "format": "gr8-steering-profile-v1+ds41-attention-v1",
+            "gr8_manifest": manifest_raw,
+            "manifest_sha256": hashlib.sha256(manifest_raw.encode()).hexdigest(),
+        },
+    )
+    path = tmp_path / ("profile" + suffix + ".safetensors")
+    path.write_bytes(data)
+    digest = hashlib.sha256(data).hexdigest()
+    return path, digest
+
+
+def valid_profile(tmp_path):
+    return load_profile(*make_profile(tmp_path))
