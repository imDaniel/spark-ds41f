+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from tests.models.steering_test_support import valid_profile
+from vllm.exceptions import VLLMValidationError
+
+# The helper installs this isolated package before its contracts are imported.
+# isort: off
+from ds41_steering_test.cache import steering_cache_salt
+from ds41_steering_test.config import admit
+from ds41_steering_test.request import STOCK, parse_selection
+# isort: on
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        True,
+        False,
+        "0.5",
+        float("nan"),
+        float("inf"),
+        -1e-100,
+        4.00000000001,
+        10**500,
+    ],
+)
+def test_scale_rejects_before_float32_rounding(tmp_path, value):
+    with pytest.raises(ValueError):
+        parse_selection(
+            {"steering_profile": "test-profile", "steering_scale": value},
+            valid_profile(tmp_path),
+        )
+
+
+def test_named_default_zero_and_unknown(tmp_path):
+    p = valid_profile(tmp_path)
+    assert parse_selection(None, p) == STOCK
+    assert (
+        parse_selection({"steering_profile": None, "steering_scale": None}, p) == STOCK
+    )
+    assert parse_selection({"steering_profile": p.profile_id}, p).scale == 1
+    assert (
+        parse_selection(
+            {"steering_profile": p.profile_id, "steering_scale": None}, p
+        ).scale
+        == 1
+    )
+    assert parse_selection({"steering_profile": None, "steering_scale": 0}, p) == STOCK
+    for scale in [0, -0.0, 1e-100]:
+        assert (
+            parse_selection(
+                {"steering_profile": p.profile_id, "steering_scale": scale}, p
+            )
+            == STOCK
+        )
+    assert parse_selection({"steering_scale": 0}, None) == STOCK
+    assert parse_selection({"steering_scale": 1e-100}, None) == STOCK
+    assert (
+        parse_selection(
+            {"steering_profile": p.profile_id, "steering_scale": 4}, p
+        ).scale
+        == 4
+    )
+    for args in [
+        {"steering_scale": 0.1},
+        {"steering_profile": "bad", "steering_scale": 0},
+    ]:
+        with pytest.raises(ValueError):
+            parse_selection(args, p)
+    with pytest.raises(ValueError):
+        parse_selection({"steering_profile": p.profile_id, "steering_scale": 0}, None)
+
+
+def test_cache_identity_and_admission_do_not_mutate_caller(tmp_path):
+    p = valid_profile(tmp_path)
+    args = {"steering_profile": p.profile_id, "steering_scale": 0.5, "other": 7}
+    clone = SimpleNamespace(extra_args=args)
+    salt = admit(clone, p, "caller")
+    assert args == {"steering_profile": p.profile_id, "steering_scale": 0.5, "other": 7}
+    assert clone.extra_args is not args
+    assert salt != "caller"
+    a = parse_selection(args, p)
+    b = parse_selection({**args, "steering_scale": 0.50000000000001}, p)
+    assert a == b and steering_cache_salt("caller", a) == steering_cache_salt(
+        "caller", b
+    )
+    assert len({steering_cache_salt(x, a) for x in [None, "", "caller", "other"]}) == 4
+    assert steering_cache_salt(None, STOCK) is None
+    assert steering_cache_salt("caller", STOCK) == "caller"
+    c = parse_selection({**args, "steering_scale": 0.75}, p)
+    assert steering_cache_salt("caller", c) != salt
+    for kw in [{"resumable": True}, {"session_id": "existing"}]:
+        with pytest.raises(VLLMValidationError):
+            admit(clone, p, "caller", **kw)
+    # Ordinary streamed HTTP responses do not set resumable/session_id.
+    assert admit(clone, p, "caller", resumable=False) == salt
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        {"steering_profile": "test-profile", "steering_scale": "0.5"},
+        {"steering_profile": "test-profile", "steering_scale": -0.01},
+        {"steering_profile": "test-profile", "steering_scale": 4.01},
+        {"steering_profile": "test-profile", "steering_scale": float("nan")},
+        {"steering_profile": "test-profile", "steering_scale": float("inf")},
+        {"steering_profile": "unknown", "steering_scale": 0},
+        {"steering_scale": 0.5},
+    ],
+)
+def test_admission_errors_keep_the_client_error_classification(tmp_path, args):
+    from vllm.exceptions import VLLMClientError
+
+    with pytest.raises(VLLMClientError) as caught:
+        admit(SimpleNamespace(extra_args=args), valid_profile(tmp_path), "caller")
+    assert caught.value.parameter in ("steering_profile", "steering_scale")
+
+
+@pytest.fixture(scope="module")
+def wire_request():
+    # Load the real wire base without importing FastAPI's serving initializer.
+    path = (
+        Path(__file__).resolve().parents[2]
+        / "vllm/entrypoints/serve/engine/protocol.py"
+    )
+    spec = importlib.util.spec_from_file_location("steering_wire_contract", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+
+    class Request(module.SteeringRequest):
+        use_beam_search: bool = False
+        vllm_xargs: dict[str, str | int | float | list[str | int | float]] | None = None
+
+    return Request
+
+
+def test_top_level_fields_reach_admission_and_roundtrip(wire_request, tmp_path):
+    profile = valid_profile(tmp_path)
+    original = {"unrelated_plugin": True}
+    request = wire_request(
+        steering_profile=profile.profile_id, steering_scale=2.5, vllm_xargs=original
+    )
+    assert original == {"unrelated_plugin": True}
+    selection = parse_selection(request.vllm_xargs, profile)
+    assert selection.scale == 2.5
+    assert (
+        wire_request.model_validate(request.model_dump()).vllm_xargs
+        == request.vllm_xargs
+    )
+    assert request.vllm_xargs["unrelated_plugin"] == 1
+    for key, value in (("steering_scale", 3), ("steering_profile", "other")):
+        with pytest.raises(ValueError, match="Conflicting"):
+            wire_request(
+                steering_profile=profile.profile_id,
+                steering_scale=2.5,
+                vllm_xargs={key: value},
+            )
+
+
+def test_wire_nulls_match_absence_without_coercing_non_numeric_values(
+    wire_request, tmp_path
+):
+    profile = valid_profile(tmp_path)
+    for body in (
+        {},
+        {"steering_profile": None, "steering_scale": None},
+        {"vllm_xargs": {"steering_profile": None, "steering_scale": None}},
+        {"steering_scale": 1e-50},
+    ):
+        assert parse_selection(wire_request(**body).vllm_xargs, None) == STOCK
+    request = wire_request(steering_profile=profile.profile_id, steering_scale=None)
+    assert parse_selection(request.vllm_xargs, profile).scale == 1
+    for value in (True, False, "0.5", [], {}):
+        with pytest.raises(ValueError):
+            wire_request(steering_profile=profile.profile_id, steering_scale=value)
+    for value in (True, False):
+        with pytest.raises(ValueError, match="steering_scale"):
+            wire_request(vllm_xargs={"steering_scale": value})
+
+
+def test_unqualified_request_paths_reject_instead_of_dropping_steering(wire_request):
+    with pytest.raises(ValueError, match="beam search"):
+        wire_request(use_beam_search=True, steering_profile="test-profile")
+    assert wire_request(use_beam_search=True).use_beam_search
+    base = wire_request.__bases__[0].__bases__[0]
+    for body in (
+        {"steering_profile": "test-profile"},
+        {"vllm_xargs": {"steering_scale": 0.5}},
+    ):
+        with pytest.raises(ValueError, match="not supported"):
+            base(**body)
+
+
+@pytest.mark.parametrize("variable", ["WEIGHTLESS_STEER_PATH", "WEIGHTLESS_STEER_MODEL"])
+def test_configured_attention_rejects_glp_at_startup(monkeypatch, variable):
+    from ds41_steering_test.config import OPERATOR_VERSION, load_configured_profile
+
+    monkeypatch.setenv(variable, "configured")
+    settings = {"schema_version": 1, "operator_version": OPERATOR_VERSION,
+                "profile_path": "/steering/profile", "profile_sha256": "1" * 64}
+    with pytest.raises(ValueError, match="GLP and attention"):
+        load_configured_profile(SimpleNamespace(additional_config={"ds41_steering": settings}))
+    assert load_configured_profile(SimpleNamespace(additional_config={})) is None
