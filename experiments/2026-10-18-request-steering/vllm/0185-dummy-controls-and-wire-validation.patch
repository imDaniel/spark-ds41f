@@ -13,6 +13,7 @@ from tests.models.steering_test_support import valid_profile
 from ds41_steering_test.runtime import SteeringRuntime
 # isort: on
 
+
 def test_fixed_buffers_cancel_reuse_and_many_scales(tmp_path):
     p = valid_profile(tmp_path)
     state = SteeringRuntime(p, 4, 16, "cpu")
@@ -63,3 +64,24 @@ def test_stream_update_same_identity_and_reject_change(tmp_path):
     assert not state.dummy(8).any()
     with pytest.raises(ValueError):
         state.dummy(17)
+
+
+def test_profiling_dummy_is_explicit_and_preserves_live_request(tmp_path):
+    profile = valid_profile(tmp_path)
+    state = SteeringRuntime(profile, 4, 16, "cpu")
+    state.add_request(0, "live", {"steering_profile": profile.profile_id})
+    dummy = SimpleNamespace(num_tokens_after_padding=8, is_dummy=True)
+    state.row_scales.fill_(1)
+    assert not state.prepare(dummy).any()
+    assert state.request_scales[0] == 1
+    assert list(state.requests) == ["live"]
+    # Unknown real requests must still fail, even during an otherwise idle batch.
+    with pytest.raises(ValueError, match="unregistered"):
+        state.prepare(
+            SimpleNamespace(
+                num_tokens_after_padding=8,
+                num_reqs=1,
+                req_ids=["_dummy_req_0"],
+                is_dummy=False,
+            )
+        )
diff --git a/vllm/entrypoints/serve/engine/protocol.py b/vllm/entrypoints/serve/engine/protocol.py
index 704d6b245..cc875a943 100644
--- a/vllm/entrypoints/serve/engine/protocol.py
+++ b/vllm/entrypoints/serve/engine/protocol.py
@@ -44,6 +44,10 @@ class OpenAIBaseModel(BaseModel):
     @model_validator(mode="wrap")
     @classmethod
     def __log_extra_fields__(cls, data, handler):
+        if isinstance(data, dict) and "vllm_xargs" in cls.model_fields:
+            xargs = data.get("vllm_xargs")
+            if isinstance(xargs, dict) and type(xargs.get("steering_scale")) is bool:
+                raise ValueError("steering_scale must be a number, not a boolean")
         result = handler(data)
         if not isinstance(data, dict):
             return result
diff --git a/vllm/models/deepseek_v4_1/steering/runtime.py b/vllm/models/deepseek_v4_1/steering/runtime.py
index 52b80debb..fb793332e 100644
--- a/vllm/models/deepseek_v4_1/steering/runtime.py
+++ b/vllm/models/deepseek_v4_1/steering/runtime.py
@@ -56,6 +56,8 @@ class SteeringRuntime:
 
     def prepare(self, batch):
         n = batch.num_tokens_after_padding
+        if getattr(batch, "is_dummy", False):
+            return self.dummy(n)
         if n > self.row_scales.numel() or batch.num_reqs > self.request_scales.numel():
             raise ValueError("Steering batch exceeds preallocated controls")
         if any(req not in self.requests for req in batch.req_ids):
