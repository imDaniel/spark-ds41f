From 9ca5caaf3e8d13fb8595f06116bde8f1e869b675 Mon Sep 17 00:00:00 2001
From: Daniel <2660793+imDaniel@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:41:52 +0900
Subject: [PATCH] Separate profiling controls and validate raw steering
 booleans

Base: f12d86dd93543fa335d821aab75f93b6889db712 replayed steering runtime. Rationale: the real V2 memory profile uses unregistered dummy requests through prepare_inputs; mark make_dummy batches explicitly and use zero controls without weakening live-request ownership. Reject wire booleans before the generic OpenAI extra-argument union coerces them into integers. Quality: live controls survive profiling and unrelated extra args keep their existing behavior. Validation: 70 CPU contracts pass; two integration regressions added for native InputBatch and chat/completion protocol. Synthetic numerical and graph gates passed on the previous runtime. Upstream status: independent downstream experiment; no upstream submission.
---
 .../models/test_deepseek_v4_1_steering_gpu.py | 55 +++++++++++++++++++
 .../test_deepseek_v4_1_steering_state.py      | 22 ++++++++
 vllm/entrypoints/serve/engine/protocol.py     |  4 ++
 vllm/models/deepseek_v4_1/steering/runtime.py |  2 +
 vllm/v1/worker/gpu/input_batch.py             |  4 ++
 5 files changed, 87 insertions(+)

diff --git a/tests/models/test_deepseek_v4_1_steering_gpu.py b/tests/models/test_deepseek_v4_1_steering_gpu.py
index f1dd145e5..16d8ba384 100644
--- a/tests/models/test_deepseek_v4_1_steering_gpu.py
+++ b/tests/models/test_deepseek_v4_1_steering_gpu.py
@@ -97,3 +97,58 @@ def test_rows_graph_replay_reuses_controls_and_output(kernels):
         expected = project_reference(source, direction, expected_scales, 2.5)
         torch.testing.assert_close(writer, expected, rtol=0.016, atol=0.0001)
         assert pointers == [t.data_ptr() for t in (writer, requests, rows)]
+
+
+def test_native_dummy_batch_does_not_own_real_slots(kernels):
+    from types import SimpleNamespace
+
+    from vllm.models.deepseek_v4_1.steering.runtime import SteeringRuntime
+    from vllm.v1.worker.gpu.input_batch import InputBatch, InputBuffers
+
+    runtime = SteeringRuntime(
+        SimpleNamespace(profile_id="p", identity="a" * 64, hidden_size=5120),
+        4,
+        32,
+        "cuda",
+    )
+    runtime.add_request(0, "live", {"steering_profile": "p", "steering_scale": 0.75})
+    batch = InputBatch.make_dummy(1, 16, InputBuffers(4, 32, torch.device("cuda")))
+    assert batch.is_dummy
+    assert not runtime.prepare(batch).any()
+    batch.is_dummy = False
+    batch.is_padding.fill_(False)
+    batch.req_ids = ["live"]
+    assert (runtime.prepare(batch) == 0.75).all()
+    batch.req_ids = ["_dummy_req_0"]
+    with pytest.raises(ValueError, match="unregistered"):
+        runtime.prepare(batch)
+
+
+def test_openai_wire_boolean_is_not_coerced_into_a_dose():
+    from pydantic import ValidationError
+
+    from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+    from vllm.entrypoints.openai.completion.protocol import CompletionRequest
+
+    for model, prompt in (
+        (ChatCompletionRequest, {"messages": [{"role": "user", "content": "hi"}]}),
+        (CompletionRequest, {"prompt": "hi"}),
+    ):
+        for value in (True, False):
+            with pytest.raises(ValidationError, match="steering_scale"):
+                model(
+                    model="test",
+                    **prompt,
+                    vllm_xargs={"steering_profile": "p", "steering_scale": value},
+                )
+        valid = model(
+            model="test",
+            **prompt,
+            vllm_xargs={
+                "steering_profile": "p",
+                "steering_scale": 0.5,
+                "unrelated_plugin": True,
+            },
+        )
+        assert valid.vllm_xargs["steering_scale"] == 0.5
+        assert valid.vllm_xargs["unrelated_plugin"] == 1
diff --git a/tests/models/test_deepseek_v4_1_steering_state.py b/tests/models/test_deepseek_v4_1_steering_state.py
