+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Synthetic GPU contract checks, independent of checkpoint behavioral scores."""
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+
+
+@pytest.fixture(scope="module")
+def kernels():
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+    from vllm.models.deepseek_v4_1.steering import ops, row_kernel
+
+    registry = JitWarmupRegistry(None)
+    with registry.activate():
+        ops.register_projection_warmups(5120)
+        row_kernel.register_row_warmup()
+    registry.warmup()
+    return ops, row_kernel
+
+
+@pytest.mark.parametrize("rows", [1, 3, 16, 96, 127, 128, 129, 205, 8191, 8192])
+@pytest.mark.parametrize("world", [1, 4])
+def test_projection_fp64_oracle_and_stock_rows(kernels, rows, world):
+    from vllm.models.deepseek_v4_1.steering.reference import (
+        project_reference,
+        rank_order_reference,
+    )
+
+    ops, _ = kernels
+    generator = torch.Generator(device="cuda").manual_seed(1729)
+    source = torch.randn(
+        (world, rows, 5120), device="cuda", generator=generator, dtype=torch.bfloat16
+    )
+    direction = torch.randn(5120, device="cuda", generator=generator)
+    direction /= direction.double().norm().float()
+    scales = (torch.arange(rows, device="cuda") % 5).float() / 4
+    writer = source[0].clone() if world == 1 else rank_order_reference(source)
+    expected = project_reference(writer, direction, scales, 2.5, fp64=True)
+    actual = writer.clone()
+    if world == 1:
+        ops.project_writer(actual, direction, scales, 2.5)
+    else:
+        ops.project_parts(source, direction, scales, actual, 2.5)
+    zero = scales == 0
+    assert torch.equal(actual[zero].view(torch.int16), writer[zero].view(torch.int16))
+    spacing = (
+        (torch.nextafter(expected, torch.full_like(expected, float("inf"))) - expected)
+        .abs()
+        .float()
+    )
+    error = (actual.float() - expected.float()).abs()
+    assert (error <= 2 * spacing).all(), (error / spacing.clamp_min(1e-38)).max().item()
+    # Different row buckets and neighbours cannot change a row reduction.
+    single = writer[-1:].clone()
+    ops.project_writer(single, direction, scales[-1:].contiguous(), 2.5)
+    assert torch.equal(single.view(torch.int16), actual[-1:].view(torch.int16))
+
+
+def test_rows_graph_replay_reuses_controls_and_output(kernels):
+    ops, row_kernel = kernels
+    n, hidden = 128, 5120
+    source = torch.randn(n, hidden, device="cuda", dtype=torch.bfloat16)
+    writer = source.clone()
+    direction = torch.randn(hidden, device="cuda")
+    direction /= direction.double().norm().float()
+    requests = torch.tensor([0.0, 0.25, 0.5, 1.0], device="cuda")
+    slots = torch.tensor([3, 0, 2, 1], device="cuda", dtype=torch.int64)
+    offsets = torch.tensor([0, 3, 3, 5, 8], device="cuda", dtype=torch.int32)
+    padding = torch.arange(n, device="cuda") >= 7
+    rows = torch.zeros(n, device="cuda")
+
+    def step():
+        writer.copy_(source)
+        row_kernel.fill_row_scales(requests, slots, offsets, padding, rows, 4, n)
+        ops.project_writer(writer, direction, rows, 2.5)
+
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        step()
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        step()
+    pointers = [t.data_ptr() for t in (writer, requests, rows)]
+    from vllm.models.deepseek_v4_1.steering.reference import project_reference
+
+    for dose in range(101):
+        requests.fill_(dose / 100)
+        graph.replay()
+        expected_scales = torch.zeros_like(rows)
+        expected_scales[:7] = dose / 100
+        torch.testing.assert_close(rows, expected_scales, rtol=0, atol=0)
+        expected = project_reference(source, direction, expected_scales, 2.5)
+        torch.testing.assert_close(writer, expected, rtol=0.016, atol=0.0001)
+        assert pointers == [t.data_ptr() for t in (writer, requests, rows)]
