+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Numerical oracles, used by tests rather than the serving path."""
+
+import torch
+
+
+def project_reference(writer, direction, scales, alpha, *, fp64=False):
+    dtype = torch.float64 if fp64 else torch.float32
+    y, d = writer.to(dtype), direction.to(dtype)
+    dots = (y * d).sum(dim=-1, keepdim=True)
+    projected = y - (scales.to(dtype) * alpha)[:, None] * d * dots
+    # Bypass rather than multiply by zero: stock rows retain signed zeros/NaNs.
+    return torch.where((scales != 0)[:, None], projected.to(writer.dtype), writer)
+
+
+def rank_order_reference(parts):
+    total = parts[0].float()
+    for rank in range(1, parts.shape[0]):
+        total = total + parts[rank].float()
+    return total.to(parts.dtype)
