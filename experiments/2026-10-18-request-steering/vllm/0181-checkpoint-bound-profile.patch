+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Load CPU contracts without importing the CUDA model package initializer."""
+
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+from safetensors.numpy import save
+
+ROOT = Path(__file__).resolve().parents[2]
+PACKAGE = ROOT / "vllm/models/deepseek_v4_1/steering"
+if "ds41_steering_test" not in sys.modules:
+    spec = importlib.util.spec_from_file_location(
+        "ds41_steering_test",
+        PACKAGE / "__init__.py",
+        submodule_search_locations=[str(PACKAGE)],
+    )
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+
+from ds41_steering_test.profile import OPERATOR_VERSION, load_profile  # noqa: E402
+
+
+def make_profile(
+    tmp_path, *, changes=None, directions=None, suffix="", dtype="float32"
+):
+    if directions is None:
+        directions = np.eye(8, dtype=dtype)[2:4]
+    metadata = {
+        "schema_version": 1,
+        "operator_version": OPERATOR_VERSION,
+        "profile_id": "test-profile",
+        "model_revision": "a" * 40,
+        "model_identity": "b" * 64,
+        "template_identity": "c" * 64,
+        "layers": [2, 3],
+        "alphas": [2.5, 2.5],
+        "hidden_size": 8,
+        "num_hidden_layers": 6,
+        "directions_sha256": hashlib.sha256(directions.tobytes()).hexdigest(),
+        "source": {"license": "synthetic-test", "revision": "d" * 40},
+    }
+    metadata.update(changes or {})
+    data = save(
+        {"directions": directions}, metadata={"ds41_steering": json.dumps(metadata)}
+    )
+    path = tmp_path / ("profile" + suffix + ".safetensors")
+    path.write_bytes(data)
+    digest = hashlib.sha256(data).hexdigest()
+    return path, digest
+
+
+def valid_profile(tmp_path):
+    return load_profile(*make_profile(tmp_path))
