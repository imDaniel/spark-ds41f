+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import json
+
+import pytest
+
+from tests.models import steering_test_support  # noqa: F401
+
+# The helper installs this isolated package before its contracts are imported.
+# isort: off
+from ds41_steering_test.profile import model_identity
+# isort: on
+
+def test_checkpoint_identity_binds_content_not_replica_metadata(tmp_path):
+    """Replicas share cache identity; a single changed weight digest does not."""
+    for name in ("config.json", "tokenizer.json", "tokenizer_config.json"):
+        (tmp_path / name).write_text("{}")
+    (tmp_path / "model.safetensors.index.json").write_text(
+        json.dumps({"weight_map": {"layer.weight": "model-00001.safetensors"}})
+    )
+    inventory = {
+        "schema_version": 1,
+        "algorithm": "sha256",
+        "coverage": "complete",
+        "files": {
+            "model-00001.safetensors": {
+                "size": 100,
+                "sha256": "a" * 64,
+                "file_identity": [1, 2, 100],
+            }
+        },
+    }
+    path = tmp_path / "model-file-hashes.json"
+    path.write_text(json.dumps(inventory))
+    first = model_identity(tmp_path)
+    inventory.update(
+        hostname="another-rank", timestamp_utc="later", root_directory="/other"
+    )
+    inventory["files"]["model-00001.safetensors"]["file_identity"] = [2, 3, 100]
+    path.write_text(json.dumps(inventory))
+    assert first == model_identity(tmp_path)
+    inventory["files"]["model-00001.safetensors"]["sha256"] = "b" * 64
+    path.write_text(json.dumps(inventory))
+    assert first != model_identity(tmp_path)
+    del inventory["files"]["model-00001.safetensors"]
+    path.write_text(json.dumps(inventory))
+    with pytest.raises(ValueError, match="missing"):
+        model_identity(tmp_path)
