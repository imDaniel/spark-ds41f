+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import hashlib
+import json
+import struct
+
+import numpy as np
+import pytest
+
+from tests.models.steering_test_support import make_profile
+
+# The helper installs this isolated package before its contracts are imported.
+# isort: off
+from ds41_steering_test.profile import load_profile
+# isort: on
+
+def test_profile_identity_and_readonly_payload(tmp_path):
+    path, digest = make_profile(tmp_path)
+    p = load_profile(
+        path,
+        digest,
+        expected_model_identity="b" * 64,
+        expected_template_identity="c" * 64,
+    )
+    assert p.layers == (2, 3) and p.hidden_size == 8
+    assert p.directions.dtype == np.float32
+    assert not p.directions.flags.writeable
+    assert len(p.identity) == 64
+    with pytest.raises(ValueError):
+        load_profile(path, digest, expected_model_identity="e" * 64)
+    with pytest.raises(ValueError):
+        load_profile(path, digest, expected_template_identity="e" * 64)
+    p2 = load_profile(
+        *make_profile(tmp_path, changes={"alphas": [1.0, 2.5]}, suffix="2")
+    )
+    assert p2.schedule_sha256 != p.schedule_sha256
+    assert p2.identity != p.identity
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"schema_version": True},
+        {"schema_version": 2},
+        {"operator_version": "unknown"},
+        {"profile_id": "../bad"},
+        {"model_revision": "wrong"},
+        {"model_identity": "bad"},
+        {"template_identity": None},
+        {"layers": []},
+        {"layers": [2, 2]},
+        {"layers": [3, 2]},
+        {"layers": [True, 3]},
+        {"layers": [-1, 3]},
+        {"layers": [2, 6]},
+        {"alphas": [2.5]},
+        {"alphas": [True, 2.5]},
+        {"alphas": [float("nan"), 2.5]},
+        {"alphas": [float("inf"), 2.5]},
+        {"alphas": [0, 2.5]},
+        {"alphas": [17, 2.5]},
+        {"hidden_size": True},
+        {"num_hidden_layers": 257},
+        {"directions_sha256": "0" * 64},
+        {"source": {}},
+        {"unexpected": 1},
+    ],
+)
+def test_invalid_metadata(tmp_path, changes):
+    with pytest.raises(ValueError):
+        load_profile(*make_profile(tmp_path, changes=changes))
+
+
+@pytest.mark.parametrize("mode", ["zero", "nonunit", "nan", "inf", "shape", "dtype"])
+def test_invalid_directions(tmp_path, mode):
+    d = np.eye(8, dtype=np.float32)[2:4].copy()
+    if mode == "zero":
+        d[0] = 0
+    if mode == "nonunit":
+        d[0] *= 2
+    if mode == "nan":
+        d[0, 0] = np.nan
+    if mode == "inf":
+        d[0, 0] = np.inf
+    if mode == "shape":
+        d = d[:, :4]
+    if mode == "dtype":
+        d = d.astype(np.float16)
+    with pytest.raises(ValueError):
+        load_profile(*make_profile(tmp_path, directions=d))
+
+
+def test_corrupt_truncated_trailing_and_duplicate_header(tmp_path):
+    path, digest = make_profile(tmp_path)
+    original = path.read_bytes()
+    path.write_bytes(original[:-1])
+    with pytest.raises(ValueError):
+        load_profile(path, digest)
+    data = original + b"extra"
+    path.write_bytes(data)
+    with pytest.raises(ValueError):
+        load_profile(path, hashlib.sha256(data).hexdigest())
+    size = struct.unpack("<Q", original[:8])[0]
+    header = json.loads(original[8 : 8 + size])
+    text = json.dumps(header)[:-1] + ',"directions":{}}'
+    data = struct.pack("<Q", len(text)) + text.encode() + original[8 + size :]
+    path.write_bytes(data)
+    with pytest.raises(ValueError, match="Duplicate"):
+        load_profile(path, hashlib.sha256(data).hexdigest())
