+
+
+def read_directory(profile_dir, expected_sha256=None):
+    """Read one manifest/payload pair with an optional exact manifest pin."""
+    manifest_path = os.path.join(profile_dir, "manifest.json")
+    payload_path = os.path.join(profile_dir, "directions.f32")
+    try:
+        raw = read_limited(manifest_path, MAX_HEADER, "manifest")
+        manifest = parse_json(raw, "manifest JSON")
+        payload = read_limited(payload_path, MAX_PAYLOAD, "directions payload")
+    except OSError as e:
+        raise ProfileError(str(e)) from None
+    if expected_sha256 is not None and sha256(raw) != expected_sha256:
+        raise ProfileError("steering manifest SHA-256 mismatch")
+    validate_manifest(manifest, payload)
+    return manifest, payload, raw
+
+
+def validate_directory(profile_dir, expected=None):
+    """Validate the directory against an optional complete model identity."""
+    manifest, payload, _ = read_directory(profile_dir)
+    validate_manifest(manifest, payload, expected)
+    return manifest
+
+
+def _atomic_write(path, chunks):
+    parent = os.path.dirname(os.path.abspath(path))
+    os.makedirs(parent, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=".steering-", dir=parent)
+    try:
+        with os.fdopen(fd, "wb") as f:
+            for chunk in chunks:
+                f.write(chunk)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    finally:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+
+
+def pack(profile_dir, output):
+    """Pack exact input bytes and atomically publish the artifact."""
+    manifest_raw = read_limited(
+        os.path.join(profile_dir, "manifest.json"), MAX_HEADER, "manifest"
+    )
+    manifest = parse_json(manifest_raw, "manifest JSON")
+    payload = read_limited(
+        os.path.join(profile_dir, "directions.f32"), MAX_PAYLOAD, "directions payload"
+    )
+    _, shape = validate_manifest(manifest, payload)
+    manifest_json = manifest_raw.decode("utf-8")
+    header = {
+        "__metadata__": {
+            "format": FORMAT,
+            "gr8_manifest": manifest_json,
+            "manifest_sha256": sha256(manifest_raw),
