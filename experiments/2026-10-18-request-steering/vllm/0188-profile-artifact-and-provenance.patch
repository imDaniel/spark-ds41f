+def test_explicit_extension_rejects_legacy_envelopes_and_tampered_manifest(tmp_path):
+    path, digest = make_profile(tmp_path)
+    original = path.read_bytes()
+    n = struct.unpack("<Q", original[:8])[0]
+    header = json.loads(original[8 : 8 + n])
+    for metadata in (
+        {"ds41_steering": "{}"},
+        {**header["__metadata__"], "format": "gr8-steering-profile-v1"},
+        {**header["__metadata__"], "manifest_sha256": "0" * 64},
+        {
+            **header["__metadata__"],
+            "gr8_manifest": header["__metadata__"]["gr8_manifest"] + "\n",
+        },
+    ):
+        raw = json.dumps({**header, "__metadata__": metadata}).encode()
+        raw += b" " * (-len(raw) % 8)
+        data = struct.pack("<Q", len(raw)) + raw + original[8 + n :]
+        path.write_bytes(data)
+        with pytest.raises(ValueError):
+            load_profile(path, hashlib.sha256(data).hexdigest())
+
