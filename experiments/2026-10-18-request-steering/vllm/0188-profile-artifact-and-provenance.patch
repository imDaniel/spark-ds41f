+def test_materialization_preserves_exact_manifest_and_repackages_identically(tmp_path):
+    path, digest = make_profile(tmp_path)
+    manifest, payload, raw = artifact.read_artifact(path, digest)
+    source = tmp_path / "source"
+    source.mkdir()
+    raw += b"\n\n"
+    (source / "manifest.json").write_bytes(raw)
+    (source / "directions.f32").write_bytes(payload)
+    first, second = tmp_path / "first.safetensors", tmp_path / "second.safetensors"
+    artifact.pack(source, first)
+    artifact.pack(source, second)
+    assert first.read_bytes() == second.read_bytes()
+    destination = tmp_path / "materialized"
+    assert artifact.unpack(first, destination) == manifest
+    assert (destination / "manifest.json").read_bytes() == raw
+    assert (destination / "directions.f32").read_bytes() == payload
+    assert artifact.unpack(first, destination) == manifest
+    artifact.pack(destination, second)
+    assert first.read_bytes() == second.read_bytes()
+    got = load_profile(first, hashlib.sha256(first.read_bytes()).hexdigest())
+    assert got.manifest_sha256 == hashlib.sha256(raw).hexdigest()
+    assert load_profile(destination, got.manifest_sha256).identity == got.identity
+    with pytest.raises(ValueError, match="manifest SHA-256"):
+        load_profile(destination, "0" * 64)
+    assert got.identity != load_profile(path, digest).identity
+    assert got.schedule_sha256 == load_profile(path, digest).schedule_sha256
+    (destination / "manifest.json").write_bytes(b"previous")
+    with pytest.raises(ValueError, match="different profile"):
+        artifact.unpack(first, destination)
+    assert (destination / "manifest.json").read_bytes() == b"previous"
+
