+# c53b5b869818950a96a9b72c647d4b156b057127.
+"""Pack and unpack the explicit DeepSeek attention extension deterministically.
+
+The payload has one F32 tensor, ``directions``. Metadata preserves the exact
+UTF-8 manifest. Only the standard library is needed to materialize a profile.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import shutil
+import struct
+import tempfile
+
+FORMAT = "gr8-steering-profile-v1+ds41-attention-v1"
+OPERATOR_VERSION = "attn-writer-project-bf16-rank-order-v1"
+MAX_HEADER = 1 << 20
+MAX_PAYLOAD = 64 << 20
+
+
+class ProfileError(ValueError):
+    pass
+
+
+def canonical(value):
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    )
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _unique_object(pairs):
+    out = {}
+    for key, value in pairs:
+        if key in out:
+            raise ProfileError(f"duplicate JSON key {key}")
+        out[key] = value
+    return out
+
+
+def parse_json(raw, where):
+    def number(token):
+        value = float(token)
+        if not math.isfinite(value):
+            raise ProfileError(f"invalid {where}: non-finite number")
+        return value
+
+    def constant(token):
+        raise ProfileError(f"invalid {where}: non-finite number {token}")
+
+    def check(value, depth=0):
+        if depth > 64:
+            raise ProfileError(f"invalid {where}: nested too deeply")
+        if isinstance(value, str):
+            value.encode(
+                "utf-8"
+            )  # reject lone escaped surrogates, as the C++ reader does
+        elif isinstance(value, dict):
+            for key, item in value.items():
+                key.encode("utf-8")
+                check(item, depth + 1)
+        elif isinstance(value, list):
+            for item in value:
+                check(item, depth + 1)
+
+    try:
+        if isinstance(raw, bytes):
+            raw = raw.decode("utf-8")  # JSON here never accepts UTF-16/32 or a BOM
+        value = json.loads(
+            raw,
+            object_pairs_hook=_unique_object,
+            parse_float=number,
+            parse_constant=constant,
+        )
+        check(value)
+        return value
+    except ProfileError:
+        raise
+    except (UnicodeError, ValueError, RecursionError) as e:
+        raise ProfileError(f"invalid {where}: {e}") from None
+
+
+def read_limited(path, limit, what):
+    with open(path, "rb") as f:
+        raw = f.read(limit + 1)
+    if len(raw) > limit:
+        raise ProfileError(f"{what} is too large")
+    return raw
+
+
+def _object(value, keys, where):
+    if not isinstance(value, dict) or set(value) != set(keys):
+        raise ProfileError(f"invalid {where}")
+
+
+def _integer(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _u32(value):
+    return _integer(value) and 0 <= value <= 0xFFFFFFFF
+
+
+def _digest(value):
+    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None
+
+
+def validate_manifest(manifest, payload, expected=None):
+    _object(
+        manifest,
+        (
+            "schema_version",
+            "profile_name",
+            "model",
+            "scope",
+            "layers",
+            "alphas",
+            "directions",
+            "provenance",
+            "operator_version",
+        ),
+        "manifest fields",
+    )
+    if not _integer(manifest.get("schema_version")) or manifest["schema_version"] != 1:
+        raise ProfileError("want a schema-v1 steering manifest")
+    name = manifest.get("profile_name")
+    if not isinstance(name, str) or not re.fullmatch(
+        r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name
+    ):
+        raise ProfileError("invalid profile_name")
+    layers, alphas = manifest.get("layers"), manifest.get("alphas")
+    model, directions = manifest.get("model"), manifest.get("directions")
+    if (
+        not isinstance(layers, list)
+        or not layers
+        or not isinstance(alphas, list)
+        or len(layers) != len(alphas)
+    ):
+        raise ProfileError("inconsistent layers and alphas")
+    _object(
+        model,
+        (
+            "name",
+            "revision",
+            "weight_set",
+            "tokenizer_revision",
+            "chat_template_sha256",
+            "hidden_size",
+            "layer_count",
+        ),
+        "model fields",
+    )
+    for field in ("name", "revision", "weight_set", "tokenizer_revision"):
+        if not isinstance(model.get(field), str) or not model[field]:
+            raise ProfileError(f"invalid model.{field}")
+    if not _digest(model["weight_set"]):
+        raise ProfileError("invalid model.weight_set")
+    if (
+        not _u32(model.get("hidden_size"))
+        or model["hidden_size"] == 0
+        or not _u32(model.get("layer_count"))
+        or model["layer_count"] == 0
+    ):
+        raise ProfileError("invalid model dimensions")
+    if not _digest(model.get("chat_template_sha256")):
+        raise ProfileError("invalid model.chat_template_sha256")
+    if expected is not None:
+        _object(expected, model.keys(), "expected model identity fields")
+        if any(
+            type(expected[key]) is not type(value) or expected[key] != value
+            for key, value in model.items()
+        ):
+            raise ProfileError("model identity mismatch")
+    last = -1
+    for layer in layers:
+        if not _integer(layer) or layer <= last or layer >= model["layer_count"]:
+            raise ProfileError("layers must be unique, ordered, and in range")
+        last = layer
+    for alpha in alphas:
+        if (
+            isinstance(alpha, bool)
+            or not isinstance(alpha, (int, float))
+            or not 0.0 <= alpha <= 4.0
+            or not math.isfinite(alpha)
+        ):
+            raise ProfileError("alpha must be finite and in [0, 4]")
+    if manifest.get("scope") != "attention":
+        raise ProfileError("this operator requires attention scope")
+    if manifest.get("operator_version") != OPERATOR_VERSION:
+        raise ProfileError("unsupported attention operator version")
+    want = len(layers) * model["hidden_size"] * 4
+    _object(directions, ("file", "dtype", "byte_count", "sha256"), "directions record")
+    if (
+        directions.get("file") != "directions.f32"
+        or directions.get("dtype") != "float32-le"
+        or not _u32(directions.get("byte_count"))
+        or directions["byte_count"] != want
+    ):
+        raise ProfileError("invalid directions record")
+    if len(payload) != want or len(payload) > MAX_PAYLOAD:
+        raise ProfileError("directions payload size mismatch")
+    if directions.get("sha256") != sha256(payload):
