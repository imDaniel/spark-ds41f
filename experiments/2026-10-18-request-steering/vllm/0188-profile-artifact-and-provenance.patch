+
+
+def read(path):
+    """Return the validated manifest mapping and directions bytes from an artifact."""
+    manifest, payload, _ = read_artifact(path)
+    return manifest, payload
+
+
+def resolve_bundled(model_dir, selector):
+    """Resolve only an explicitly selected artifact in a verified local release."""
+    if not isinstance(selector, str) or not selector.startswith("hf:"):
+        raise ProfileError("want hf:default or hf:NAME")
+    root = os.path.abspath(model_dir)
+    raw = read_limited(os.path.join(root, "steering/index.json"), MAX_HEADER, "index")
+    index = parse_json(raw, "steering index")
+    _object(index, ("schema_version", "default_profile", "profiles"), "index")
+    if type(index["schema_version"]) is not int or index["schema_version"] != 1:
+        raise ProfileError("unsupported steering index version")
+    if not isinstance(index["profiles"], list):
+        raise ProfileError("invalid profile records")
+    records = {}
+    for entry in index["profiles"]:
+        _object(entry, ("name", "file", "sha256", "byte_count"), "index record")
+        name = entry["name"]
+        if (
+            not isinstance(name, str)
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name)
+            or name in records
+            or entry["file"] != f"steering/{name}.safetensors"
+            or not _digest(entry["sha256"])
+            or type(entry["byte_count"]) is not int
+            or not 8 < entry["byte_count"] <= 8 + MAX_HEADER + MAX_PAYLOAD
+        ):
+            raise ProfileError("invalid or duplicate steering index record")
+        records[name] = entry
+    default = index["default_profile"]
+    if not isinstance(default, str) or default not in records:
+        raise ProfileError("default_profile is not listed")
+    name = default if selector == "hf:default" else selector[3:]
+    if name not in records:
+        raise ProfileError("requested profile is not listed")
+    entry = records[name]
+    path = os.path.join(root, entry["file"])
+    if os.path.getsize(path) != entry["byte_count"]:
+        raise ProfileError("bundled profile size mismatch")
+    manifest, _, _ = read_artifact(path, entry["sha256"])
+    if manifest["profile_name"] != name:
+        raise ProfileError("bundled profile name mismatch")
+    return name, path, entry["sha256"]
+
+
+def unpack(path, output_dir):
+    """Publish exact contents; reuse identical bytes and reject conflicts."""
+    manifest, payload, manifest_raw = read_artifact(path)
+    output_dir = os.path.abspath(output_dir)
+    if os.path.islink(output_dir):
+        raise ProfileError("output directory must not be a symlink")
+    if os.path.isdir(output_dir) and os.listdir(output_dir):
+        if (
+            read_limited(
+                os.path.join(output_dir, "manifest.json"), MAX_HEADER, "manifest"
+            )
+            == manifest_raw
+            and read_limited(
+                os.path.join(output_dir, "directions.f32"),
+                MAX_PAYLOAD,
+                "directions payload",
+            )
+            == payload
+        ):
+            return manifest
+        raise ProfileError("output directory contains a different profile")
+    parent = os.path.dirname(output_dir)
+    os.makedirs(parent, exist_ok=True)
+    stage = tempfile.mkdtemp(prefix=".steering-", dir=parent)
+    try:
+        _atomic_write(os.path.join(stage, "manifest.json"), (manifest_raw,))
+        _atomic_write(os.path.join(stage, "directions.f32"), (payload,))
+        os.replace(stage, output_dir)
+    finally:
+        shutil.rmtree(stage, ignore_errors=True)
+    return manifest
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="command", required=True)
+    p = sub.add_parser("pack")
+    p.add_argument("profile_dir")
+    p.add_argument("output")
+    p = sub.add_parser("unpack")
+    p.add_argument("input")
+    p.add_argument("output_dir")
+    args = ap.parse_args(argv)
+    try:
+        if args.command == "pack":
+            pack(args.profile_dir, args.output)
+        else:
+            unpack(args.input, args.output_dir)
+    except (OSError, ProfileError) as e:
+        ap.exit(2, f"{ap.prog}: {e}\n")
+
+
+if __name__ == "__main__":
+    main()
