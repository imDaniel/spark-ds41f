+@pytest.mark.parametrize("wrapper", ["causal", "vision"])
+@pytest.mark.parametrize("scale", [0, 1, 4])
+def test_1022_late_admission_hook_preserves_steering_inputs(tmp_path, wrapper, scale):
+    """Real LayerProgress host hooks with CPU tensors/events; no CUDA replay proof."""
+    ns = {"torch": torch, "nn": torch.nn, "AsyncModelRunnerOutput": object}
+    source_definitions(
+        "vllm/v1/worker/gpu/late_admission.py",
+        ["decoder_layers", "StepReachedLayer", "LayerProgress"], ns,
+    )
+    trace = []
+
+    class Layer(torch.nn.Module):
+        def forward(self, x):
+            trace.append("layer")
+            return x + 1
+
+    inner = torch.nn.Module()
+    inner.layers = torch.nn.ModuleList([Layer(), Layer(), Layer()])
+    model = torch.nn.Module()
+    if wrapper == "vision":
+        model.language_model = torch.nn.Module()
+        model.language_model.model = inner
+    else:
+        model.model = inner
+    event = SimpleNamespace(
+        record=lambda: trace.append("event"),
+        synchronize=lambda: trace.append("wait"),
+    )
+    progress = ns["LayerProgress"](model, 1, event_factory=lambda: event)
+    profile = valid_profile(tmp_path)
+    runtime = SteeringRuntime(profile, 2, 8, "cpu")
+    runtime.add_request(1, "r", {"steering_profile": profile.profile_id, "steering_scale": scale})
+    batch = SimpleNamespace(
+        num_reqs=1, req_ids=["r"], idx_mapping_np=np.array([1]),
+        num_tokens_after_padding=4, query_start_loc=torch.tensor([0, 2]),
+        is_padding=torch.tensor([False, False, True, True]),
+    )
+    for _ in range(2):
+        inputs = runtime.model_inputs(batch)
+        assert inputs["steering_active"] == bool(scale)
+        if scale:
+            assert inputs["steering_scales"].tolist() == [scale, scale, 0, 0]
+        x = torch.zeros(2)
+        for layer in inner.layers:
+            x = layer(x)
+        assert torch.equal(x, torch.full((2,), 3.0))
+        assert progress.reply().get_output() is None
+    assert trace == ["layer", "event", "layer", "layer", "wait"] * 2
+    assert runtime.requests["r"][1].scale == scale
+
+
+@pytest.mark.parametrize("drafts", [0, 2, 5])
+@pytest.mark.parametrize("scale", [0, 1, 4])
+def test_1022_draft_zero_keeps_controls_on_final_input_rows(tmp_path, drafts, scale):
+    """Exercise the actual draft-zero splitter and ragged row controls together.
+
+    This is a host layout contract, not execution of sink sampling or KV rollback.
+    """
+    ns = {}
+    source_definitions(
+        "vllm/v1/worker/gpu/model_runner.py", ["_drafter_spec_tokens"], ns,
+        owner="GPUModelRunner",
+    )
+    spec = {"r": [700, *range(drafts)], "stock": [800, 801]}
+    output = SimpleNamespace(scheduled_spec_decode_tokens=spec, sink_draft_zero_req_ids={"r"})
+    expected = {"stock": [800, 801]}
+    if drafts:
+        expected["r"] = list(range(drafts))
+    assert ns["_drafter_spec_tokens"](None, output) == expected
+    assert spec["r"] == [700, *range(drafts)]  # does not mutate the scheduler
+    profile = valid_profile(tmp_path)
+    runtime = SteeringRuntime(profile, 3, 32, "cpu")
+    runtime.add_request(2, "r", {"steering_profile": profile.profile_id, "steering_scale": scale})
+    runtime.add_request(0, "stock", None)
+    # Includes row zero regardless of how many drafter-only tokens remain.
+    for row_count in (drafts + 1, 1):
+        batch = SimpleNamespace(
+            num_reqs=2, req_ids=["stock", "r"], idx_mapping_np=np.array([0, 2]),
+            num_tokens_after_padding=16, query_start_loc=torch.tensor([0, 2, 2 + row_count]),
+            is_padding=torch.tensor([False] * (2 + row_count) + [True] * (14 - row_count)),
+        )
+        inputs = runtime.model_inputs(batch)
+        assert inputs["steering_active"] == bool(scale)
+        if scale:
+            assert inputs["steering_scales"].tolist() == [0, 0] + [scale] * row_count + [0] * (14 - row_count)
+    runtime.remove_request("r")
+    runtime.add_request(2, "next", None)
+    assert runtime.input_variant(["next", "stock"]) == 0
+    assert runtime.request_scales[2] == 0
