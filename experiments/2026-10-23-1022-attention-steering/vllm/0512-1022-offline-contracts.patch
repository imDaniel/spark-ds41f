+@pytest.mark.parametrize("scale", [0, 1, 4])
+def test_1022_template_rebinding_separates_active_prefix_cache(tmp_path, scale):
+    from ds41_steering_test.cache import steering_cache_salt
+    from ds41_steering_test.request import parse_selection
+
+    old_path, old_sha = make_profile(tmp_path)
+    new_path, new_sha = make_profile(
+        tmp_path, changes={"model.chat_template_sha256": "e" * 64}, suffix="-1022"
+    )
+    old = load_profile(old_path, old_sha, expected_template_identity="c" * 64)
+    new = load_profile(new_path, new_sha, expected_template_identity="e" * 64)
+    assert old.directions.tobytes() == new.directions.tobytes()
+    assert old.schedule_sha256 == new.schedule_sha256
+    assert old.identity != new.identity
+    with pytest.raises(ValueError, match="chat_template_sha256 identity mismatch"):
+        load_profile(old_path, old_sha, expected_template_identity="e" * 64)
+    with pytest.raises(ValueError, match="chat_template_sha256 identity mismatch"):
+        load_profile(new_path, new_sha, expected_template_identity="c" * 64)
+    args = {"steering_profile": old.profile_id, "steering_scale": scale}
+    before = steering_cache_salt("caller", parse_selection(args, old))
+    after = steering_cache_salt("caller", parse_selection(args, new))
+    if scale:
+        assert before != after
+    else:
+        assert before == after == "caller"
