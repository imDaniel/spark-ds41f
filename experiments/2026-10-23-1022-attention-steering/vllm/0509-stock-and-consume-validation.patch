+@pytest.mark.parametrize("dose", [0, 0.25, 0.5, 0.75, 1, 2, 4])
+def test_actual_consumer_formula_matches_fp64_and_skips_zero_loads(host_modules, dose):
+    h = host_modules
+    fma = ctypes.CDLL(None).fmaf
+    fma.argtypes, fma.restype = [ctypes.c_float] * 3, ctypes.c_float
+    T = h.T
+    T.float32, T.bfloat16 = np.float32, torch.bfloat16
+    T.unroll, T.abs = range, abs
+    T.Cast = lambda dtype, x: (
+        float(torch.tensor(float(x), dtype=dtype))
+        if dtype is torch.bfloat16
+        else np.float32(x)
+    )
+    T.ieee_add = lambda a, b: np.float32(np.float32(a) + np.float32(b))
+    T.ieee_sub = lambda a, b: np.float32(np.float32(a) - np.float32(b))
+    T.ieee_mul = lambda a, b: np.float32(np.float32(a) * np.float32(b))
+    T.ieee_fmaf = lambda a, b, c: np.float32(fma(float(a), float(b), float(c)))
+    gen = torch.Generator().manual_seed(1729)
+    original = torch.randn(128, generator=gen, dtype=torch.bfloat16)
+    direction = torch.randn(128, generator=gen).numpy()
+    direction /= np.linalg.norm(direction.astype(np.float64))
+    scalar = original.double().numpy() @ direction.astype(np.float64)
+    hi = np.float32(scalar)
+    dots = np.array([[hi, np.float32(scalar - float(hi))]])
+    actual = original.float().numpy().copy()
+    if dose == 0:
+        actual[:3] = [-0.0, np.nan, np.inf]
+        before = actual.view(np.uint32).copy()
+
+        class Unreadable:
+            def __getitem__(self, key):
+                pytest.fail("Zero rows must not read direction or dot")
+
+        direction = dots = Unreadable()
+    h.consume.project_columns(
+        actual,
+        direction,
+        np.array([dose], np.float32),
+        dots,
+        np.float32(2.5),
+        0,
+        0,
+        128,
+    )
+    if dose == 0:
+        np.testing.assert_array_equal(actual.view(np.uint32), before)
+    else:
+        expected = torch.tensor(
+            original.double().numpy()
+            - dose * 2.5 * direction.astype(np.float64) * scalar,
+            dtype=torch.bfloat16,
+        )
+        observed = torch.tensor(actual, dtype=torch.bfloat16)
+        spacing = (
+            (
+                torch.nextafter(expected, torch.full_like(expected, float("inf")))
+                - expected
+            )
+            .abs()
+            .float()
+        )
+        assert ((observed.float() - expected.float()).abs() <= 2 * spacing).all()
