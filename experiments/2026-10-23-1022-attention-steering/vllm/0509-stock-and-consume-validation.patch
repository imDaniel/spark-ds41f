+def test_actual_model_state_real_dummy_and_capture_hooks(host_modules, tmp_path):
+    h = host_modules
+    state = h.state.__new__(h.state)
+    state.steering = SteeringRuntime(valid_profile(tmp_path), 4, 16, "cpu")
+    state.ced_state = state.lookback_token_ids = None
+    state.disk_engram_models = ()
+    state.steering.add_request(0, "r", None)
+    batch = SimpleNamespace(
+        num_tokens_after_padding=8,
+        num_reqs=1,
+        req_ids=["r"],
+        idx_mapping_np=np.array([0]),
+    )
+    state.steering.row_scales.fill_(31)
+    assert state.prepare_inputs(batch, None) == {"base": True, "steering_active": False}
+    assert state.cudagraph_input_variants == (0, 1)
+    assert state.get_model_input_variant(["r"]) == 0
+    assert state.prepare_dummy_inputs_for_variant(1, 8, 0)["steering_active"] is False
+    assert (state.steering.row_scales == 31).all()
+    capture = state.prepare_dummy_inputs_for_variant(1, 8, 1)
+    assert capture["steering_active"] and not capture["steering_scales"].any()
+    state.steering.remove_request("r")
+    state.steering.add_request(
+        0, "r", {"steering_profile": "test-profile", "steering_scale": 1.5}
+    )
+    batch.query_start_loc = torch.tensor([0, 3])
+    batch.is_padding = torch.tensor([False] * 3 + [True] * 5)
+    assert state.get_model_input_variant(["r"]) == 1
+    real = state.prepare_inputs(batch, None)
+    assert real["steering_active"]
+    assert real["steering_scales"].tolist() == [1.5] * 3 + [0] * 5
+    state.steering = None
+    assert state.cudagraph_input_variants == (0,)
+    with pytest.raises(ValueError):
+        state.prepare_dummy_inputs_for_variant(1, 8, 1)
