+    residual = torch.zeros(3, 4, 128, dtype=torch.bfloat16)
+    writer = torch.zeros((3, 128) if world == 1 else (4, 3, 128), dtype=torch.bfloat16)
+    source = writer if world == 1 else h.Parts(writer)
+    post, comb, pre = torch.zeros(3, 4), torch.zeros(3, 4, 4), torch.zeros(3, 4)
+    args = (
+        source,
+        residual,
+        post,
+        comb,
+        torch.zeros(24, 512),
+        torch.zeros(3),
+        torch.zeros(24),
+        torch.ones(128, dtype=torch.bfloat16),
