+def batch_for(ids, slots):
+    return SimpleNamespace(
+        num_tokens_after_padding=8,
+        num_reqs=len(ids),
+        req_ids=ids,
+        idx_mapping_np=np.array(slots),
+        query_start_loc=torch.tensor([0, *range(2, 2 * len(ids) + 1, 2)]),
+        is_padding=torch.tensor([False] * (2 * len(ids)) + [True] * (8 - 2 * len(ids))),
+    )
+
+
+@pytest.mark.parametrize("scale", [0.0, -0.0, 1e-100])
+def test_scheduled_stock_skips_controls_even_with_other_active_residents(
+    tmp_path, monkeypatch, scale
+):
+    p = valid_profile(tmp_path)
+    state = SteeringRuntime(p, 4, 16, "cpu")
+    state.add_request(
+        0, "stock", {"steering_profile": p.profile_id, "steering_scale": scale}
+    )
+    state.add_request(1, "other", {"steering_profile": p.profile_id})
+    state.row_scales.fill_(17)
+    state.dots.fill_(19)
+
+    def unexpected_prepare(_):
+        pytest.fail("Stock batch must not expand row controls")
+
+    monkeypatch.setattr(state, "prepare", unexpected_prepare)
+    assert state.input_variant(["stock"]) == 0
+    assert state.input_variant(["stock", "other"]) == 1
+    assert state.model_inputs(batch_for(["stock"], [0])) == {"steering_active": False}
+    assert (state.row_scales == 17).all() and (state.dots == 19).all()
+    assert state.dummy_inputs(8, 0) == {"steering_active": False}
+    assert (state.row_scales == 17).all()
+    with pytest.raises(ValueError, match="slot mapping"):
+        state.model_inputs(batch_for(["stock"], [1]))
+    with pytest.raises(ValueError, match="unregistered"):
+        state.input_variant(["other", "missing"])
+
+
+def test_mixed_batch_and_capture_topology_stay_explicit_after_cancel_and_reuse(
+    tmp_path,
+):
+    p = valid_profile(tmp_path)
+    state = SteeringRuntime(p, 4, 16, "cpu")
+    state.add_request(
+        2, "active", {"steering_profile": p.profile_id, "steering_scale": 2}
+    )
+    state.add_request(0, "stock", None)
+    inputs = state.model_inputs(batch_for(["active", "stock"], [2, 0]))
+    assert inputs["steering_active"] is True
+    assert inputs["steering_scales"].tolist() == [2, 2, 0, 0, 0, 0, 0, 0]
+    assert inputs["steering_dots"] is state.dots
+    assert state.dots.shape == (16, 2) and state.dots.dtype == torch.float32
+    validate_model_inputs(p, True, inputs["steering_scales"], state.dots, 8)
+    # Capture route 1 must exist even though all dummy doses are zero.
+    capture = state.dummy_inputs(8, 1)
+    assert capture["steering_active"] and not capture["steering_scales"].any()
+    assert state.input_variant(["active"], dummy=True) == 0
+    state.remove_request("active")
+    state.add_request(2, "new", None)
+    assert state.model_inputs(batch_for(["new", "stock"], [2, 0])) == {
+        "steering_active": False
+    }
+    with pytest.raises(ValueError, match="unknown steering_profile"):
+        state.add_request(
+            3, "bad", {"steering_profile": "unknown", "steering_scale": 0}
+        )
+    with pytest.raises(ValueError):
+        state.dummy_inputs(8, 2)
+
+
+@pytest.mark.parametrize(
+    "active,scales,dots",
+    [
+        (False, torch.zeros(8), None),
+        (True, None, None),
+        (True, torch.zeros(7), torch.zeros(8, 2)),
+        (True, torch.zeros(8), torch.zeros(8, 5120, dtype=torch.bfloat16)),
+        (1, None, None),
+    ],
+)
+def test_malformed_controls_cannot_silently_choose_stock(
+    tmp_path, active, scales, dots
+):
+    with pytest.raises(ValueError):
+        validate_model_inputs(valid_profile(tmp_path), active, scales, dots, 8)
+    with pytest.raises(ValueError):
+        validate_model_inputs(None, True, torch.zeros(8), torch.zeros(8, 2), 8)
