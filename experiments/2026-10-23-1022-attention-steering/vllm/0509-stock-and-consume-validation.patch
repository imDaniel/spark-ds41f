+def test_actual_dot_binding_and_sp_fallback_do_not_materialize_twice(
+    host_modules, monkeypatch
+):
+    h = host_modules
+    launched = []
+
+    class Launcher:
+        def __getitem__(self, grid):
+            return lambda *args, **kw: launched.append((grid, args, kw))
+
+    monkeypatch.setattr(h.ops, "_dot_launcher", Launcher())
+    writer = torch.zeros(3, 128, dtype=torch.bfloat16)
+    direction, scales, dots = torch.zeros(128), torch.ones(3), torch.zeros(8, 2)
+    scratch = torch.empty(8, 128, dtype=torch.bfloat16)
+    result, controls = h.ops.prepare_consumer(
+        writer, direction, scales, dots, scratch, 2.5
+    )
+    assert result is writer and len(launched) == 1
+    assert controls["steering_dots"].data_ptr() == dots.data_ptr()
+    assert controls["steering_dots"].shape == (3, 2)
+    assert launched[0][0] == (3,) and launched[0][1][0].data_ptr() == writer.data_ptr()
+    legacy_calls = []
+    monkeypatch.setattr(h.ops, "project_parts", lambda *args: legacy_calls.append(args))
+    packed = torch.zeros(4, 3, 128, dtype=torch.bfloat16)
+    result, controls = h.ops.prepare_consumer(
+        h.Parts(packed), direction, scales, dots, scratch, 2.5
+    )
+    assert controls == {} and len(launched) == 1 and len(legacy_calls) == 1
+    assert result.data_ptr() == scratch.data_ptr() and result.shape == writer.shape
+    assert legacy_calls[0][0] is packed
+    with pytest.raises(ValueError, match="geometry"):
+        h.ops.projection_dot(writer.unsqueeze(0), direction, scales, dots)
+    with pytest.raises(ValueError, match="explicit row controls"):
+        h.ops.prepare_consumer(h.Parts(packed), direction, None, dots, scratch, 2.5)
+
