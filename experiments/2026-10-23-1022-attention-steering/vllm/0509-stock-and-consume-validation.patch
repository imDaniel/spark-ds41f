+@pytest.mark.parametrize("rows", [3, 16, 96, 129])
+def test_fused_consumer_graph_matches_independent_projection(
+    kernels, monkeypatch, rows
+):
+    """The actual TileLang fold and one active graph must survive dose changes."""
+    if torch.cuda.get_device_capability()[0] != 12:
+        pytest.skip("DeepSeek mHC target requires SM12x")
+    from types import SimpleNamespace
+
+    from vllm.models.deepseek_v4_1.tilelang.mhc import TileKernelsMHC
+    from vllm.v1.worker.workspace import (
+        collect_cuda_graph_capture_resources,
+        init_workspace_manager,
+        is_workspace_manager_initialized,
+        reset_workspace_manager,
+    )
+
+    owned_workspace = not is_workspace_manager_initialized()
+    if owned_workspace:
+        init_workspace_manager(torch.device("cuda"))
+    ops, _ = kernels
+    h = 5120
+    gen = torch.Generator(device="cuda").manual_seed(1729)
+    writer = torch.randn(rows, h, device="cuda", dtype=torch.bfloat16, generator=gen)
+    residual = torch.randn(
+        rows, 4, h, device="cuda", dtype=torch.bfloat16, generator=gen
+    )
+    direction = torch.randn(h, device="cuda", generator=gen)
+    direction /= direction.double().norm().float()
+    scales = torch.zeros(rows, device="cuda")
+    dots = torch.full((rows, 2), float("nan"), device="cuda")
+    layer = TileKernelsMHC(
+        SimpleNamespace(
+            hc_mult=4,
+            hidden_size=h,
+            rms_norm_eps=1e-6,
+            hc_eps=1e-6,
+            hc_sinkhorn_iters=20,
+        )
+    )
+    layer.steering_enabled = True
+    monkeypatch.setattr(
+        layer,
+        "_entries",
+        lambda: [(mode, 1) for mode in ("pre", "post_pre", "broadcast")],
+    )
+    layer.declare_kernels()
+    post = torch.rand(rows, 4, device="cuda", generator=gen)
+    comb = torch.rand(rows, 4, 4, device="cuda", generator=gen)
+    fn = torch.randn(24, 4 * h, device="cuda", generator=gen) / (4 * h) ** 0.5
+    norm = torch.ones(h, device="cuda", dtype=torch.bfloat16)
+    params = (
+        residual,
+        post,
+        comb,
+        fn,
+        torch.ones(3, device="cuda"),
+        torch.zeros(24, device="cuda"),
+        norm,
+        post,
+    )
+
+    def fused():
+        controls = ops.prepare_consumer(writer, direction, scales, dots, None, 2.5)[1]
+        return layer.post_pre(writer, *params, **controls)
+
+    try:
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            fused()
+        torch.cuda.current_stream().wait_stream(stream)
+        graph = torch.cuda.CUDAGraph()
+        with (
+            collect_cuda_graph_capture_resources() as resources,
+            torch.cuda.graph(graph),
+        ):
+            observed = fused()
+        pointers = [t.data_ptr() for t in observed] + [dots.data_ptr()]
+        for i in range(101):
+            scales.fill_(4 * i / 100)
+            scales[0] = 0  # mixed rows, including poisoned but unread dot entries
+            graph.replay()
+            projected = writer.clone()
+            ops.project_writer(projected, direction, scales, 2.5)
+            expected = layer.post_pre(projected, *params)
+            for actual, oracle in zip(observed, expected):
+                torch.testing.assert_close(actual, oracle, rtol=0, atol=0)
+            assert pointers == [t.data_ptr() for t in observed] + [dots.data_ptr()]
+        assert resources  # owns the captured mHC workspace for graph's lifetime
+    finally:
+        if owned_workspace:
+            reset_workspace_manager()
