+@pytest.fixture(scope="module")
+def variants():
+    return load("input_variant_cpu", "vllm/v1/worker/gpu/model_input_variant.py")
+
+
+class Mode(Enum):
+    NONE = 0
+    PIECEWISE = 1
+    FULL = 2
+
+
+@dataclass(frozen=True)
+class Descriptor:
+    cg_mode: Mode
+    num_tokens: int
+    model_input_variant: int = 0
+
+
+def test_capture_replay_keys_and_memory_samples_include_both_routes(variants):
+    original = [Descriptor(Mode.FULL, n) for n in (96, 64, 32, 16, 8, 1)]
+    expanded = variants.expand_capture_variants(original, (0, 1))
+    assert len(set(expanded)) == 2 * len(original)
+    captured = {desc: object() for desc in expanded}
+    for desc in original:
+        stock = variants.select_input_variant(desc, 0)
+        active = variants.select_input_variant(desc, 1)
+        assert captured[stock] is not captured[active]
+    samples = variants.sample_capture_variants(expanded, 3)
+    assert [(d.num_tokens, d.model_input_variant) for d in samples] == [
+        (96, 0),
+        (64, 0),
+        (1, 0),
+        (96, 1),
+        (64, 1),
+        (1, 1),
+    ]
+    assert (
+        variants.select_input_variant(Descriptor(Mode.PIECEWISE, 16), 1).cg_mode
+        == Mode.NONE
+    )
+    assert (
+        variants.select_input_variant(Descriptor(Mode.PIECEWISE, 16), 0).cg_mode
+        == Mode.PIECEWISE
+    )
+    for invalid in ((), (1,), (0, 1, 1)):
+        with pytest.raises(ValueError):
+            variants.expand_capture_variants(original, invalid)
+
