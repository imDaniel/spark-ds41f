+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import pytest
+
+from tests.models import steering_test_support  # noqa: F401
+
+# The helper installs this isolated package before its contracts are imported.
+# isort: off
+from ds41_steering_test.rows import expand_rows, gather_ced_rows, local_sp_rows
+# isort: on
+
+def test_decode_first_ragged_padding_and_ced():
+    # Slots follow runner state, not scheduler dictionary order. Offsets are the
+    # actual post-verification lengths, including a zero-length request.
+    rows = expand_rows(
+        [0.25, 1, 0.75, 0.5],
+        [3, 0, 2, 1],
+        [0, 3, 3, 5, 8],
+        10,
+        [False] * 7 + [True, True, True],
+    )
+    assert rows == [0.5, 0.5, 0.5, 0.75, 0.75, 1, 1, 0, 0, 0]
+    assert gather_ced_rows(rows, [0, 4, 6, -1]) == [0.5, 0.75, 1, 0]
+
+
+@pytest.mark.parametrize("n", [0, 1, 2, 3, 205, 8191, 8192])
+@pytest.mark.parametrize("world", [1, 3, 4])
+def test_sp_scales_cover_each_real_row_once(n, world):
+    rows = [(i % 5) / 4 for i in range(n)]
+    joined = sum((local_sp_rows(rows, world, r) for r in range(world)), [])
+    assert joined[:n] == rows
+    assert not any(joined[n:])
+
+
+def test_invalid_row_layouts():
+    for offsets in [[1, 2], [0, -1], [0, 5], [0, 1, 2]]:
+        with pytest.raises(ValueError):
+            expand_rows([1], [0], offsets, 2, [False] * 2)
+    with pytest.raises(ValueError):
+        gather_ced_rows([1], [-2])
+    with pytest.raises(ValueError):
+        gather_ced_rows([1], [1])
