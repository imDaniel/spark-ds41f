+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tests.models.steering_test_support import valid_profile
+
+# The helper installs this isolated package before its contracts are imported.
+# isort: off
+from ds41_steering_test.runtime import SteeringRuntime
+# isort: on
+
+def test_fixed_buffers_cancel_reuse_and_many_scales(tmp_path):
+    p = valid_profile(tmp_path)
+    state = SteeringRuntime(p, 4, 16, "cpu")
+    pointers = (
+        state.row_scales.data_ptr(),
+        state.request_scales.data_ptr(),
+        state.scratch.data_ptr(),
+    )
+    for i in range(101):
+        state.add_request(
+            2, "request", {"steering_profile": p.profile_id, "steering_scale": i / 100}
+        )
+        batch = SimpleNamespace(
+            num_tokens_after_padding=5,
+            num_reqs=1,
+            req_ids=["request"],
+            idx_mapping_np=np.array([2]),
+            query_start_loc=torch.tensor([0, 3]),
+            is_padding=torch.tensor([False, False, True, True, True]),
+        )
+        rows = state.prepare(batch)
+        assert rows[:2].tolist() == [state.requests["request"][1].scale] * 2
+        assert rows[2:].tolist() == [0, 0, 0]
+        state.remove_request("request")
+        assert state.request_scales[2] == 0
+        assert pointers == (
+            state.row_scales.data_ptr(),
+            state.request_scales.data_ptr(),
+            state.scratch.data_ptr(),
+        )
+    assert not state.requests and not state.slots
+
+
+def test_stream_update_same_identity_and_reject_change(tmp_path):
+    p = valid_profile(tmp_path)
+    state = SteeringRuntime(p, 4, 16, "cpu")
+    args = {"steering_profile": p.profile_id, "steering_scale": 0.5}
+    state.add_request(1, "r", args)
+    state.prepare_streaming_update("r")
+    state.remove_request("r")
+    state.add_request(3, "r", args)
+    with pytest.raises(ValueError):
+        state.add_request(3, "duplicate", args)
+    state.prepare_streaming_update("r")
+    state.remove_request("r")
+    with pytest.raises(ValueError):
+        state.add_request(1, "r", {**args, "steering_scale": 1})
+    assert not state.dummy(8).any()
+    with pytest.raises(ValueError):
+        state.dummy(17)
