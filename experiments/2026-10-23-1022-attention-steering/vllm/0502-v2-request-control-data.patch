@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Expand scales using the runner's actual GPU offsets after adaptive verification."""
+
+import torch
+
+from vllm.model_executor.warmup.jit_warmup_triton_helper import (
+    TritonWarmupTensor,
+    triton_kernel_dispatcher_with_warmup,
+    triton_warmup_inputs,
+)
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit(do_not_specialize=["num_reqs", "num_rows"])
+def _row_scales_kernel(
+    request_scales,
+    slots,
+    offsets,
+    padding,
+    out,
+    num_reqs,
+    num_rows,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    valid = row < num_rows
+    lo = tl.full((BLOCK,), 0, tl.int32)
+    hi = tl.full((BLOCK,), num_reqs, tl.int32)
+    while tl.sum((lo < hi).to(tl.int32), 0) > 0:
+        mid = (lo + hi) // 2
+        boundary = tl.load(
+            offsets + mid + 1, mask=(mid < num_reqs) & valid, other=0x7FFFFFFF
+        )
+        right = row >= boundary
+        searching = lo < hi
+        lo = tl.where(searching & right, mid + 1, lo)
+        hi = tl.where(searching & ~right, mid, hi)
+    end = tl.load(offsets + num_reqs)
+    live = valid & (row < end) & (lo < num_reqs)
+    dead = tl.load(padding + row, mask=valid, other=1)
+    slot = tl.load(slots + lo, mask=live & ~dead, other=0)
+    scale = tl.load(request_scales + slot, mask=live & ~dead, other=0.0)
+    tl.store(out + row, scale, mask=valid)
+
+
+def _warmup_inputs():
+    return triton_warmup_inputs(
+        _row_scales_kernel,
+        TritonWarmupTensor(torch.float32),
+        TritonWarmupTensor(torch.int64),
+        TritonWarmupTensor(torch.int32),
+        TritonWarmupTensor(torch.bool),
+        TritonWarmupTensor(torch.float32),
+        1,
+        128,
+        grid=(1,),
+        BLOCK=128,
+        num_warps=4,
+    )
+
+
+_launcher = triton_kernel_dispatcher_with_warmup(warmup_inputs=_warmup_inputs)(
+    _row_scales_kernel
+)
+
+
+def register_row_warmup():
+    _launcher.register_warmup()
+
+
+def fill_row_scales(request_scales, slots, offsets, padding, out, num_reqs, num_rows):
+    if num_rows:
+        _launcher[(triton.cdiv(num_rows, 128),)](
+            request_scales,
+            slots,
+            offsets,
+            padding,
+            out,
+            num_reqs,
+            num_rows,
+            BLOCK=128,
+            num_warps=4,
+        )
diff --git a/vllm/models/deepseek_v4_1/steering/rows.py b/vllm/models/deepseek_v4_1/steering/rows.py
new file mode 100644
index 000000000..2b8e613cc
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/steering/rows.py
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Row-layout reference, including CED gather and sequence-parallel padding."""
+
+
+def expand_rows(request_scales, idx_mapping, query_start_loc, num_rows, is_padding):
+    if len(query_start_loc) != len(idx_mapping) + 1 or query_start_loc[0] != 0:
+        raise ValueError("Invalid steering query offsets")
+    if any(a > b or a < 0 for a, b in zip(query_start_loc, query_start_loc[1:])):
+        raise ValueError("Steering query offsets must be monotone")
+    if query_start_loc[-1] > num_rows or len(is_padding) != num_rows:
+        raise ValueError("Steering query offsets exceed the batch")
+    result = [0.0] * num_rows
+    for batch_idx, slot in enumerate(idx_mapping):
+        if not 0 <= slot < len(request_scales):
+            raise ValueError("Invalid steering request slot")
+        for row in range(query_start_loc[batch_idx], query_start_loc[batch_idx + 1]):
+            if not is_padding[row]:
+                result[row] = request_scales[slot]
+    return result
+
+
+def gather_ced_rows(scales, indices):
+    if any(index < -1 or index >= len(scales) for index in indices):
+        raise ValueError("Invalid CED steering index")
+    return [0.0 if index == -1 else scales[index] for index in indices]
+
+
+def local_sp_rows(scales, world_size, rank):
+    if world_size < 1 or not 0 <= rank < world_size:
+        raise ValueError("Invalid steering SP layout")
+    local = -(-len(scales) // world_size)
+    start = rank * local
+    real = scales[start : start + local]
+    return [*real, *([0.0] * (local - len(real)))]
diff --git a/vllm/models/deepseek_v4_1/steering/runtime.py b/vllm/models/deepseek_v4_1/steering/runtime.py
new file mode 100644
index 000000000..52b80debb
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/steering/runtime.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Worker-local lifecycle and fixed-capacity control tensors."""
+
+import torch
+
+from .request import parse_selection
+from .rows import expand_rows
+
+
+class SteeringRuntime:
+    def __init__(self, profile, max_reqs, max_tokens, device):
+        self.profile = profile
+        self.device = torch.device(device)
+        self.request_scales = torch.zeros(max_reqs, dtype=torch.float32, device=device)
+        self.row_scales = torch.zeros(max_tokens, dtype=torch.float32, device=device)
+        self.scratch = torch.empty(
+            (max_tokens, profile.hidden_size), dtype=torch.bfloat16, device=device
+        )
+        self.requests = {}
+        self.slots = {}
+        self.pending_update = None
+        if self.device.type == "cuda":
+            from .row_kernel import register_row_warmup
+
+            register_row_warmup()
+
+    def prepare_streaming_update(self, req_id):
+        self.pending_update = (req_id, self.requests[req_id][1])
+
+    def add_request(self, slot, req_id, extra_args):
+        selection = parse_selection(extra_args, self.profile)
+        if self.pending_update is not None:
+            old_id, old = self.pending_update
+            self.pending_update = None
+            if old_id != req_id or old != selection:
+                raise ValueError("A live request cannot change its steering identity")
+        if (
+            not 0 <= slot < self.request_scales.numel()
+            or slot in self.slots
+            or req_id in self.requests
+        ):
+            raise ValueError("Steering request/slot is already owned or out of range")
+        self.requests[req_id] = (slot, selection)
+        self.slots[slot] = req_id
+        # Lifecycle-only update, queued on the runner's current stream. There is
+        # no per-step CPU->GPU copy, pinned-host reuse race, or scale bank growth.
+        self.request_scales[slot].fill_(selection.scale)
+
+    def remove_request(self, req_id):
+        old = self.requests.pop(req_id, None)
+        if old is not None:
+            slot, _ = old
+            self.slots.pop(slot)
+            self.request_scales[slot].zero_()
+
+    def prepare(self, batch):
+        n = batch.num_tokens_after_padding
+        if n > self.row_scales.numel() or batch.num_reqs > self.request_scales.numel():
+            raise ValueError("Steering batch exceeds preallocated controls")
+        if any(req not in self.requests for req in batch.req_ids):
+            raise ValueError("Steering batch contains an unregistered request")
+        for req, slot in zip(batch.req_ids, batch.idx_mapping_np):
+            if self.requests[req][0] != int(slot):
+                raise ValueError(
+                    "Steering request layout and runner slot mapping differ"
+                )
+        if self.device.type == "cuda":
+            from .row_kernel import fill_row_scales
+
+            fill_row_scales(
+                self.request_scales,
+                batch.idx_mapping,
+                batch.query_start_loc,
+                batch.is_padding,
+                self.row_scales,
+                batch.num_reqs,
+                n,
+            )
+        else:
+            values = expand_rows(
+                self.request_scales.tolist(),
+                batch.idx_mapping_np.tolist(),
+                batch.query_start_loc.tolist(),
+                n,
+                batch.is_padding.tolist(),
+            )
+            self.row_scales[:n].copy_(torch.tensor(values, dtype=torch.float32))
+        return self.row_scales[:n]
+
+    def dummy(self, num_tokens):
+        if not 0 <= num_tokens <= self.row_scales.numel():
+            raise ValueError("Steering dummy batch exceeds controls")
+        self.row_scales.zero_()
+        return self.row_scales[:num_tokens]
